{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "praetorctl hook gemini pre-tool",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "python3 -I \"$GEMINI_PROJECT_DIR/scripts/raw_configure_guard.py\" --client gemini",
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "asdecided": {
      "args": [
        "decisions",
        "serve"
      ],
      "command": "praetorctl"
    }
  }
}
