# Generated by Praetor from declared project commands; execution is unverified.
# Praetor ships one binary under two names; resolve whichever is installed.
-include .config/praetor/engine.mk
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test lint apply dist

all: build

verify-all: compile-context-verify caveman-sources audit test

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

# The repository builds nothing: "build" lints the series and its metadata.
build:
	@python3 scripts/series.py check

test: build lint
	@python3 -m unittest discover -s tests

lint:
	@ruff check scripts tests
	@ruff format --check scripts tests
	@reuse lint --quiet

# Apply the series onto a clean FFmpeg checkout at the pinned base:
#   make apply FFMPEG_TREE=/path/to/ffmpeg
apply:
	@test -n "$(FFMPEG_TREE)" || { echo 'set FFMPEG_TREE to an FFmpeg checkout' >&2; exit 1; }
	@python3 scripts/series.py apply --expect-base "$(FFMPEG_TREE)"

# Release tarball of the committed series, the same bytes for the same commit:
#   make dist VERSION=v1.0.0
DIST_FILES = base.env series.txt patches scripts/series.py LICENSE LICENSES README.md REUSE.toml
dist:
	@test -n "$(VERSION)" || { echo 'set VERSION to the release tag, e.g. VERSION=v1.0.0' >&2; exit 1; }
	@mkdir -p dist
	@git archive --format=tar --prefix=ffmpeg-patches-$(VERSION)/ HEAD $(DIST_FILES) \
		| gzip -n -9 > dist/ffmpeg-patches-$(VERSION).tar.gz
	@echo dist/ffmpeg-patches-$(VERSION).tar.gz
