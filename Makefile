# Generated by Praetor from declared project commands; execution is unverified.
# Praetor ships one binary under two names; resolve whichever is installed.
-include .config/praetor/engine.mk
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
.PHONY: all dev-deps verify-all compile-context compile-context-verify caveman-sources audit docstrings semgrep build test lint lint-mutable-defaults apply filter-deps lengths lengths-local upstream-lint dist doctor
.PHONY: fairy-requests test-budgeted

DOCSTRING_BASE ?= origin/main
SEMGREP ?= semgrep

all: build

# Optional check of the installed helper executable.
doctor:
	@sh .config/lefthook/python.sh -B scripts/check_helper_install.py

# Optional live check; keep network access outside verify-all.
fairy-requests:
	@bash scripts/ffmpeg-forgejo fairy-requests --skip-unavailable

# Fast check that the interpreter python.sh selects holds every
# requirements-dev.in pin and loads the tree-sitter C parser, before the long unit suite.
dev-deps:
	@sh .config/lefthook/python.sh -B scripts/check_dev_deps.py

verify-all: dev-deps compile-context-verify caveman-sources audit docstrings semgrep test lengths-local upstream-lint

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

docstrings:
	@sh .config/lefthook/python.sh -B scripts/docstring_diff.py --base "$(DOCSTRING_BASE)"

# Same script as the scanners workflow (.github/workflows/scanners.yml), so a
# rule finding or a rule configuration warning fails the local gate before CI.
semgrep:
	@if ! command -v $(SEMGREP) >/dev/null 2>&1; then \
		echo "semgrep: not installed; the scanners workflow runs semgrep 1.178.0 (.github/workflows/scanners.yml); install it, for example pipx install --python python3.14 semgrep==1.178.0" >&2; \
		exit 1; \
	fi
	@$(SEMGREP) --version
	@SEMGREP=$(SEMGREP) sh scripts/semgrep_scan.sh

# The repository builds nothing: "build" lints the series and its metadata.
build:
	@sh .config/lefthook/python.sh scripts/series.py check

# Unit tests run class tasks in UNIT_JOBS worker processes; the independent forgejo
# methods use singleton tasks so its large classes cannot serialize the run.
# series.yml jobs.check.timeout-minutes supplies the limit; the wrapper applies
# UNIT_BUDGET_SHARE to job elapsed (including prerequisites) and unit wall time.
# CI supplies its first-step timestamp; local test starts the clock before prerequisites.
# The runner hook reports the slowest scheduled suites and their summed-time shares.
# Set UNIT_JOBS on the make command line to change the worker count.
UNIT_JOBS ?= 4

# The temporary leak guard fails a run that leaves files in its temporary directory.
# Unit tests ignore the host git configuration, as on CI, so a test that needs a git identity fails locally too.
test:
	@SERIES_JOB_STARTED_AT="$${SERIES_JOB_STARTED_AT-$$(date +%s)}" $(MAKE) test-budgeted

test-budgeted: dev-deps build lint
	@GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 sh .config/lefthook/python.sh scripts/unit_test_budget.py -- sh .config/lefthook/python.sh -m unittest_parallel -j $(UNIT_JOBS) --level class -s tests --runner scripts.unit_test_budget.TimedSuiteRunner

lint: lint-mutable-defaults
	@sh .config/lefthook/python.sh -m ruff check scripts tests
	@sh .config/lefthook/python.sh -m ruff format --check scripts tests

lint-mutable-defaults:
	@sh .config/lefthook/python.sh scripts/lint_mutable_defaults.py

# Apply the series onto a clean FFmpeg checkout at the pinned base:
#   make apply FFMPEG_TREE=/path/to/ffmpeg
apply:
	@test -n "$(FFMPEG_TREE)" || { echo 'set FFMPEG_TREE to an FFmpeg checkout' >&2; exit 1; }
	@sh .config/lefthook/python.sh scripts/series.py apply --expect-base "$(FFMPEG_TREE)"

# Detect filters that call a library configure does not declare.
filter-deps:
	@test -n "$(FILTER_DEPS_TREE)" || { echo 'usage: make filter-deps FILTER_DEPS_TREE=<FFmpeg tree>' >&2; exit 2; }
	@sh .config/lefthook/python.sh scripts/filter_lib_deps.py "$(FILTER_DEPS_TREE)"

# HISS-04 function-length gate on the applied series. It needs the series
# applied to an FFmpeg checkout (base..HEAD, one commit per patch), so it is
# not in the default local gate. CI runs it on every push to main and every
# release run; on a non-draft pull request only when scripts/series.py scope
# selects ffmpeg work. Draft or out-of-scope pull requests skip it. Run directly:
#   make lengths FFMPEG_TREE=/path/to/applied-ffmpeg
lengths:
	@test -n "$(FFMPEG_TREE)" || { echo 'set FFMPEG_TREE to an FFmpeg checkout with the series applied' >&2; exit 1; }
	@sh .config/lefthook/python.sh scripts/series.py lengths "$(FFMPEG_TREE)"

# verify-all hook for the applied-tree length gate: run it when FFMPEG_TREE
# names an applied checkout, otherwise skip loudly (never a silent pass).
# CI runs it on every push to main and every release run; on a non-draft pull
# request only when scripts/series.py scope selects ffmpeg work. Draft or
# out-of-scope pull requests skip it; a tree-less local run cannot catch it.
# `make verify-all FFMPEG_TREE=<applied tree>` runs the full gate.
lengths-local:
	@if [ -n "$(FFMPEG_TREE)" ]; then \
		sh .config/lefthook/python.sh scripts/series.py lengths "$(FFMPEG_TREE)"; \
	else \
		{ \
		  echo 'lengths-local: SKIPPED - no FFMPEG_TREE.'; \
		  echo '  The HISS-04 applied-tree function-length gate needs the series'; \
		  echo '  applied to an FFmpeg checkout. Before pushing a patch change run:'; \
		  echo '    make verify-all FFMPEG_TREE=<applied FFmpeg tree>'; \
		  echo '  (see "Get started" in README.md). CI runs this gate on every'; \
		  echo '  push to main and every release run; on a non-draft pull request only'; \
		  echo '  when scripts/series.py scope selects ffmpeg work. Draft or out-of-scope'; \
		  echo '  pull requests skip it; a tree-less local run cannot catch it.'; \
		} >&2; \
	fi

# Pre-POST checks using the upstream base's own policy and developer.texi rules:
# Only allow-listed patcheck categories block; other added-line hints need review.
#   make upstream-lint UPSTREAM_TREE=/path/to/ffmpeg UPSTREAM_BASE=<revision>
# UPSTREAM_REVERT_PROOF: whitespace-separated record files; whitespace in filenames unsupported.
# UPSTREAM_NO_REVERT_PROOF_REASON: nonblank waiver, forwarded without changing its bytes.
#   make upstream-lint UPSTREAM_TREE=/path/to/ffmpeg UPSTREAM_BASE=main UPSTREAM_REVERT_PROOF='one.json two.json' UPSTREAM_NO_REVERT_PROOF_REASON='manual verification'
# This optional checkout is distinct from the applied-series length checkout.
UPSTREAM_REVERT_PROOF ?=
UPSTREAM_NO_REVERT_PROOF_REASON ?=
upstream-lint: override export UPSTREAM_REVERT_PROOF := $(value UPSTREAM_REVERT_PROOF)
upstream-lint: override export UPSTREAM_NO_REVERT_PROOF_REASON := $(value UPSTREAM_NO_REVERT_PROOF_REASON)
upstream-lint:
	@if [ -n "$(UPSTREAM_TREE)" ] && [ -n "$(UPSTREAM_BASE)" ]; then \
		set -f; set -- scripts/upstream_lint.py "--tree=$(UPSTREAM_TREE)" "--base=$(UPSTREAM_BASE)"; \
		for record in $$UPSTREAM_REVERT_PROOF; do set -- "$$@" "--revert-proof=$$record"; done; \
		if [ -n "$$(printf '%s' "$$UPSTREAM_NO_REVERT_PROOF_REASON" | tr -d '[:space:]')" ]; then \
			set -- "$$@" "--no-revert-proof-reason=$$UPSTREAM_NO_REVERT_PROOF_REASON"; \
		fi; \
		sh .config/lefthook/python.sh "$$@"; \
	else \
		{ \
		  echo 'upstream-lint: SKIPPED - both UPSTREAM_TREE and UPSTREAM_BASE required.'; \
		  echo '  Before posting upstream, run:'; \
		  echo '    make upstream-lint UPSTREAM_TREE=<clean FFmpeg tree> UPSTREAM_BASE=<revision>'; \
		} >&2; \
	fi

# Release tarball of the committed series, the same bytes for the same commit:
#   make dist VERSION=v1.0.0
DIST_FILES = base.env series.txt patches scripts/series.py upstream-contributions.json \
	LICENSE LICENSES README.md REUSE.toml
dist:
	@test -n "$(VERSION)" || { echo 'set VERSION to the release tag, e.g. VERSION=v1.0.0' >&2; exit 1; }
	@mkdir -p dist
	@git archive --format=tar --prefix=ffmpeg-patches-$(VERSION)/ HEAD $(DIST_FILES) \
		| gzip -n -9 > dist/ffmpeg-patches-$(VERSION).tar.gz
	@echo dist/ffmpeg-patches-$(VERSION).tar.gz
