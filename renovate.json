{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements-dev\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Pylint version pinned by the mutable-defaults checker",
      "managerFilePatterns": [
        "/^scripts/lint_mutable_defaults\\.py$/"
      ],
      "matchStrings": [
        "PYLINT_VERSION = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "pylint",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update the Praetor engine commit pinned by the series workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/series\\.yml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*PRAETOR_REF:[ \\t]+(?<currentDigest>[0-9a-f]{40})[ \\t]*(?:\\r?\\n|$)"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "praetor",
      "packageNameTemplate": "https://github.com/cordanaLLM/praetor",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".devcontainer/devcontainer.json",
        ".devcontainer/Dockerfile.praetor"
      ],
      "enabled": false
    },
    {
      "description": "Development pins and lockfile are updated together by pip-compile",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-dev.in",
        "requirements-dev.txt"
      ],
      "enabled": false
    },
    {
      "description": "Update the Pylint development lock and script pin together",
      "matchPackageNames": [
        "pylint"
      ],
      "groupName": "pylint"
    },
    {
      "description": "The Praetor engine pin is an own commit digest without a release timestamp, so it waits for no release age",
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/cordanaLLM/praetor"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "praetor-managed engine: updates arrive in one coordinated adoption pull request",
      "matchPackageNames": [
        "github.com/cordanaLLM/praetor",
        "github.com/cordanaLLM/praetor/**",
        "github.com/cordanaLLM/praetor/cmd/standardsctl",
        "cordanaLLM/praetor",
        "cordanaLLM/praetor/**"
      ],
      "enabled": false
    }
  ]
}
