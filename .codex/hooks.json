{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "praetorctl hook codex pre-tool",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/scripts/raw_configure_guard.py\" --client codex || exit 2",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
