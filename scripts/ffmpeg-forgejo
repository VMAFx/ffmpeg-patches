#!/usr/bin/env bash
# ffmpeg-forgejo: file issues and pull requests on code.ffmpeg.org (Forgejo).
#
# The access token lives in the desktop keyring (Secret Service), stored once with
#   secret-tool store --label='code.ffmpeg.org API token' service code.ffmpeg.org
# and is never printed or placed on a command line.
#
# Usage:
#   ffmpeg-forgejo whoami
#   ffmpeg-forgejo search  <text>                    open issues and PRs matching text
#   ffmpeg-forgejo fork                              ensure <you>/FFmpeg exists
#   ffmpeg-forgejo push    [--lease <sha>] <local-branch> [<remote-branch>]   push to <you>/FFmpeg (run inside an FFmpeg clone);
#                          --lease force-pushes only while the remote branch is still <sha>
#   ffmpeg-forgejo pr      [--overlap-ok <number>]... <branch> <title> <body-file>
#                          open PR <you>:<branch> -> master; refuses overlap with an own open PR
#                          (exit 77); --overlap-ok permits exactly that PR;
#                          exits 3 when Fairy is missing or no human reviewer is requested
#   ffmpeg-forgejo issue   <title> <body-file>
#   ffmpeg-forgejo comment (--tested-head <sha> | --no-test-claims) <number> <body-file>
#                          comment on an issue or PR; test claims must match the live PR head
#   ffmpeg-forgejo edit-body [--wait] (--tested-head <sha> | --no-test-claims) <number> <body-file>
#                          replace a PR body; test claims must match the live PR head; refuses (exit 75) while the
#                          Autolabel run for the PR head has not finished, --wait polls up to 20 min.
#                          A PR edit fires an "edited" event that cancels a running Labeler and leaves
#                          a failure status on the head: edit the body before pushing, or after Autolabel.
#   ffmpeg-forgejo reviewers <number> [<login>...]    list requested reviewers, or request these
#   ffmpeg-forgejo fairy-reviews [<number>...]        count submitted Fairy reviews; default: own open PRs
#   ffmpeg-forgejo fairy-reviews --from-json <file>  offline count, newest state and 12-hex commit (tab separated)
#   ffmpeg-forgejo fairy-requests [--skip-unavailable]  fail on own PRs older than 15 min without Fairy
# Environment: FFMPEG_FORGEJO_REPO (default FFmpeg/FFmpeg), FFMPEG_FORGEJO_BASE (default master),
#   FFMPEG_FORGEJO_API (API base override, for tests), FFMPEG_FORGEJO_GIT (upstream Git URL override).
#   FFMPEG_FORGEJO_BOT_REVIEWER (default Forgejo_Fairy), FFMPEG_FORGEJO_OFFLINE=1 (skip optional check).
set -euo pipefail

HOST="https://code.ffmpeg.org"
API="${FFMPEG_FORGEJO_API:-$HOST/api/v1}"
REPO="${FFMPEG_FORGEJO_REPO:-FFmpeg/FFmpeg}"
BASE="${FFMPEG_FORGEJO_BASE:-master}"
GIT_URL="${FFMPEG_FORGEJO_GIT:-$HOST/$REPO.git}"
page_size=""
BOT_REVIEWER="${FFMPEG_FORGEJO_BOT_REVIEWER:-Forgejo_Fairy}"

die() { printf 'ffmpeg-forgejo: %s\n' "$*" >&2; exit 1; }

usage_error() { printf 'ffmpeg-forgejo: usage: %s\n' "$*" >&2; exit 64; }

token() {
  local t
  if ! t="$(secret-tool lookup service code.ffmpeg.org 2>/dev/null)"; then t=""; fi
  [ -n "$t" ] || die "no token in the keyring; store it with: secret-tool store --label='code.ffmpeg.org API token' service code.ffmpeg.org"
  printf '%s' "$t"
}

# api METHOD PATH [JSON-BODY-FILE]; the token goes through a header file, not argv.
# The subshell keeps header cleanup local even when a function calls api directly.
api() (
  local method="$1" path="$2" body="${3:-}" hdr tok
  tok="$(token)" || exit 1
  hdr="$(mktemp)"
  trap 'rm -f "$hdr"' EXIT
  chmod 600 "$hdr"
  printf 'Authorization: token %s\n' "$tok" >"$hdr"
  if [ -n "$body" ]; then
    curl -fsS --max-time 60 -X "$method" -H @"$hdr" -H 'Content-Type: application/json' \
      --data-binary @"$body" "$API$path"
  else
    curl -fsS --max-time 60 -X "$method" -H @"$hdr" "$API$path"
  fi
)

login() {
  local out
  out="$(api GET /user)" || exit 1
  python3 -c 'import json,sys; print(json.load(sys.stdin)["login"])' <<<"$out"
}

json_body() { # json_body KEY=VALUE... ; values starting with @ are read from that file
  python3 -c '
import json, sys
out = {}
for arg in sys.argv[1:]:
    k, v = arg.split("=", 1)
    out[k] = open(v[1:], encoding="utf-8").read() if v.startswith("@") else v
print(json.dumps(out))' "$@"
}

# head_sha NUMBER: prints the current head commit of that PR.
head_sha() {
  local out
  out="$(api GET "/repos/$REPO/pulls/$1")" || exit 1
  python3 -c 'import json,sys; print(json.load(sys.stdin)["head"]["sha"])' <<<"$out"
}

# pull_status NUMBER: prints the HTTP status, then the response body. --no-fail preserves the
# user's curl config while overriding curlrc fail, so a 404 remains a status instead of curl rc 22.
pull_status() {
  local number="$1" hdr response tok code curl_rc
  tok="$(token)" || exit 1
  hdr="$(mktemp)"
  response="$(mktemp)"
  trap 'rm -f "$hdr" "$response"' RETURN
  chmod 600 "$hdr" "$response"
  printf 'Authorization: token %s\n' "$tok" >"$hdr"
  if code="$(curl --no-fail -sS -o "$response" -w '%{http_code}' --max-time 60 -X GET \
    -H @"$hdr" "$API/repos/$REPO/pulls/$number")"; then
    curl_rc=0
  else
    curl_rc=$?
  fi
  printf '%s\n' "$code"
  [ "$curl_rc" -eq 0 ] || return "$curl_rc"
  cat "$response"
}

# parse_claim_option USAGE ARGS...: set claim_mode, tested_head and claim_args.
parse_claim_option() {
  local usage="$1"
  shift
  claim_mode=""; tested_head=""; claim_args=0
  while [ "${1:-}" = "--tested-head" ] || [ "${1:-}" = "--no-test-claims" ]; do
    [ -z "$claim_mode" ] || usage_error "$usage"
    if [ "$1" = "--tested-head" ]; then
      [ $# -ge 2 ] || usage_error "$usage"
      tested_head="${2,,}"
      [[ "$tested_head" =~ ^[0-9a-f]{7,40}$ ]] || usage_error "$usage"
      claim_mode="tested-head"
      claim_args=2
      shift 2
    else
      claim_mode="no-test-claims"
      claim_args=1
      shift
    fi
  done
  [ -n "$claim_mode" ] || usage_error "$usage"
}

# require_tested_head NUMBER TESTED: refuse unless TESTED prefixes the live PR head.
require_tested_head() {
  local number="$1" tested="$2" response status body live rc
  if response="$(pull_status "$number")"; then rc=0; else rc=$?; fi
  if [ "$rc" -ne 0 ]; then
    printf 'ffmpeg-forgejo: cannot read the head of #%s (curl rc %s); tested head %s not checked.\n' \
      "$number" "$rc" "$tested" >&2
    exit 1
  fi
  status="${response%%$'\n'*}"
  if [ "$status" = 404 ]; then
    printf 'ffmpeg-forgejo: #%s is not a pull request; tested head %s cannot be checked.\n' \
      "$number" "$tested" >&2
    exit 76
  fi
  if [ "$status" != 200 ]; then
    printf 'ffmpeg-forgejo: cannot read the head of #%s (HTTP %s); tested head %s not checked.\n' \
      "$number" "$status" "$tested" >&2
    exit 1
  fi
  body="${response#*$'\n'}"
  if ! live="$(python3 -c 'import json,re,sys
try:
    sha = json.load(sys.stdin)["head"]["sha"]
except (KeyError, TypeError):
    raise SystemExit(1)
if not isinstance(sha, str) or re.fullmatch(r"[0-9a-fA-F]{40}", sha) is None:
    raise SystemExit(1)
print(sha)' \
    <<<"$body" 2>/dev/null)"; then
    printf 'ffmpeg-forgejo: cannot read the head of #%s (HTTP %s); tested head %s not checked.\n' \
      "$number" "$status" "$tested" >&2
    exit 1
  fi
  live="${live,,}"
  if [[ "$live" != "$tested"* ]]; then
    printf 'ffmpeg-forgejo: tested head %s does not match live head %s.\n' \
      "$tested" "$live" >&2
    exit 76
  fi
}

# autolabel_state SHA: prints done, pending, none or unknown for the Autolabel contexts on that
# commit. The status list is paged (X-Total-Count; the body's total_count counts one page only),
# so it reads pages until an empty one; more than 20 pages, or a status outside Forgejo's
# CommitStatusState values, is unknown.
autolabel_state() {
  local out page rows=""
  for ((page = 1; page <= 20; page++)); do
    out="$(api GET "/repos/$REPO/commits/$1/status?limit=50&page=$page")" || exit 1
    out="$(python3 -c 'import json,sys
st = json.load(sys.stdin).get("statuses") or []
print(len(st))
for s in st:
    if s["context"].startswith("Autolabel"): print(s["status"])' <<<"$out")" || exit 1
    if [ "${out%%$'\n'*}" = 0 ]; then
      python3 -c 'import sys
st = sys.argv[1].split()
terminal = {"success", "error", "failure", "warning", "skipped"}
print("none" if not st else "pending" if "pending" in st else "done" if set(st) <= terminal else "unknown")' "$rows"
      return
    fi
    [[ "$out" != *$'\n'* ]] || rows+=" ${out#*$'\n'}"
  done
  echo unknown
}

# check_pull_files NUMBER CANDIDATE-FILE: refuse when one pull shares a candidate path.
check_pull_files() {
  local number="$1" candidates="$2" file_page out parsed count overlap
  for ((file_page = 1; file_page <= 20; file_page++)); do
    if ! out="$(api GET "/repos/$REPO/pulls/$number/files?limit=50&page=$file_page")"; then
      printf 'ffmpeg-forgejo: cannot check files of own open pull #%s.\n' "$number" >&2
      return 1
    fi
    if ! parsed="$(python3 -c 'import json, os, pathlib, sys
rows = json.load(sys.stdin)
if rows is None and int(sys.argv[2]) >= 2: rows = []
if not isinstance(rows, list): raise SystemExit(1)
names = []
for row in rows:
    if not isinstance(row, dict) or not isinstance(row.get("filename"), str):
        raise SystemExit(1)
    names.append(row["filename"])
    previous = row.get("previous_filename")
    if row.get("status") == "renamed" and (not isinstance(previous, str) or not previous):
        raise SystemExit(1)
    if isinstance(previous, str) and previous:
        names.append(previous)
raw = pathlib.Path(sys.argv[1]).read_bytes().split(b"\0")
candidates = {os.fsdecode(name) for name in raw if name}
print(len(rows))
print(json.dumps(sorted(candidates.intersection(names)), ensure_ascii=False))' \
      "$candidates" "$file_page" <<<"$out" 2>/dev/null)"; then
      printf 'ffmpeg-forgejo: cannot parse files of own open pull #%s.\n' "$number" >&2
      return 1
    fi
    count="${parsed%%$'\n'*}"
    overlap="${parsed#*$'\n'}"
    [ "$count" -ne 0 ] || return 0
    if [ "$file_page" -eq 20 ]; then
      printf 'ffmpeg-forgejo: own open pull #%s has more than 19 pages of files; overlap not proven absent.\n' "$number" >&2
      return 1
    fi
    if [ "$overlap" != "[]" ]; then
      printf 'ffmpeg-forgejo: own open pull #%s shares files with this branch: %s; use --overlap-ok %s only for a deliberate stack.\n' \
        "$number" "$overlap" "$number" >&2
      return 77
    fi
  done
}

# check_pr_overlap BRANCH LOGIN ALLOWED-NUMBERS: refuse overlap with own open pulls.
check_pr_overlap() {
  local branch="$1" me="$2" allowed="$3" candidates pull_page out parsed count number encoded_me rc
  local -a numbers
  if ! timeout 120 git fetch --quiet --no-tags "$GIT_URL" "refs/heads/$BASE"; then
    printf 'ffmpeg-forgejo: cannot fetch %s from %s; overlap not proven absent; no pull request opened.\n' \
      "$BASE" "$GIT_URL" >&2
    return 1
  fi
  candidates="$(mktemp)"
  if ! git diff --no-ext-diff --no-renames --name-only -z "FETCH_HEAD...$branch" -- >"$candidates"; then
    printf 'ffmpeg-forgejo: cannot determine files in %s relative to %s; no pull request opened.\n' \
      "$branch" "$BASE" >&2
    rm -f "$candidates"
    return 1
  fi
  encoded_me="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$me")"
  for ((pull_page = 1; pull_page <= 20; pull_page++)); do
    if ! out="$(api GET "/repos/$REPO/pulls?state=open&poster=$encoded_me&limit=50&page=$pull_page")"; then
      printf 'ffmpeg-forgejo: cannot list own open pull requests; no pull request opened.\n' >&2
      rm -f "$candidates"
      return 1
    fi
    if ! parsed="$(python3 -c 'import json, sys
rows = json.load(sys.stdin)
if not isinstance(rows, list): raise SystemExit(1)
numbers = []
for row in rows:
    number = row.get("number") if isinstance(row, dict) else None
    if isinstance(number, bool) or not isinstance(number, int) or number < 1:
        raise SystemExit(1)
    numbers.append(number)
print(len(numbers))
print(*numbers, sep="\n")' <<<"$out" 2>/dev/null)"; then
      printf 'ffmpeg-forgejo: cannot parse own open pull requests; no pull request opened.\n' >&2
      rm -f "$candidates"
      return 1
    fi
    count="${parsed%%$'\n'*}"
    [ "$count" -ne 0 ] || break
    if [ "$pull_page" -eq 20 ]; then
      printf 'ffmpeg-forgejo: more than 19 pages of own open pull requests; overlap not proven absent.\n' >&2
      rm -f "$candidates"
      return 1
    fi
    mapfile -t numbers <<<"${parsed#*$'\n'}"
    for number in "${numbers[@]}"; do
      if [[ " $allowed " == *" $number "* ]]; then
        continue
      fi
      if check_pull_files "$number" "$candidates"; then
        continue
      else
        rc=$?
        rm -f "$candidates"
        return "$rc"
      fi
    done
  done
  rm -f "$candidates"
}

# discover_page_size: cache API settings in the parent shell before listing subshells.
discover_page_size() {
  [ -z "$page_size" ] || return 0
  local out
  out="$(api GET /settings/api)" || die "cannot read /settings/api"
  page_size="$(python3 -c 'import json,sys
size = json.load(sys.stdin)["max_response_items"]
if isinstance(size, bool) or not isinstance(size, int) or size < 1:
    raise SystemExit(1)
print(min(50, size))' <<<"$out" 2>/dev/null)" \
    || die "invalid max_response_items in /settings/api; expected a positive integer"
}

# api_list PATH: collect a JSON list from at most 20 pages; PATH ends in ? or &.
api_list() {
  local path="$1" list_page out parsed count pages=""
  [ -n "$page_size" ] || die "api_list: page size not discovered"
  for ((list_page = 1; list_page <= 20; list_page++)); do
    out="$(api GET "${path}page=$list_page&limit=$page_size")" || die "cannot read $path"
    parsed="$(python3 -c 'import json,sys
rows = json.load(sys.stdin)
if not isinstance(rows, list): raise SystemExit(1)
print(len(rows))
print(json.dumps(rows))' <<<"$out")" || die "cannot parse $path"
    count="${parsed%%$'\n'*}"
    pages+="${parsed#*$'\n'}"$'\n'
    if [ "$count" -lt "$page_size" ]; then
      python3 -c 'import json,sys
print(json.dumps([row for page in sys.stdin if page.strip() for row in json.loads(page)]))' <<<"$pages"
      return
    fi
  done
  die "pagination limit reached for $path; listing incomplete"
}

# own_open_pr_numbers: list own open pull numbers using the overlap checks poster filter.
own_open_pr_numbers() {
  local me encoded_me out
  me="$(login)" || die "cannot read login"
  encoded_me="$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$me")"
  out="$(api_list "/repos/$REPO/pulls?state=open&poster=$encoded_me&")" || exit 1
  python3 -c 'import json,sys
for row in json.load(sys.stdin):
    number = row.get("number")
    if isinstance(number, bool) or not isinstance(number, int) or number < 1:
        raise SystemExit(1)
    print(number)' <<<"$out" || die "cannot parse own open pull numbers"
}

# fairy_review_summary: classify reviews JSON from stdin without accessing the API.
fairy_review_summary() {
  python3 -c 'import json,re,sys
from datetime import datetime

ALLOWED_STATES = {"APPROVED", "COMMENT", "REQUEST_CHANGES"}

def summarize(reviews):
    """Count submitted Fairy reviews and describe the newest submission.

    Every review row must be a dict containing a state key (str or null).
    Rows without a state key, or rows that are not dicts, are malformed.
    """
    if not isinstance(reviews, list):
        raise ValueError("reviews must be a list")
    for row in reviews:
        if not isinstance(row, dict):
            raise ValueError("review row must be a dict")
        if "state" not in row:
            raise ValueError("review row missing state key")
        state = row["state"]
        if state is not None and not isinstance(state, str):
            raise ValueError("review state must be str or null")
        user = row.get("user")
        if user is not None and not isinstance(user, dict):
            raise ValueError("review user must be dict or null")
        sub = row.get("submitted_at")
        if sub is not None and not isinstance(sub, str):
            raise ValueError("review submitted_at must be str or null")
        cid = row.get("commit_id")
        if cid is not None and not isinstance(cid, str):
            raise ValueError("review commit_id must be str or null")
        if cid and re.fullmatch(r"[0-9a-fA-F]{40}", cid) is None:
            raise ValueError("invalid review commit_id")
    submitted = [row for row in reviews
        if (row.get("user") or {}).get("login") == "Forgejo_Fairy"
        and row["state"] in ALLOWED_STATES
        and row.get("submitted_at")]
    if not submitted:
        return 0, "-", "-"
    newest = max(submitted, key=lambda row: datetime.fromisoformat(row["submitted_at"]))
    commit = newest.get("commit_id") or ""
    return len(submitted), newest["state"], commit[:12] if commit else "-"

print(*summarize(json.load(sys.stdin)), sep="\t")'
}

# request_bot_review NUMBER: merge existing users with Fairy, POST, and verify read-back.
request_bot_review() {
  local number="$1" out body revs i
  [[ "$BOT_REVIEWER" =~ ^[A-Za-z0-9._-]+$ ]] || die "not a login: $BOT_REVIEWER"
  out="$(api GET "/repos/$REPO/pulls/$number")" || return 1
  body="$(mktemp)"
  if ! python3 -c 'import json,sys
users = [user["login"] for user in json.load(sys.stdin).get("requested_reviewers") or []]
print(json.dumps({"reviewers": list(dict.fromkeys(users + [sys.argv[1]]))}))' \
    "$BOT_REVIEWER" <<<"$out" >"$body"; then
    rm -f "$body"
    return 1
  fi
  if ! api POST "/repos/$REPO/pulls/$number/requested_reviewers" "$body" >/dev/null; then
    rm -f "$body"
    return 1
  fi
  rm -f "$body"
  for ((i = 1; i <= 3; i++)); do
    out="$(api GET "/repos/$REPO/pulls/$number")" || return 1
    revs="$(python3 -c 'import json,sys
d = json.load(sys.stdin)
users = [u["login"] for u in d.get("requested_reviewers") or []]
teams = ["team:" + t["name"] for t in d.get("requested_reviewers_teams") or []]
print(" ".join(users + teams))' <<<"$out")" || return 1
    if [[ " $revs " == *" $BOT_REVIEWER "* ]]; then
      echo "#$number requested reviewers: $revs"
      return 0
    fi
    [ "$i" = 3 ] || sleep "${FFMPEG_FORGEJO_POLL:-15}"
  done
  printf 'ffmpeg-forgejo: #%s missing requested reviewer %s after POST; read back: %s\n' \
    "$number" "$BOT_REVIEWER" "${revs:-none}" >&2
  return 3
}

# fairy_request_candidates LOGIN: print own overdue PRs without the configured bot requested.
fairy_request_candidates() {
  python3 -c 'import datetime,json,sys
now = datetime.datetime.now(datetime.UTC)
for row in json.load(sys.stdin):
    if row["user"]["login"] != sys.argv[1] or row["state"] != "open":
        continue
    number = row["number"]
    if isinstance(number, bool) or not isinstance(number, int) or number < 1:
        raise ValueError("invalid pull number")
    created = datetime.datetime.fromisoformat(row["created_at"])
    age = (now - created).total_seconds() / 60
    users = [user["login"] for user in row.get("requested_reviewers") or []]
    if age > 15 and sys.argv[2] not in users:
        title = " ".join(row["title"].split())
        print(f"{number}\t{int(age)}\t{title}")' "$1" "$BOT_REVIEWER"
}

# fairy_requests [--skip-unavailable]: audit own open PRs using bounded API lists.
fairy_requests() {
  local optional="${1:-}" out me encoded_me rows row number reviews seen rc
  local -a candidates results=()
  [ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$optional" = --skip-unavailable ]; } \
    || usage_error "fairy-requests [--skip-unavailable]"
  if [ "$optional" = --skip-unavailable ]; then
    if [ "${FFMPEG_FORGEJO_OFFLINE:-0}" = 1 ]; then
      echo 'fairy-requests: SKIPPED - offline (FFMPEG_FORGEJO_OFFLINE=1).' >&2
      return 0
    fi
    if ! token >/dev/null 2>&1; then
      echo 'fairy-requests: SKIPPED - no token available in keyring.' >&2
      return 0
    fi
  fi
  if out="$(api GET /user)"; then rc=0; else rc=$?; fi
  if [ "$optional" = --skip-unavailable ] && [[ "$rc" =~ ^(6|7|28)$ ]]; then
    echo "fairy-requests: SKIPPED - API offline (curl rc $rc)." >&2
    return 0
  fi
  [ "$rc" -eq 0 ] || return "$rc"
  me="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["login"])' <<<"$out")" || return 1
  encoded_me="$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$me")"
  discover_page_size
  out="$(api_list "/repos/$REPO/pulls?state=open&poster=$encoded_me&")" || return 1
  rows="$(fairy_request_candidates "$me" <<<"$out")" || return 1
  [ -n "$rows" ] || return 0
  mapfile -t candidates <<<"$rows"
  for row in "${candidates[@]}"; do
    number="${row%%$'\t'*}"
    reviews="$(api_list "/repos/$REPO/pulls/$number/reviews?")" || return 1
    seen="$(python3 -c 'import json,sys
print(int(any(row["user"]["login"] == sys.argv[1] for row in json.load(sys.stdin))))' \
      "$BOT_REVIEWER" <<<"$reviews")" || return 1
    [ "$seen" = 1 ] || results+=("$row")
  done
  [ "${#results[@]}" -gt 0 ] || return 0
  printf '%s\n' "${results[@]}"
  return 1
}

cmd="${1:-}"
if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
  whoami)
    login
    ;;
  fairy-requests)
    fairy_requests "$@"
    ;;
  fairy-reviews)
    if [ "${1:-}" = "--from-json" ]; then
      [ $# -eq 2 ] || usage_error "fairy-reviews --from-json <file>"
      fairy_review_summary <"$2" || die "cannot parse reviews JSON"
      exit 0
    fi
    for n in "$@"; do
      [[ "$n" =~ ^[1-9][0-9]*$ ]] || usage_error "fairy-reviews [<number>...]"
    done
    discover_page_size
    numbers=("$@")
    if [ $# -eq 0 ]; then
      out="$(own_open_pr_numbers)" || exit 1
      if [ -n "$out" ]; then mapfile -t numbers <<<"$out"; fi
    fi
    results=()
    for n in "${numbers[@]}"; do
      out="$(api_list "/repos/$REPO/pulls/$n/reviews?")" || exit 1
      summary="$(fairy_review_summary <<<"$out")" || die "cannot parse reviews for #$n"
      results+=("$n"$'\t'"$summary")
    done
    if [ "${#results[@]}" -gt 0 ]; then
      printf '%s\n' "${results[@]}"
    fi
    ;;
  search)
    [ $# -ge 1 ] || die "usage: search <text>"
    q="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$*")"
    out="$(api GET "/repos/$REPO/issues?state=open&q=$q&limit=20")" || exit 1
    python3 -c 'import json,sys
for i in json.load(sys.stdin):
    kind = "PR" if i.get("pull_request") else "issue"
    print("#{number} [{k}] {title}  {html_url}".format(k=kind, **i))' <<<"$out"
    ;;
  fork)
    me="$(login)"
    if api GET "/repos/$me/${REPO#*/}" >/dev/null 2>&1; then
      echo "$HOST/$me/${REPO#*/} exists"
    else
      body="$(mktemp)"; echo '{}' >"$body"
      api POST "/repos/$REPO/forks" "$body" >/dev/null
      rm -f "$body"
      echo "forked $REPO to $HOST/$me/${REPO#*/}"
    fi
    ;;
  push)
    lease=""
    if [ "${1:-}" = "--lease" ]; then
      [ $# -ge 3 ] || die "usage: push --lease <expected-remote-sha> <local-branch> [<remote-branch>]"
      [[ "$2" =~ ^[0-9a-f]{40}$ ]] || die "--lease takes the full 40-hex sha the remote branch has now: $2"
      lease="$2"; shift 2
    fi
    [ $# -ge 1 ] || die "usage: push [--lease <expected-remote-sha>] <local-branch> [<remote-branch>]"
    me="$(login)"
    git rev-parse --verify --quiet "$1^{commit}" >/dev/null || die "no local branch $1"
    rb="${2:-$1}"
    # The credential helper reads the keyring at push time; nothing lands in argv or config.
    # --lease rewrites the remote branch only while it still points at the expected sha.
    git -c credential.helper= \
        -c "credential.$HOST.helper=!f() { echo username=$me; printf 'password='; secret-tool lookup service code.ffmpeg.org; echo; }; f" \
        push ${lease:+"--force-with-lease=refs/heads/$rb:$lease"} "$HOST/$me/${REPO#*/}.git" "$1:refs/heads/$rb"
    ;;
  pr)
    usage='pr [--overlap-ok <number>]... <branch> <title> <body-file>'
    overlap_ok=""
    pr_argc=$#
    for ((pr_i = 0; pr_i < pr_argc; pr_i++)); do
      [ "${1:-}" = "--overlap-ok" ] || break
      [ $# -ge 2 ] || usage_error "$usage"
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage_error "$usage"
      overlap_ok+=" $2"
      shift 2
    done
    [ $# -eq 3 ] || usage_error "$usage"
    [ -f "$3" ] || die "no body file $3"
    [[ "$BOT_REVIEWER" =~ ^[A-Za-z0-9._-]+$ ]] || die "not a login: $BOT_REVIEWER"
    me="$(login)"
    check_pr_overlap "$1" "$me" "$overlap_ok"
    body="$(mktemp)"
    json_body "head=$me:$1" "base=$BASE" "title=$2" "body=@$3" >"$body"
    out="$(api POST "/repos/$REPO/pulls" "$body")" || exit 1
    rm -f "$body"
    python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])' <<<"$out"
    n="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["number"])' <<<"$out")"
    request_bot_review "$n"
    # CODEOWNERS may cover no touched paths; Fairy alone does not request human review.
    for ((i = 1; i <= 3; i++)); do
      revs="$(api GET "/repos/$REPO/pulls/$n" | python3 -c 'import json,sys
d = json.load(sys.stdin)
users = [u["login"] for u in d.get("requested_reviewers") or [] if u["login"] != sys.argv[1]]
teams = ["team:" + t["name"] for t in d.get("requested_reviewers_teams") or []]
print(" ".join(users + teams))' "$BOT_REVIEWER")"
      [ -z "$revs" ] || break
      [ "$i" = 3 ] || sleep "${FFMPEG_FORGEJO_POLL:-15}"
    done
    if [ -z "$revs" ]; then
      printf 'ffmpeg-forgejo: #%s has no requested human reviewer; pick from MAINTAINERS and git log on the touched files, then: ffmpeg-forgejo reviewers %s <login>...\n' "$n" "$n" >&2
      exit 3
    fi
    ;;
  issue)
    [ $# -eq 2 ] || die "usage: issue <title> <body-file>"
    [ -f "$2" ] || die "no body file $2"
    body="$(mktemp)"
    json_body "title=$1" "body=@$2" >"$body"
    api POST "/repos/$REPO/issues" "$body" | python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
    rm -f "$body"
    ;;
  comment)
    usage='comment (--tested-head <sha> | --no-test-claims) <number> <body-file>'
    parse_claim_option "$usage" "$@"
    shift "$claim_args"
    [ $# -eq 2 ] || usage_error "$usage"
    [[ "$1" =~ ^[0-9]+$ ]] || die "not an issue number: $1"
    [ -f "$2" ] || die "no body file $2"
    [ "$claim_mode" != "tested-head" ] || require_tested_head "$1" "$tested_head"
    body="$(mktemp)"
    json_body "body=@$2" >"$body"
    api POST "/repos/$REPO/issues/$1/comments" "$body" | python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
    rm -f "$body"
    ;;
  edit-body)
    wait=0
    if [ "${1:-}" = "--wait" ]; then wait=1; shift; fi
    usage='edit-body [--wait] (--tested-head <sha> | --no-test-claims) <number> <body-file>'
    parse_claim_option "$usage" "$@"
    shift "$claim_args"
    [ $# -eq 2 ] || usage_error "$usage"
    [[ "$1" =~ ^[0-9]+$ ]] || die "not a PR number: $1"
    [ -f "$2" ] || die "no body file $2"
    [ "$claim_mode" != "tested-head" ] || require_tested_head "$1" "$tested_head"
    # The head is read again after the status check: a push in between starts a new Autolabel
    # run, and the finished statuses of the old head must not clear the edit. Forgejo's PR edit
    # takes no expected head, so a push landing between this last read and the PATCH still races.
    for ((i = 1; i <= 80; i++)); do
      sha="$(head_sha "$1")"
      state="$(autolabel_state "$sha")"
      if [ "$state" = "done" ]; then
        [ "$(head_sha "$1")" = "$sha" ] && break
        state="superseded by a new push"
      fi
      if [ "$wait" = 0 ] || [ "$i" = 80 ]; then
        printf 'ffmpeg-forgejo: Autolabel for head %s is %s; a body edit now cancels it. Retry after it finishes, or use --wait.\n' "$sha" "$state" >&2
        exit 75
      fi
      sleep "${FFMPEG_FORGEJO_POLL:-15}"
    done
    [ "$claim_mode" != "tested-head" ] || require_tested_head "$1" "$tested_head"
    body="$(mktemp)"
    json_body "body=@$2" >"$body"
    api PATCH "/repos/$REPO/pulls/$1" "$body" | python3 -c 'import json,sys; print(json.load(sys.stdin)["html_url"])'
    rm -f "$body"
    ;;
  reviewers)
    [ $# -ge 1 ] || die "usage: reviewers <number> [<login>...]"
    [[ "$1" =~ ^[0-9]+$ ]] || die "not a PR number: $1"
    n="$1"; shift
    if [ $# -gt 0 ]; then
      for u in "$@"; do [[ "$u" =~ ^[A-Za-z0-9._-]+$ ]] || die "not a login: $u"; done
      body="$(mktemp)"
      python3 -c 'import json,sys; print(json.dumps({"reviewers": sys.argv[1:]}))' "$@" >"$body"
      api POST "/repos/$REPO/pulls/$n/requested_reviewers" "$body" >/dev/null
      rm -f "$body"
    fi
    api GET "/repos/$REPO/pulls/$n" | python3 -c 'import json,sys
d = json.load(sys.stdin)
print("#{} requested reviewers: {}".format(d["number"], ", ".join(u["login"] for u in d.get("requested_reviewers") or []) or "none"))'
    ;;
  *)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    [ -z "$cmd" ] || exit 64
    ;;
esac
