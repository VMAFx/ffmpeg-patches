+static av_cold int hqdn3d_videotoolbox_init(AVFilterContext *ctx)
+{
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        static_assert(HQDN3D_VT_CTX_SIZE == sizeof(HQDN3DVTContext),
+                      "Incorrect HQDN3D_VT_CTX_SIZE value!");
+        return do_init(ctx);
+    } else {
+        av_log(ctx, AV_LOG_ERROR, "Metal is not available on this OS version\n");
+        return AVERROR(ENOSYS);
+    }
+}
