+static int check_format_and_size(AVFilterContext *ctx, AVFrame *in) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    HQDN3DVTContext *s = ctx->priv;
+    AVHWFramesContext *hwfc = (AVHWFramesContext *)in->hw_frames_ctx->data;
+    int err;
+
+    err = validate_format(ctx, hwfc->sw_format, &s->depth, &s->is_msb, &s->is_semiplanar);
+    if (err < 0)
+        return err;
+
+    if (in->width != s->width || in->height != s->height || hwfc->sw_format != s->sw_format) {
+        s->hsub = av_pix_fmt_desc_get(hwfc->sw_format)->log2_chroma_w;
+        s->vsub = av_pix_fmt_desc_get(hwfc->sw_format)->log2_chroma_h;
+        if (s->width != 0) {
+            free_buffers(s);
+            err = init_buffers(ctx, in->width, in->height);
+            if (err < 0)
+                return err;
+            err = calc_coefs(ctx);
+            if (err < 0)
+                return err;
+            err = create_out_frames_ctx(ctx, in);
+            if (err < 0)
+                return err;
+            s->first_frame = 1;
+        }
+        s->sw_format = hwfc->sw_format;
+        s->width = in->width;
+        s->height = in->height;
+    }
+    return 0;
+}
+
+static int init_filter(AVFilterContext *ctx, AVFrame *in) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    HQDN3DVTContext *s = ctx->priv;
+    int err;
+
+    err = init_buffers(ctx, in->width, in->height);
+    if (err < 0)
+        return err;
+
+    err = calc_coefs(ctx);
+    if (err < 0) {
+        free_buffers(s);
+        return err;
+    }
+
+    s->first_frame = 1;
+    return 0;
+}
+
+static void release_all_textures(HQDN3DTextures *tex)
+{
+    if (tex->in_y) {
+        CFRelease(tex->in_y);
+        tex->in_y = NULL;
+    }
+    if (tex->out_y) {
+        CFRelease(tex->out_y);
+        tex->out_y = NULL;
+    }
+    if (tex->in_c1) {
+        CFRelease(tex->in_c1);
+        tex->in_c1 = NULL;
+    }
+    if (tex->out_c1) {
+        CFRelease(tex->out_c1);
+        tex->out_c1 = NULL;
+    }
+    if (tex->in_c2) {
+        CFRelease(tex->in_c2);
+        tex->in_c2 = NULL;
+    }
+    if (tex->out_c2) {
+        CFRelease(tex->out_c2);
+        tex->out_c2 = NULL;
+    }
+}
+
+static int acquire_textures(AVFilterContext *ctx, HQDN3DVTContext *s,
+                            AVFrame *in, AVFrame *out,
+                            HQDN3DTextures *tex) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    MTLPixelFormat fmt_y = (s->depth <= 8) ? MTLPixelFormatR8Unorm : MTLPixelFormatR16Unorm;
+    MTLPixelFormat fmt_c;
+    memset(tex, 0, sizeof(*tex));
+
+    tex->in_y = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)in->data[3], 0, fmt_y);
+    tex->out_y = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)out->data[3], 0, fmt_y);
+    if (!tex->in_y || !tex->out_y) {
+        release_all_textures(tex);
+        return AVERROR_EXTERNAL;
+    }
+
+    if (s->is_semiplanar) {
+        fmt_c = (s->depth <= 8) ? MTLPixelFormatRG8Unorm : MTLPixelFormatRG16Unorm;
+        tex->in_c1 = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)in->data[3], 1, fmt_c);
+        tex->out_c1 = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)out->data[3], 1, fmt_c);
+        if (!tex->in_c1 || !tex->out_c1) {
+            release_all_textures(tex);
+            return AVERROR_EXTERNAL;
+        }
+    } else {
+        fmt_c = fmt_y;
+        tex->in_c1 = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)in->data[3], 1, fmt_c);
+        tex->out_c1 = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)out->data[3], 1, fmt_c);
+        tex->in_c2 = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)in->data[3], 2, fmt_c);
+        tex->out_c2 = ff_metal_texture_from_pixbuf(ctx, s->textureCache, (CVPixelBufferRef)out->data[3], 2, fmt_c);
+        if (!tex->in_c1 || !tex->out_c1 || !tex->in_c2 || !tex->out_c2) {
+            release_all_textures(tex);
+            return AVERROR_EXTERNAL;
+        }
+    }
+
+    tex->mtl_in_y = CVMetalTextureGetTexture(tex->in_y);
+    tex->mtl_out_y = CVMetalTextureGetTexture(tex->out_y);
+    tex->mtl_in_c1 = CVMetalTextureGetTexture(tex->in_c1);
+    tex->mtl_out_c1 = CVMetalTextureGetTexture(tex->out_c1);
+    if (!s->is_semiplanar) {
+        tex->mtl_in_c2 = CVMetalTextureGetTexture(tex->in_c2);
+        tex->mtl_out_c2 = CVMetalTextureGetTexture(tex->out_c2);
+    }
+    return 0;
+}
+
+static void encode_horizontal_luma(HQDN3DVTContext *s,
+                                   id<MTLComputeCommandEncoder> encoder,
+                                   id<MTLTexture> in_tex,
+                                   int lut_bits) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    struct mtlHqdn3dParams *p = (struct mtlHqdn3dParams *)s->mtlParamsHorizLuma.contents;
+    *p = (struct mtlHqdn3dParams){
+        .h_offset = 0,
+        .spatial_offset = 0,
+        .width = s->width,
+        .height = s->height,
+        .depth = s->depth,
+        .lut_bits = lut_bits,
+        .is_msb = s->is_msb,
+    };
+    [encoder setTexture:in_tex atIndex:0];
+    [encoder setBuffer:s->mtlHBuffer offset:0 atIndex:0];
+    [encoder setBuffer:s->mtlTablesBuffer offset:0 atIndex:1];
+    [encoder setBuffer:s->mtlParamsHorizLuma offset:0 atIndex:2];
+    ff_metal_compute_encoder_dispatch(s->mtlDevice, s->mtlPipelineHorizPlanar, encoder, s->height, 1);
+}
+
+static void encode_horizontal_chroma_semi(HQDN3DVTContext *s,
+                                          id<MTLComputeCommandEncoder> encoder,
+                                          id<MTLTexture> in_c1,
+                                          int cw, int ch, int off_u, int off_v,
+                                          int lut_bits, int spatial_offset) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    struct mtlHqdn3dParams *p = (struct mtlHqdn3dParams *)s->mtlParamsHorizChroma.contents;
+    *p = (struct mtlHqdn3dParams){
+        .h_offset = off_u,
+        .h_offset_v = off_v,
+        .spatial_offset = spatial_offset,
+        .width = cw,
+        .height = ch,
+        .depth = s->depth,
+        .lut_bits = lut_bits,
+        .is_msb = s->is_msb,
+    };
+    [encoder setTexture:in_c1 atIndex:0];
+    [encoder setBuffer:s->mtlHBuffer offset:0 atIndex:0];
+    [encoder setBuffer:s->mtlTablesBuffer offset:0 atIndex:1];
+    [encoder setBuffer:s->mtlParamsHorizChroma offset:0 atIndex:2];
+    ff_metal_compute_encoder_dispatch(s->mtlDevice, s->mtlPipelineHorizSemiplanar, encoder, ch, 1);
+}
+
+static void encode_horizontal_chroma_planar(HQDN3DVTContext *s,
+                                            id<MTLComputeCommandEncoder> encoder,
+                                            const HQDN3DTextures *tex,
+                                            int cw, int ch, int off_u, int off_v,
+                                            int lut_bits, int spatial_offset) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    id<MTLTexture> in_planes[2] = { tex->mtl_in_c1, tex->mtl_in_c2 };
+    int offs[2] = { off_u, off_v };
+    for (int i = 0; i < 2; i++) {
+        struct mtlHqdn3dParams *p = (struct mtlHqdn3dParams *)s->mtlParamsHorizChroma.contents;
+        *p = (struct mtlHqdn3dParams){
+            .h_offset = offs[i],
+            .spatial_offset = spatial_offset,
+            .width = cw,
+            .height = ch,
+            .depth = s->depth,
+            .lut_bits = lut_bits,
+            .is_msb = s->is_msb,
+        };
+        [encoder setTexture:in_planes[i] atIndex:0];
+        [encoder setBuffer:s->mtlHBuffer offset:0 atIndex:0];
+        [encoder setBuffer:s->mtlTablesBuffer offset:0 atIndex:1];
+        [encoder setBuffer:s->mtlParamsHorizChroma offset:0 atIndex:2];
+        ff_metal_compute_encoder_dispatch(s->mtlDevice, s->mtlPipelineHorizPlanar, encoder, ch, 1);
+    }
+}
+
+static void encode_horizontal_chroma(HQDN3DVTContext *s,
+                                     id<MTLComputeCommandEncoder> encoder,
+                                     const HQDN3DTextures *tex,
+                                     int cw, int ch, int off_u, int off_v,
+                                     int lut_bits, int spatial_offset) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    if (s->is_semiplanar) {
+        encode_horizontal_chroma_semi(s, encoder, tex->mtl_in_c1, cw, ch,
+                                      off_u, off_v, lut_bits, spatial_offset);
+    } else {
+        encode_horizontal_chroma_planar(s, encoder, tex, cw, ch,
+                                        off_u, off_v, lut_bits, spatial_offset);
+    }
+}
+
+static void encode_vertical_luma(HQDN3DVTContext *s,
+                                 id<MTLComputeCommandEncoder> encoder,
+                                 id<MTLTexture> in_tex,
+                                 id<MTLTexture> out_tex,
+                                 int lut_bits, int table_entries) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    struct mtlHqdn3dParams *p = (struct mtlHqdn3dParams *)s->mtlParamsVertLuma.contents;
+    *p = (struct mtlHqdn3dParams){
+        .h_offset = 0,
+        .fa_offset = 0,
+        .spatial_offset = LUMA_SPATIAL * table_entries,
+        .temporal_offset = LUMA_TMP * table_entries,
+        .width = s->width,
+        .height = s->height,
+        .depth = s->depth,
+        .lut_bits = lut_bits,
+        .is_msb = s->is_msb,
+        .first_frame = s->first_frame,
+        .spatial_enabled = s->spatial_enabled[0],
+    };
+    [encoder setTexture:in_tex atIndex:0];
+    [encoder setTexture:out_tex atIndex:1];
+    [encoder setBuffer:s->mtlHBuffer offset:0 atIndex:0];
+    [encoder setBuffer:s->mtlFrameAntBuffer offset:0 atIndex:1];
+    [encoder setBuffer:s->mtlTablesBuffer offset:0 atIndex:2];
+    [encoder setBuffer:s->mtlParamsVertLuma offset:0 atIndex:3];
+    ff_metal_compute_encoder_dispatch(s->mtlDevice, s->mtlPipelineVertPlanar, encoder, s->width, 1);
+}
+
+static void encode_vertical_chroma_semi(HQDN3DVTContext *s,
+                                        id<MTLComputeCommandEncoder> encoder,
+                                        const HQDN3DTextures *tex,
+                                        int cw, int ch, int off_u, int off_v,
+                                        int lut_bits, int spatial_offset,
+                                        int temporal_offset) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    struct mtlHqdn3dParams *p = (struct mtlHqdn3dParams *)s->mtlParamsVertChroma.contents;
+    *p = (struct mtlHqdn3dParams){
+        .h_offset = off_u,
+        .h_offset_v = off_v,
+        .fa_offset = off_u,
+        .fa_offset_v = off_v,
+        .spatial_offset = spatial_offset,
+        .temporal_offset = temporal_offset,
+        .width = cw,
+        .height = ch,
+        .depth = s->depth,
+        .lut_bits = lut_bits,
+        .is_msb = s->is_msb,
+        .first_frame = s->first_frame,
+        .spatial_enabled = s->spatial_enabled[1],
+    };
+    [encoder setTexture:tex->mtl_in_c1 atIndex:0];
+    [encoder setTexture:tex->mtl_out_c1 atIndex:1];
+    [encoder setBuffer:s->mtlHBuffer offset:0 atIndex:0];
+    [encoder setBuffer:s->mtlFrameAntBuffer offset:0 atIndex:1];
+    [encoder setBuffer:s->mtlTablesBuffer offset:0 atIndex:2];
+    [encoder setBuffer:s->mtlParamsVertChroma offset:0 atIndex:3];
+    ff_metal_compute_encoder_dispatch(s->mtlDevice, s->mtlPipelineVertSemiplanar, encoder, cw, 1);
+}
+
+static void encode_vertical_chroma_planar(HQDN3DVTContext *s,
+                                          id<MTLComputeCommandEncoder> encoder,
+                                          const HQDN3DTextures *tex,
+                                          int cw, int ch, int off_u, int off_v,
+                                          int lut_bits, int spatial_offset,
+                                          int temporal_offset) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    id<MTLTexture> in_planes[2] = { tex->mtl_in_c1, tex->mtl_in_c2 };
+    id<MTLTexture> out_planes[2] = { tex->mtl_out_c1, tex->mtl_out_c2 };
+    int offs[2] = { off_u, off_v };
+    for (int i = 0; i < 2; i++) {
+        struct mtlHqdn3dParams *p = (struct mtlHqdn3dParams *)s->mtlParamsVertChroma.contents;
+        *p = (struct mtlHqdn3dParams){
+            .h_offset = offs[i],
+            .fa_offset = offs[i],
+            .spatial_offset = spatial_offset,
+            .temporal_offset = temporal_offset,
+            .width = cw,
+            .height = ch,
+            .depth = s->depth,
+            .lut_bits = lut_bits,
+            .is_msb = s->is_msb,
+            .first_frame = s->first_frame,
+            .spatial_enabled = s->spatial_enabled[1],
+        };
+        [encoder setTexture:in_planes[i] atIndex:0];
+        [encoder setTexture:out_planes[i] atIndex:1];
+        [encoder setBuffer:s->mtlHBuffer offset:0 atIndex:0];
+        [encoder setBuffer:s->mtlFrameAntBuffer offset:0 atIndex:1];
+        [encoder setBuffer:s->mtlTablesBuffer offset:0 atIndex:2];
+        [encoder setBuffer:s->mtlParamsVertChroma offset:0 atIndex:3];
+        ff_metal_compute_encoder_dispatch(s->mtlDevice, s->mtlPipelineVertPlanar, encoder, cw, 1);
+    }
+}
+
+static void encode_vertical_chroma(HQDN3DVTContext *s,
+                                   id<MTLComputeCommandEncoder> encoder,
+                                   const HQDN3DTextures *tex,
+                                   int cw, int ch, int off_u, int off_v,
+                                   int lut_bits, int spatial_offset,
+                                   int temporal_offset) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    if (s->is_semiplanar) {
+        encode_vertical_chroma_semi(s, encoder, tex, cw, ch, off_u, off_v,
+                                    lut_bits, spatial_offset, temporal_offset);
+    } else {
+        encode_vertical_chroma_planar(s, encoder, tex, cw, ch, off_u, off_v,
+                                      lut_bits, spatial_offset, temporal_offset);
+    }
+}
+
+static int dispatch_passes(HQDN3DVTContext *s, const HQDN3DTextures *tex) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    id<MTLCommandBuffer> buffer = s->mtlQueue.commandBuffer;
+    id<MTLComputeCommandEncoder> encoder;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    int cw = AV_CEIL_RSHIFT(s->width, s->hsub);
+    int ch = AV_CEIL_RSHIFT(s->height, s->vsub);
+    int off_u = s->width * s->height;
+    int off_v = off_u + cw * ch;
+
+    if (!buffer)
+        return AVERROR_EXTERNAL;
+
+    if (s->spatial_enabled[0] || s->spatial_enabled[1]) {
+        encoder = buffer.computeCommandEncoder;
+        if (!encoder) {
+            ff_objc_release(&buffer);
+            return AVERROR_EXTERNAL;
+        }
+        if (s->spatial_enabled[0])
+            encode_horizontal_luma(s, encoder, tex->mtl_in_y, lut_bits);
+        if (s->spatial_enabled[1])
+            encode_horizontal_chroma(s, encoder, tex, cw, ch, off_u, off_v,
+                                     lut_bits, CHROMA_SPATIAL * table_entries);
+        [encoder endEncoding];
+        ff_objc_release(&encoder);
+    }
+
+    encoder = buffer.computeCommandEncoder;
+    if (!encoder) {
+        ff_objc_release(&buffer);
+        return AVERROR_EXTERNAL;
+    }
+    encode_vertical_luma(s, encoder, tex->mtl_in_y, tex->mtl_out_y, lut_bits, table_entries);
+    encode_vertical_chroma(s, encoder, tex, cw, ch, off_u, off_v,
+                           lut_bits, CHROMA_SPATIAL * table_entries,
+                           CHROMA_TMP * table_entries);
+    [encoder endEncoding];
+    ff_objc_release(&encoder);
+
+    [buffer commit];
+    [buffer waitUntilCompleted];
+    ff_objc_release(&buffer);
+
+    return 0;
+}
+
+static int do_filter_frame(AVFilterLink *inlink, AVFrame *in) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    AVFilterContext *ctx = inlink->dst;
+    HQDN3DVTContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    HQDN3DTextures tex;
+    AVFrame *out = NULL;
+    int err;
+
+    err = check_format_and_size(ctx, in);
+    if (err < 0) {
+        av_frame_free(&in);
+        return err;
+    }
+
+    if (!s->mtlTablesBuffer) {
+        err = init_filter(ctx, in);
+        if (err < 0) {
+            av_frame_free(&in);
+            return err;
+        }
+    }
+
+    out = alloc_output_frame(s, outlink, in);
+    if (!out) {
+        av_frame_free(&in);
+        return AVERROR(ENOMEM);
+    }
+
+    err = acquire_textures(ctx, s, in, out, &tex);
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    err = dispatch_passes(s, &tex);
+    release_all_textures(&tex);
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    CVBufferPropagateAttachments((CVPixelBufferRef)in->data[3], (CVPixelBufferRef)out->data[3]);
+    s->first_frame = 0;
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+}
+
+static int filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *ctx = inlink->dst;
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        return do_filter_frame(inlink, in);
+    } else {
+        av_frame_free(&in);
+        av_log(ctx, AV_LOG_ERROR, "Metal is not available on this OS version\n");
+        return AVERROR(ENOSYS);
+    }
+}
+
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    HQDN3DVTContext *s = ctx->priv;
+    int ret;
+
+    ret = ff_filter_process_command(ctx, cmd, args, res, res_len, flags);
+    if (ret < 0)
+        return ret;
+
+    if (s->mtlTablesBuffer) {
+        if (@available(macOS 10.11, iOS 8.0, *))
+            return calc_coefs(ctx);
+    }
+
+    return 0;
+}
+
+#define OFFSET(x) offsetof(HQDN3DVTContext, x)
+#define FLAGS AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_RUNTIME_PARAM
+
+static const AVOption hqdn3d_videotoolbox_options[] = {
+    { "luma_spatial",   "spatial luma strength",    OFFSET(strength[LUMA_SPATIAL]),   AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "chroma_spatial", "spatial chroma strength",  OFFSET(strength[CHROMA_SPATIAL]), AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "luma_tmp",       "temporal luma strength",   OFFSET(strength[LUMA_TMP]),       AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "chroma_tmp",     "temporal chroma strength", OFFSET(strength[CHROMA_TMP]),     AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(hqdn3d_videotoolbox);
+
+static const AVFilterPad hqdn3d_videotoolbox_inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = filter_frame,
+        .config_props = config_input,
+    },
+};
+
+static const AVFilterPad hqdn3d_videotoolbox_outputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = config_output,
+    },
+};
+
+const FFFilter ff_vf_hqdn3d_videotoolbox = {
+    .p.name          = "hqdn3d_videotoolbox",
+    .p.description   = NULL_IF_CONFIG_SMALL("Apply high quality 3d denoise filter using Metal compute"),
+    .p.priv_class    = &hqdn3d_videotoolbox_class,
+    .p.flags         = AVFILTER_FLAG_HWDEVICE,
+    .priv_size       = HQDN3D_VT_CTX_SIZE,
+    .init            = hqdn3d_videotoolbox_init,
+    .uninit          = hqdn3d_videotoolbox_uninit,
+    FILTER_INPUTS(hqdn3d_videotoolbox_inputs),
+    FILTER_OUTPUTS(hqdn3d_videotoolbox_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_VIDEOTOOLBOX),
+    .flags_internal  = FF_FILTER_FLAG_HWFRAME_AWARE,
+    .process_command = process_command,
+};
