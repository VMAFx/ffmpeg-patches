+
+#ifdef __METAL_VERSION__
+#include <metal_stdlib>
+#include <metal_integer>
+#include <metal_texture>
+using namespace metal;
+#elif defined(METAL_SHIM)
+#include "metal_shim.h"
+using namespace metal;
+#endif
+
+struct Hqdn3dParams {
+    int h_offset;
+    int h_offset_v;
+    int fa_offset;
+    int fa_offset_v;
+    int spatial_offset;
+    int temporal_offset;
+    int width;
+    int height;
+    int depth;
+    int lut_bits;
+    int is_msb;
+    int first_frame;
+    int spatial_enabled;
+};
+
+static inline uint load_sample(uint raw, uint s_depth, uint s_msb)
+{
+    uint shift = 16u - s_depth;
+    uint sample_val = (s_msb != 0u) ? (raw >> shift) : raw;
+    uint rounding = (shift > 0u) ? (((1u << shift) - 1u) >> 1u) : 0u;
+    return (sample_val << shift) + rounding;
+}
+
+static inline uint store_sample(uint val, uint s_depth, uint s_msb)
+{
+    uint shift = 16u - s_depth;
+    uint stored = val >> shift;
+    if (s_msb != 0u) {
+        uint max_val = (1u << s_depth) - 1u;
+        if (stored > max_val)
+            stored = max_val;
+        return stored << shift;
+    }
+    return stored;
+}
+
+static inline int lowpass(int prev_val, int cur_val,
+                          device const short *coef_tables,
+                          int t_offset,
+                          int l_bits)
+{
+    int d = (prev_val - cur_val) >> (8 - l_bits);
+    int center = 256 << l_bits;
+    int idx = t_offset + center + d;
+    int coef = (int)coef_tables[idx];
+    return cur_val + coef;
+}
+
+kernel void hqdn3d_horizontal_planar(
+    texture2d<float, access::read> in_img [[texture(0)]],
+    device ushort *h_data [[buffer(0)]],
+    device const short *coef_tables [[buffer(1)]],
+    constant Hqdn3dParams &params [[buffer(2)]],
+    uint2 pos [[thread_position_in_grid]])
+{
+    uint y = pos.x;
+    if (pos.y > 0 || y >= (uint)params.height)
+        return;
+
+    float max_norm = (params.depth <= 8) ? 255.0f : 65535.0f;
+    int h_row_start = params.h_offset + (int)y * params.width;
+    uint raw0 = (uint)rint(in_img.read(uint2(0, y)).x * max_norm);
+    uint pixel_ant = load_sample(raw0, params.depth, params.is_msb);
+
+    if (y == 0) {
+        for (int x = 0; x < params.width; x++) {
+            uint raw = (uint)rint(in_img.read(uint2(x, 0)).x * max_norm);
+            uint cur = load_sample(raw, params.depth, params.is_msb);
+            pixel_ant = (uint)lowpass((int)pixel_ant, (int)cur, coef_tables, params.spatial_offset, params.lut_bits);
+            h_data[h_row_start + x] = (ushort)pixel_ant;
+        }
+    } else {
+        h_data[h_row_start + 0] = (ushort)pixel_ant;
+        for (int x = 0; x + 1 < params.width; x++) {
+            uint raw = (uint)rint(in_img.read(uint2(x + 1, y)).x * max_norm);
+            uint cur = load_sample(raw, params.depth, params.is_msb);
+            pixel_ant = (uint)lowpass((int)pixel_ant, (int)cur, coef_tables, params.spatial_offset, params.lut_bits);
+            h_data[h_row_start + x + 1] = (ushort)pixel_ant;
+        }
+    }
+}
+
+kernel void hqdn3d_horizontal_semiplanar(
+    texture2d<float, access::read> in_img [[texture(0)]],
+    device ushort *h_data [[buffer(0)]],
+    device const short *coef_tables [[buffer(1)]],
+    constant Hqdn3dParams &params [[buffer(2)]],
+    uint2 pos [[thread_position_in_grid]])
+{
+    uint y = pos.x;
+    if (pos.y > 0 || y >= (uint)params.height)
+        return;
+
+    float max_norm = (params.depth <= 8) ? 255.0f : 65535.0f;
+    int h_row_u = params.h_offset + (int)y * params.width;
+    int h_row_v = params.h_offset_v + (int)y * params.width;
+    float4 raw0 = in_img.read(uint2(0, y));
+    uint pixel_ant_u = load_sample((uint)rint(raw0.x * max_norm), params.depth, params.is_msb);
+    uint pixel_ant_v = load_sample((uint)rint(raw0.y * max_norm), params.depth, params.is_msb);
+
+    if (y == 0) {
+        for (int x = 0; x < params.width; x++) {
+            float4 raw = in_img.read(uint2(x, 0));
+            uint cur_u = load_sample((uint)rint(raw.x * max_norm), params.depth, params.is_msb);
+            uint cur_v = load_sample((uint)rint(raw.y * max_norm), params.depth, params.is_msb);
+            pixel_ant_u = (uint)lowpass((int)pixel_ant_u, (int)cur_u, coef_tables, params.spatial_offset, params.lut_bits);
+            pixel_ant_v = (uint)lowpass((int)pixel_ant_v, (int)cur_v, coef_tables, params.spatial_offset, params.lut_bits);
+            h_data[h_row_u + x] = (ushort)pixel_ant_u;
+            h_data[h_row_v + x] = (ushort)pixel_ant_v;
+        }
+    } else {
+        h_data[h_row_u + 0] = (ushort)pixel_ant_u;
+        h_data[h_row_v + 0] = (ushort)pixel_ant_v;
+        for (int x = 0; x + 1 < params.width; x++) {
+            float4 raw = in_img.read(uint2(x + 1, y));
+            uint cur_u = load_sample((uint)rint(raw.x * max_norm), params.depth, params.is_msb);
+            uint cur_v = load_sample((uint)rint(raw.y * max_norm), params.depth, params.is_msb);
+            pixel_ant_u = (uint)lowpass((int)pixel_ant_u, (int)cur_u, coef_tables, params.spatial_offset, params.lut_bits);
+            pixel_ant_v = (uint)lowpass((int)pixel_ant_v, (int)cur_v, coef_tables, params.spatial_offset, params.lut_bits);
+            h_data[h_row_u + x + 1] = (ushort)pixel_ant_u;
+            h_data[h_row_v + x + 1] = (ushort)pixel_ant_v;
+        }
+    }
+}
+
+static void vertical_planar_temporal(
+    texture2d<float, access::read> in_img,
+    texture2d<float, access::write> out_img,
+    device ushort *frame_ant_data,
+    device const short *coef_tables,
+    constant Hqdn3dParams &params,
+    int x, float max_norm)
+{
+    for (int y = 0; y < params.height; y++) {
+        uint raw = (uint)rint(in_img.read(uint2(x, y)).x * max_norm);
+        int cur = (int)load_sample(raw, params.depth, params.is_msb);
+        int fa_idx = params.fa_offset + y * params.width + x;
+        int prev_ant = params.first_frame ? cur : (int)frame_ant_data[fa_idx];
+        int tmp = lowpass(prev_ant, cur, coef_tables, params.temporal_offset, params.lut_bits);
+        uint out_val = store_sample((uint)tmp, params.depth, params.is_msb);
+        frame_ant_data[fa_idx] = (ushort)tmp;
+        out_img.write(float4((float)out_val / max_norm, 0.0f, 0.0f, 0.0f), uint2(x, y));
+    }
+}
+
+static void vertical_planar_spatial(
+    texture2d<float, access::read> in_img,
+    texture2d<float, access::write> out_img,
+    device const ushort *h_data,
+    device ushort *frame_ant_data,
+    device const short *coef_tables,
+    constant Hqdn3dParams &params,
+    int x, float max_norm)
+{
+    int line_ant = (int)h_data[params.h_offset + x];
+    for (int y = 0; y < params.height; y++) {
+        int spat_tmp = line_ant;
+        int fa_idx = params.fa_offset + y * params.width + x;
+        int prev_ant;
+        if (y > 0) {
+            int h_val = (int)h_data[params.h_offset + y * params.width + x];
+            spat_tmp = lowpass(line_ant, h_val, coef_tables, params.spatial_offset, params.lut_bits);
+            line_ant = (int)(ushort)spat_tmp;
+        }
+        if (params.first_frame) {
+            uint raw = (uint)rint(in_img.read(uint2(x, y)).x * max_norm);
+            prev_ant = (int)load_sample(raw, params.depth, params.is_msb);
+        } else {
+            prev_ant = (int)frame_ant_data[fa_idx];
+        }
+        int temp_tmp = lowpass(prev_ant, spat_tmp, coef_tables, params.temporal_offset, params.lut_bits);
+        uint out_val = store_sample((uint)temp_tmp, params.depth, params.is_msb);
+        frame_ant_data[fa_idx] = (ushort)temp_tmp;
+        out_img.write(float4((float)out_val / max_norm, 0.0f, 0.0f, 0.0f), uint2(x, y));
+    }
+}
+
+kernel void hqdn3d_vertical_planar(
+    texture2d<float, access::read> in_img [[texture(0)]],
+    texture2d<float, access::write> out_img [[texture(1)]],
+    device const ushort *h_data [[buffer(0)]],
+    device ushort *frame_ant_data [[buffer(1)]],
+    device const short *coef_tables [[buffer(2)]],
+    constant Hqdn3dParams &params [[buffer(3)]],
+    uint2 pos [[thread_position_in_grid]])
+{
+    uint x = pos.x;
+    if (pos.y > 0 || x >= (uint)params.width)
+        return;
+
+    float max_norm = (params.depth <= 8) ? 255.0f : 65535.0f;
+    if (params.spatial_enabled == 0) {
+        vertical_planar_temporal(in_img, out_img, frame_ant_data,
+                                 coef_tables, params, (int)x, max_norm);
+    } else {
+        vertical_planar_spatial(in_img, out_img, h_data, frame_ant_data,
+                                coef_tables, params, (int)x, max_norm);
+    }
+}
+
+static void vertical_semiplanar_temporal(
+    texture2d<float, access::read> in_img,
+    texture2d<float, access::write> out_img,
+    device ushort *frame_ant_data,
+    device const short *coef_tables,
+    constant Hqdn3dParams &params,
+    int x, float max_norm)
+{
+    for (int y = 0; y < params.height; y++) {
+        float4 raw = in_img.read(uint2(x, y));
+        int cur_u = (int)load_sample((uint)rint(raw.x * max_norm), params.depth, params.is_msb);
+        int cur_v = (int)load_sample((uint)rint(raw.y * max_norm), params.depth, params.is_msb);
+        int fa_u = params.fa_offset + y * params.width + x;
+        int fa_v = params.fa_offset_v + y * params.width + x;
+        int prev_u = params.first_frame ? cur_u : (int)frame_ant_data[fa_u];
+        int prev_v = params.first_frame ? cur_v : (int)frame_ant_data[fa_v];
+        int tmp_u = lowpass(prev_u, cur_u, coef_tables, params.temporal_offset, params.lut_bits);
+        int tmp_v = lowpass(prev_v, cur_v, coef_tables, params.temporal_offset, params.lut_bits);
+        uint out_u = store_sample((uint)tmp_u, params.depth, params.is_msb);
+        uint out_v = store_sample((uint)tmp_v, params.depth, params.is_msb);
+        frame_ant_data[fa_u] = (ushort)tmp_u;
+        frame_ant_data[fa_v] = (ushort)tmp_v;
+        out_img.write(float4((float)out_u / max_norm, (float)out_v / max_norm, 0.0f, 0.0f), uint2(x, y));
+    }
+}
+
+static void vertical_semiplanar_spatial(
+    texture2d<float, access::read> in_img,
+    texture2d<float, access::write> out_img,
+    device const ushort *h_data,
+    device ushort *frame_ant_data,
+    device const short *coef_tables,
+    constant Hqdn3dParams &params,
+    int x, float max_norm)
+{
+    int line_ant_u = (int)h_data[params.h_offset + x];
+    int line_ant_v = (int)h_data[params.h_offset_v + x];
+    for (int y = 0; y < params.height; y++) {
+        int spat_tmp_u = line_ant_u;
+        int spat_tmp_v = line_ant_v;
+        int fa_u = params.fa_offset + y * params.width + x;
+        int fa_v = params.fa_offset_v + y * params.width + x;
+        int prev_u, prev_v;
+        if (y > 0) {
+            int h_u = (int)h_data[params.h_offset + y * params.width + x];
+            int h_v = (int)h_data[params.h_offset_v + y * params.width + x];
+            spat_tmp_u = lowpass(line_ant_u, h_u, coef_tables, params.spatial_offset, params.lut_bits);
+            spat_tmp_v = lowpass(line_ant_v, h_v, coef_tables, params.spatial_offset, params.lut_bits);
+            line_ant_u = (int)(ushort)spat_tmp_u;
+            line_ant_v = (int)(ushort)spat_tmp_v;
+        }
+        if (params.first_frame) {
+            float4 raw = in_img.read(uint2(x, y));
+            prev_u = (int)load_sample((uint)rint(raw.x * max_norm), params.depth, params.is_msb);
+            prev_v = (int)load_sample((uint)rint(raw.y * max_norm), params.depth, params.is_msb);
+        } else {
+            prev_u = (int)frame_ant_data[fa_u];
+            prev_v = (int)frame_ant_data[fa_v];
+        }
+        int temp_tmp_u = lowpass(prev_u, spat_tmp_u, coef_tables, params.temporal_offset, params.lut_bits);
+        int temp_tmp_v = lowpass(prev_v, spat_tmp_v, coef_tables, params.temporal_offset, params.lut_bits);
+        uint out_u = store_sample((uint)temp_tmp_u, params.depth, params.is_msb);
+        uint out_v = store_sample((uint)temp_tmp_v, params.depth, params.is_msb);
+        frame_ant_data[fa_u] = (ushort)temp_tmp_u;
+        frame_ant_data[fa_v] = (ushort)temp_tmp_v;
+        out_img.write(float4((float)out_u / max_norm, (float)out_v / max_norm, 0.0f, 0.0f), uint2(x, y));
+    }
+}
+
+kernel void hqdn3d_vertical_semiplanar(
+    texture2d<float, access::read> in_img [[texture(0)]],
+    texture2d<float, access::write> out_img [[texture(1)]],
+    device const ushort *h_data [[buffer(0)]],
+    device ushort *frame_ant_data [[buffer(1)]],
+    device const short *coef_tables [[buffer(2)]],
+    constant Hqdn3dParams &params [[buffer(3)]],
+    uint2 pos [[thread_position_in_grid]])
+{
+    uint x = pos.x;
+    if (pos.y > 0 || x >= (uint)params.width)
+        return;
+
+    float max_norm = (params.depth <= 8) ? 255.0f : 65535.0f;
+    if (params.spatial_enabled == 0) {
+        vertical_semiplanar_temporal(in_img, out_img, frame_ant_data,
+                                     coef_tables, params, (int)x, max_norm);
+    } else {
+        vertical_semiplanar_spatial(in_img, out_img, h_data, frame_ant_data,
+                                    coef_tables, params, (int)x, max_norm);
+    }
+}
