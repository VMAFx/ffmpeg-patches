+static int create_pipeline(AVFilterContext *ctx, id<MTLDevice> device,
+                           id<MTLLibrary> library, NSString *name,
+                           id<MTLFunction> *func_out,
+                           id<MTLComputePipelineState> *pipe_out) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    NSError *err = nil;
+    *func_out = [library newFunctionWithName:name];
+    if (!*func_out) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to find Metal function %s\n", name.UTF8String);
+        return AVERROR_EXTERNAL;
+    }
+    *pipe_out = [device newComputePipelineStateWithFunction:*func_out error:&err];
+    if (err || !*pipe_out) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create Metal compute pipeline for %s: %s\n",
+               name.UTF8String, err ? err.description.UTF8String : "unknown error");
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+static int create_param_buffers(AVFilterContext *ctx, HQDN3DVTContext *s) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    s->mtlParamsHorizLuma = [s->mtlDevice newBufferWithLength:sizeof(struct mtlHqdn3dParams)
+                                                      options:MTLResourceStorageModeShared];
+    s->mtlParamsHorizChroma = [s->mtlDevice newBufferWithLength:sizeof(struct mtlHqdn3dParams)
+                                                        options:MTLResourceStorageModeShared];
+    s->mtlParamsVertLuma = [s->mtlDevice newBufferWithLength:sizeof(struct mtlHqdn3dParams)
+                                                    options:MTLResourceStorageModeShared];
+    s->mtlParamsVertChroma = [s->mtlDevice newBufferWithLength:sizeof(struct mtlHqdn3dParams)
+                                                      options:MTLResourceStorageModeShared];
+    if (!s->mtlParamsHorizLuma || !s->mtlParamsHorizChroma ||
+        !s->mtlParamsVertLuma || !s->mtlParamsVertChroma) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to allocate Metal parameter buffers\n");
+        return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+
+static int init_pipelines(AVFilterContext *ctx, HQDN3DVTContext *s) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    int r;
+    r = create_pipeline(ctx, s->mtlDevice, s->mtlLibrary, @"hqdn3d_horizontal_planar",
+                        &s->mtlFuncHorizPlanar, &s->mtlPipelineHorizPlanar);
+    if (r < 0)
+        return r;
+    r = create_pipeline(ctx, s->mtlDevice, s->mtlLibrary, @"hqdn3d_horizontal_semiplanar",
+                        &s->mtlFuncHorizSemiplanar, &s->mtlPipelineHorizSemiplanar);
+    if (r < 0)
+        return r;
+    r = create_pipeline(ctx, s->mtlDevice, s->mtlLibrary, @"hqdn3d_vertical_planar",
+                        &s->mtlFuncVertPlanar, &s->mtlPipelineVertPlanar);
+    if (r < 0)
+        return r;
+    return create_pipeline(ctx, s->mtlDevice, s->mtlLibrary, @"hqdn3d_vertical_semiplanar",
+                           &s->mtlFuncVertSemiplanar, &s->mtlPipelineVertSemiplanar);
+}
+
+static int init_metal_device(AVFilterContext *ctx, HQDN3DVTContext *s) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    NSError *err = nil;
+    dispatch_data_t libData;
+
+    s->mtlDevice = MTLCreateSystemDefaultDevice();
+    if (!s->mtlDevice) {
+        av_log(ctx, AV_LOG_ERROR, "Unable to find Metal device\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    av_log(ctx, AV_LOG_INFO, "Using Metal device: %s\n", s->mtlDevice.name.UTF8String);
+
+    libData = dispatch_data_create(
+        ff_vf_hqdn3d_videotoolbox_metallib_data,
+        ff_vf_hqdn3d_videotoolbox_metallib_len,
+        nil,
+        nil);
+    s->mtlLibrary = [s->mtlDevice newLibraryWithData:libData error:&err];
+    dispatch_release(libData);
+    libData = nil;
+    if (err || !s->mtlLibrary) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to load Metal library: %s\n",
+               err ? err.description.UTF8String : "unknown error");
+        return AVERROR_EXTERNAL;
+    }
+
+    s->mtlQueue = s->mtlDevice.newCommandQueue;
+    if (!s->mtlQueue) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create Metal command queue\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    return 0;
+}
+
+static av_cold int do_init(AVFilterContext *ctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    HQDN3DVTContext *s = ctx->priv;
+    CVReturn ret;
+    int r;
+
+    r = init_metal_device(ctx, s);
+    if (r < 0) {
+        do_uninit(ctx);
+        return r;
+    }
+
+    r = init_pipelines(ctx, s);
+    if (r < 0) {
+        do_uninit(ctx);
+        return r;
+    }
+
+    r = create_param_buffers(ctx, s);
+    if (r < 0) {
+        do_uninit(ctx);
+        return r;
+    }
+
+    ret = CVMetalTextureCacheCreate(
+        NULL,
+        NULL,
+        s->mtlDevice,
+        NULL,
+        &s->textureCache
+    );
+    if (ret != kCVReturnSuccess) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create CVMetalTextureCache: %d\n", ret);
+        do_uninit(ctx);
+        return AVERROR_EXTERNAL;
+    }
+
+    ff_hqdn3d_default_strengths(s->strength);
+    return 0;
+}
