+static int validate_format(AVFilterContext *ctx, enum AVPixelFormat sw_format,
+                           int *depth, int *is_msb, int *is_semiplanar)
+{
+    switch (sw_format) {
+    case AV_PIX_FMT_YUV420P:
+        *depth = 8;
+        *is_msb = 0;
+        *is_semiplanar = 0;
+        return 0;
+    case AV_PIX_FMT_NV12:
+    case AV_PIX_FMT_NV16:
+    case AV_PIX_FMT_NV24:
+        *depth = 8;
+        *is_msb = 0;
+        *is_semiplanar = 1;
+        return 0;
+    case AV_PIX_FMT_P010:
+    case AV_PIX_FMT_P210:
+    case AV_PIX_FMT_P410:
+        *depth = 10;
+        *is_msb = 1;
+        *is_semiplanar = 1;
+        return 0;
+    case AV_PIX_FMT_P216:
+    case AV_PIX_FMT_P416:
+        *depth = 16;
+        *is_msb = 0;
+        *is_semiplanar = 1;
+        return 0;
+    default:
+        av_log(ctx, AV_LOG_ERROR, "Unsupported sw_format: %s\n",
+               av_get_pix_fmt_name(sw_format));
+        return AVERROR(ENOSYS);
+    }
+}
+
+static int init_buffers(AVFilterContext *ctx, int w, int h) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    HQDN3DVTContext *s = ctx->priv;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    size_t tables_sz = (size_t)4 * (512 << lut_bits) * sizeof(int16_t);
+    int cw = AV_CEIL_RSHIFT(w, s->hsub);
+    int ch = AV_CEIL_RSHIFT(h, s->vsub);
+    size_t samples = (size_t)w * h + (size_t)2 * cw * ch;
+    size_t data_sz = samples * sizeof(uint16_t);
+
+    s->mtlTablesBuffer = [s->mtlDevice newBufferWithLength:tables_sz
+                                                   options:MTLResourceStorageModeShared];
+    if (!s->mtlTablesBuffer)
+        return AVERROR(ENOMEM);
+
+    s->mtlHBuffer = [s->mtlDevice newBufferWithLength:data_sz
+                                              options:MTLResourceStorageModePrivate];
+    if (!s->mtlHBuffer) {
+        free_buffers(s);
+        return AVERROR(ENOMEM);
+    }
+
+    s->mtlFrameAntBuffer = [s->mtlDevice newBufferWithLength:data_sz
+                                                     options:MTLResourceStorageModePrivate];
+    if (!s->mtlFrameAntBuffer) {
+        free_buffers(s);
+        return AVERROR(ENOMEM);
+    }
+
+    return 0;
+}
+
+static int calc_coefs(AVFilterContext *ctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    HQDN3DVTContext *s = ctx->priv;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    size_t tables_sz = (size_t)4 * table_entries * sizeof(int16_t);
+    int16_t *tables = av_malloc(tables_sz);
+
+    if (!tables)
+        return AVERROR(ENOMEM);
+
+    for (int i = 0; i < 4; i++) {
+        int16_t *ct = tables + i * table_entries;
+        ff_hqdn3d_precalc_coefs(s->strength[i], s->depth, ct);
+    }
+
+    s->spatial_enabled[0] = s->strength[LUMA_SPATIAL] != 0.0;
+    s->spatial_enabled[1] = s->strength[CHROMA_SPATIAL] != 0.0;
+
+    memcpy(s->mtlTablesBuffer.contents, tables, tables_sz);
+    av_free(tables);
+    return 0;
+}
