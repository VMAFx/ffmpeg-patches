+static int create_out_frames_ctx(AVFilterContext *ctx, AVFrame *in) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    HQDN3DVTContext *s = ctx->priv;
+    AVHWFramesContext *in_hwfc = (AVHWFramesContext *)in->hw_frames_ctx->data;
+    AVHWFramesContext *frames_ctx;
+    AVBufferRef *device_ref = in_hwfc->device_ref ? in_hwfc->device_ref : s->device_ref;
+    int err;
+
+    if (!device_ref)
+        return AVERROR(EINVAL);
+
+    av_buffer_unref(&s->out_frames_ref);
+
+    s->out_frames_ref = av_hwframe_ctx_alloc(device_ref);
+    if (!s->out_frames_ref)
+        return AVERROR(ENOMEM);
+
+    frames_ctx = (AVHWFramesContext *)s->out_frames_ref->data;
+    frames_ctx->format    = AV_PIX_FMT_VIDEOTOOLBOX;
+    frames_ctx->sw_format = in_hwfc->sw_format;
+    frames_ctx->width     = in->width;
+    frames_ctx->height    = in->height;
+    if (in_hwfc->hwctx && frames_ctx->hwctx) {
+        ((AVVTFramesContext *)frames_ctx->hwctx)->color_range =
+            ((AVVTFramesContext *)in_hwfc->hwctx)->color_range;
+    }
+
+    err = av_hwframe_ctx_init(s->out_frames_ref);
+    if (err < 0) {
+        av_buffer_unref(&s->out_frames_ref);
+        return err;
+    }
+
+    ctx->outputs[0]->w = in->width;
+    ctx->outputs[0]->h = in->height;
+    return 0;
+}
+
+static AVFrame *alloc_output_frame(HQDN3DVTContext *s, AVFilterLink *outlink, AVFrame *in)
+{
+    AVFrame *out = NULL;
+    int err;
+
+    if (s->out_frames_ref) {
+        out = av_frame_alloc();
+        if (!out)
+            return NULL;
+        err = av_hwframe_get_buffer(s->out_frames_ref, out, 0);
+        if (err < 0) {
+            av_frame_free(&out);
+            return NULL;
+        }
+    } else {
+        out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+        if (!out)
+            return NULL;
+    }
+
+    if (av_frame_copy_props(out, in) < 0) {
+        av_frame_free(&out);
+        return NULL;
+    }
+    return out;
+}
