+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVFILTER_BT2408_HABLE_H
+#define AVFILTER_BT2408_HABLE_H
+
+#include "libavutil/pixfmt.h"
+
+#define FF_BT2408_HABLE_LUT_SIZE 256
+
+/**
+ * Everything needed to tone map one frame. All members are 32-bit scalars
+ * or arrays of them, so the struct can be uploaded unchanged as an OpenCL
+ * or std430 Vulkan buffer.
+ */
+typedef struct FFBT2408Hable {
+    float rgb_to_lms[3][3];  ///< linear input RGB, 1.0 = 100 cd/m^2, to LMS
+    float lms_to_rgb[3][3];  ///< LMS to linear BT.709 RGB
+    float lut_min;           ///< PQ intensity of the first LUT entry
+    float lut_max;           ///< PQ intensity of the last LUT entry
+    float lut[FF_BT2408_HABLE_LUT_SIZE]; ///< tone curve on PQ intensity
+    float black_scale;       ///< BT.1886 encoding with a 1000:1 contrast
+    float black_offset;
+} FFBT2408Hable;
+
+/**
+ * Fill out for one input colour space and signal peak.
+ *
+ * @param prim primaries of the input, with a D65 white point
+ * @param peak signal peak in cd/m^2
+ * @return 0 on success, AVERROR(ENOTSUP) for other primaries,
+ *         AVERROR(EINVAL) for a peak that is not a positive number
+ */
+int ff_bt2408_hable_init(FFBT2408Hable *s, enum AVColorPrimaries prim, double peak);
+
+/**
+ * Tone map one pixel.
+ *
+ * @param in  linear RGB in the input primaries, 1.0 = 100 cd/m^2
+ * @param out linear BT.709 RGB in [0, 1] for a pure power 2.4 display,
+ *            1.0 = reference white (203 cd/m^2, ITU-R BT.2408)
+ */
+void ff_bt2408_hable_pixel(const FFBT2408Hable *s, const float in[3], float out[3]);
+
+#endif /* AVFILTER_BT2408_HABLE_H */
diff --git a/libavfilter/tests/bt2408_hable.c b/libavfilter/tests/bt2408_hable.c
new file mode 100644
index 0000000000000000000000000000000000000000..52edc725b8528815211f9cc24bae67eda8bf1d7b
--- /dev/null
+++ b/libavfilter/tests/bt2408_hable.c
@@ -0,0 +1,127 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <math.h>
+#include <stdio.h>
+
+#include "libavutil/error.h"
+
+#include "libavfilter/bt2408_hable.c"
+
+#define PEAK 1000.0
+#define TOL  2e-4f
+
+/*
+ * BT.2020 input, 1.0 = 100 cd/m^2, peak 1000 cd/m^2. The expected values
+ * come from a double precision model of the libplacebo v7.360.1 colour map,
+ * written separately from this port.
+ */
+static const struct {
+    float in[3], out[3];
+} cases[] = {
+    { { 0.5f,  0.5f,  0.5f  }, { 0.1159569f, 0.1159569f, 0.1159570f } }, /* grey */
+    { { 2.03f, 2.03f, 2.03f }, { 0.3907243f, 0.3907245f, 0.3907246f } }, /* reference white */
+    { { 3.0f,  2.0f,  1.5f  }, { 0.7225472f, 0.3582895f, 0.2667108f } }, /* warm highlight */
+    { { 0.8f,  1.2f,  2.5f  }, { 0.0841885f, 0.2574010f, 0.5698625f } }, /* sky blue */
+    { { 0.05f, 0.3f,  4.0f  }, { 0.0000000f, 0.0704900f, 1.0000000f } }, /* clipped blue */
+    { { 6.0f,  5.5f,  5.8f  }, { 0.8534305f, 0.7344222f, 0.7876654f } }, /* near the peak */
+    { { 0.0f,  0.0f,  0.0f  }, { 0.0000000f, 0.0000000f, 0.0000000f } }, /* black */
+};
+
+static int near(const float *got, const float *want)
+{
+    for (int i = 0; i < 3; i++)
+        if (!(fabsf(got[i] - want[i]) <= TOL))
+            return 0;
+    return 1;
+}
+
+static int check_cases(const FFBT2408Hable *s)
+{
+    int fails = 0;
+
+    for (size_t n = 0; n < FF_ARRAY_ELEMS(cases); n++) {
+        float out[3];
+        ff_bt2408_hable_pixel(s, cases[n].in, out);
+        if (near(out, cases[n].out))
+            printf("case %zu: ok\n", n);
+        else
+            printf("case %zu: WRONG %.7f %.7f %.7f\n", n, out[0], out[1], out[2]);
+        fails += !near(out, cases[n].out);
+    }
+    return fails;
+}
+
+/* The planted error: a peak four times too high must miss the expected colour. */
+static int check_planted(void)
+{
+    FFBT2408Hable s;
+    float out[3];
+    int detected;
+
+    ff_bt2408_hable_init(&s, AVCOL_PRI_BT2020, 4 * PEAK);
+    ff_bt2408_hable_pixel(&s, cases[2].in, out);
+    detected = !near(out, cases[2].out);
+    printf("planted wrong peak: %s\n", detected ? "detected" : "MISSED");
+    return !detected;
+}
+
+/* A peak below 100 cd/m^2 is not expanded: it maps like a 100 cd/m^2 peak. */
+static int check_low_peak(void)
+{
+    FFBT2408Hable low, ref;
+    float a[3], b[3];
+    const float in[3] = { 0.6f, 0.4f, 0.3f };
+    int ok;
+
+    ff_bt2408_hable_init(&low, AVCOL_PRI_BT2020, 50.0);
+    ff_bt2408_hable_init(&ref, AVCOL_PRI_BT2020, 100.0);
+    ff_bt2408_hable_pixel(&low, in, a);
+    ff_bt2408_hable_pixel(&ref, in, b);
+    ok = a[0] == b[0] && a[1] == b[1] && a[2] == b[2];
+    printf("peak below 100 cd/m^2 clamps: %s\n", ok ? "ok" : "WRONG");
+    return !ok;
+}
+
+static int expect_refusal(enum AVColorPrimaries prim, double peak, const char *what, int want)
+{
+    FFBT2408Hable s;
+    int ret = ff_bt2408_hable_init(&s, prim, peak);
+
+    printf("%s: %s\n", what, ret == want ? "refused" : "ACCEPTED");
+    return ret != want;
+}
+
+int main(void)
+{
+    FFBT2408Hable s;
+    int fails = 0;
+
+    if (ff_bt2408_hable_init(&s, AVCOL_PRI_BT2020, PEAK) < 0) {
+        printf("init failed\n");
+        return 1;
+    }
+    fails += check_cases(&s);
+    fails += check_planted();
+    fails += check_low_peak();
+    fails += expect_refusal(AVCOL_PRI_BT2020, 0.0, "zero peak", AVERROR(EINVAL));
+    fails += expect_refusal(AVCOL_PRI_BT2020, NAN, "NaN peak", AVERROR(EINVAL));
+    fails += expect_refusal(AVCOL_PRI_UNSPECIFIED, PEAK, "unspecified primaries", AVERROR(ENOTSUP));
+    fails += expect_refusal(AVCOL_PRI_SMPTE431, PEAK, "DCI white point", AVERROR(ENOTSUP));
+    return fails != 0;
+}
