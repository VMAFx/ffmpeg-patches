 #include "colorspace.h"
 #include "filters.h"
 #include "video.h"
@@ -47,6 +48,7 @@ enum TonemapAlgorithm {
     TONEMAP_REINHARD,
     TONEMAP_HABLE,
     TONEMAP_MOBIUS,
+    TONEMAP_BT2408_HABLE,
     TONEMAP_MAX,
 };
 
