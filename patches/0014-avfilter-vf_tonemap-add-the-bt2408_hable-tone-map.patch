+++ b/libavfilter/tests/bt2408_hable.c
@@ -18,9 +18,15 @@
 
 #include <math.h>
 #include <stdio.h>
+#include <string.h>
 
 #include "libavutil/error.h"
+#include "libavutil/frame.h"
+#include "libavutil/mastering_display_metadata.h"
 
+#include "libavfilter/avfilter.h"
+#include "libavfilter/buffersink.h"
+#include "libavfilter/buffersrc.h"
 #include "libavfilter/bt2408_hable.c"
 
 #define PEAK 1000.0
@@ -107,11 +113,149 @@ static int expect_refusal(enum AVColorPrimaries prim, double peak, const char *w
     return ret != want;
 }
 
-int main(void)
+/* Runs buffer -> tonemap=bt2408_hable -> buffersink on one frame. */
+static int run_filter(AVFrame *in, AVFrame *out)
+{
+    AVFilterGraph *g = avfilter_graph_alloc();
+    AVFilterContext *src = NULL, *tm = NULL, *sink = NULL;
+    char args[128];
+    int ret;
+
+    if (!g)
+        return AVERROR(ENOMEM);
+    snprintf(args, sizeof(args), "video_size=%dx%d:pix_fmt=%d:time_base=1/25",
+             in->width, in->height, in->format);
+    ret = avfilter_graph_create_filter(&src, avfilter_get_by_name("buffer"), "in", args, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_graph_create_filter(&tm, avfilter_get_by_name("tonemap"), "tm",
+                                           "tonemap=bt2408_hable", NULL, g);
+    if (ret >= 0)
+        ret = avfilter_graph_create_filter(&sink, avfilter_get_by_name("buffersink"), "out", NULL, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_link(src, 0, tm, 0);
+    if (ret >= 0)
+        ret = avfilter_link(tm, 0, sink, 0);
+    if (ret >= 0)
+        ret = avfilter_graph_config(g, NULL);
+    if (ret >= 0)
+        ret = av_buffersrc_add_frame_flags(src, in, AV_BUFFERSRC_FLAG_KEEP_REF);
+    if (ret >= 0)
+        ret = av_buffersrc_add_frame(src, NULL);
+    if (ret >= 0)
+        ret = av_buffersink_get_frame(sink, out);
+    avfilter_graph_free(&g);
+    return ret;
+}
+
+static int add_light_levels(AVFrame *f, unsigned max_cll, unsigned mastering_max)
+{
+    if (max_cll) {
+        AVContentLightMetadata *cll = av_content_light_metadata_create_side_data(f);
+        if (!cll)
+            return AVERROR(ENOMEM);
+        cll->MaxCLL = max_cll;
+    }
+    if (mastering_max) {
+        AVMasteringDisplayMetadata *md = av_mastering_display_metadata_create_side_data(f);
+        if (!md)
+            return AVERROR(ENOMEM);
+        md->max_luminance = av_make_q(mastering_max, 1);
+        md->min_luminance = av_make_q(1, 10000);
+        md->has_luminance = 1;
+    }
+    return 0;
+}
+
+/* One row of the test colours in linear BT.2020, with the given light levels. */
+static AVFrame *make_frame(unsigned max_cll, unsigned mastering_max)
+{
+    const int w = FF_ARRAY_ELEMS(cases);
+    AVFrame *f = av_frame_alloc();
+
+    if (!f)
+        return NULL;
+    f->format = AV_PIX_FMT_GBRPF32;
+    f->width  = w;
+    f->height = 1;
+    f->color_primaries = AVCOL_PRI_BT2020;
+    f->color_trc       = AVCOL_TRC_LINEAR;
+    f->colorspace      = AVCOL_SPC_RGB;
+    if (av_frame_get_buffer(f, 0) < 0 || add_light_levels(f, max_cll, mastering_max) < 0) {
+        av_frame_free(&f);
+        return NULL;
+    }
+    for (int x = 0; x < w; x++) {
+        ((float *)f->data[2])[x] = cases[x].in[0];
+        ((float *)f->data[0])[x] = cases[x].in[1];
+        ((float *)f->data[1])[x] = cases[x].in[2];
+    }
+    return f;
+}
+
+/* Returns 1 when every pixel matches its expected colour. */
+static int frame_matches(const AVFrame *out)
+{
+    for (int x = 0; x < out->width; x++) {
+        const float got[3] = {
+            ((const float *)out->data[2])[x],
+            ((const float *)out->data[0])[x],
+            ((const float *)out->data[1])[x],
+        };
+        if (!near(got, cases[x].out))
+            return 0;
+    }
+    return 1;
+}
+
+/* Returns 1 on a match, 0 on a mismatch, a negative error when the run failed. */
+static int filter_case(unsigned max_cll, unsigned mastering_max, int *tags_ok)
+{
+    AVFrame *in = make_frame(max_cll, mastering_max), *out = av_frame_alloc();
+    int ret = in && out ? run_filter(in, out) : AVERROR(ENOMEM);
+
+    if (ret >= 0) {
+        if (tags_ok)
+            *tags_ok = out->color_primaries == AVCOL_PRI_BT709 &&
+                       out->color_trc == AVCOL_TRC_LINEAR &&
+                       !av_frame_get_side_data(out, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL) &&
+                       !av_frame_get_side_data(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+        ret = frame_matches(out);
+    }
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return ret;
+}
+
+static int check_filter(void)
+{
+    int fails = 0, tags_ok = 0, ret;
+
+    ret = filter_case(1000, 0, &tags_ok);
+    printf("peak from MaxCLL: %s\n", ret == 1 ? "ok" : "WRONG");
+    printf("output tagged BT.709, light levels dropped: %s\n", tags_ok ? "ok" : "WRONG");
+    fails += ret != 1 || !tags_ok;
+
+    ret = filter_case(0, 1000, NULL);
+    printf("peak from mastering display: %s\n", ret == 1 ? "ok" : "WRONG");
+    fails += ret != 1;
+
+    /* The planted error: a frame whose MaxCLL says 4000 cd/m^2 must map differently. */
+    ret = filter_case(4000, 0, NULL);
+    printf("planted wrong MaxCLL: %s\n", ret == 0 ? "detected" : "MISSED");
+    fails += ret != 0;
+    return fails;
+}
+
+int main(int argc, char **argv)
 {
     FFBT2408Hable s;
     int fails = 0;
 
+    if (argc > 1 && !strcmp(argv[1], "filter")) {
+        av_log_set_level(AV_LOG_QUIET);
+        return check_filter() != 0;
+    }
+
     if (ff_bt2408_hable_init(&s, AVCOL_PRI_BT2020, PEAK) < 0) {
         printf("init failed\n");
         return 1;
diff --git a/libavfilter/vf_tonemap.c b/libavfilter/vf_tonemap.c
