diff --git a/libavfilter/tests/bt2408_hable.c b/libavfilter/tests/bt2408_hable.c
index 52edc725b8528815211f9cc24bae67eda8bf1d7b..f867ba2bfb7bb5d8bfb0f1c0a3a01d5496d026e2 100644
