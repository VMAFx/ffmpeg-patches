+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVFILTER_DOVI_RESHAPE_H
+#define AVFILTER_DOVI_RESHAPE_H
+
+#include <stdint.h>
+
+#include "libavutil/dovi_meta.h"
+
+/**
+ * Reshaping curve of one component, normalized to [0, 1] input and output.
+ * All members are 32-bit scalars or arrays of them, so the struct can be
+ * uploaded unchanged as an OpenCL or std430 Vulkan buffer.
+ */
+typedef struct FFDoviCurve {
+    int32_t num_pivots;                          ///< 0: identity, else [2, 9]
+    float   pivots[AV_DOVI_MAX_PIECES + 1];
+    int32_t method[AV_DOVI_MAX_PIECES];          ///< enum AVDOVIMappingMethod
+    float   poly[AV_DOVI_MAX_PIECES][3];         ///< x^0, x^1, x^2
+    int32_t mmr_order[AV_DOVI_MAX_PIECES];       ///< [1, 3]
+    float   mmr_constant[AV_DOVI_MAX_PIECES];
+    float   mmr[AV_DOVI_MAX_PIECES][3][7];
+} FFDoviCurve;
+
+/**
+ * Everything needed to turn the decoded base layer of a Dolby Vision
+ * profile 5 frame into nonlinear (PQ) BT.2020 RGB.
+ */
+typedef struct FFDoviReshape {
+    FFDoviCurve curve[3];
+    float ycc_to_rgb[3][3];  ///< reshaped IPT to L'M'S'
+    float ycc_offset[3];     ///< subtracted before ycc_to_rgb
+    float lms_to_rgb[3][3];  ///< linear LMS to linear BT.2020 RGB
+    float min_pq;            ///< source_min_pq, normalized to [0, 1]
+    float max_pq;            ///< source_max_pq, normalized to [0, 1]
+} FFDoviReshape;
+
+/**
+ * Fill out from the metadata of one frame.
+ *
+ * @return 0 on success, AVERROR(ENOTSUP) for a frame whose enhancement layer
+ *         carries a residual (not profile 5), AVERROR_INVALIDDATA for
+ *         metadata outside the ranges the RPU syntax allows
+ */
+int ff_dovi_reshape_init(FFDoviReshape *out, const AVDOVIMetadata *md);
+
+/**
+ * Reshape one component.
+ *
+ * @param sig all three components of the pixel, normalized to [0, 1]
+ * @return the reshaped component c, clamped to the outer pivots
+ */
+float ff_dovi_reshape_comp(const FFDoviCurve *curve, const float sig[3], int c);
+
+/**
+ * Reshape and decode one pixel.
+ *
+ * @param ycc the decoded base layer sample, normalized to [0, 1]
+ * @param rgb nonlinear (PQ) BT.2020 RGB, 1.0 = 10000 cd/m^2
+ */
+void ff_dovi_reshape_pixel(const FFDoviReshape *s, const float ycc[3], float rgb[3]);
+
+#endif /* AVFILTER_DOVI_RESHAPE_H */
diff --git a/libavfilter/tests/dovi_reshape.c b/libavfilter/tests/dovi_reshape.c
new file mode 100644
index 0000000000000000000000000000000000000000..8285ca116ac47e7ea7025659f9b6381e907c753c
--- /dev/null
+++ b/libavfilter/tests/dovi_reshape.c
@@ -0,0 +1,221 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <math.h>
+#include <stdio.h>
+
+#include "libavutil/dovi_meta.h"
+#include "libavutil/error.h"
+#include "libavutil/mem.h"
+
+#include "libavfilter/dovi_reshape.c"
+
+/*
+ * The expected values come from a double precision model of the libplacebo
+ * v7.360.1 reshaping and decoding, written separately from this port.
+ */
+static const struct {
+    float in[3], comp[3], rgb[3];
+} cases[] = {
+    { { 0.2f, 0.45f, 0.55f }, { 0.1920000f, 0.2922774f, 0.8250000f },
+      { 0.1276666f, 0.2802370f, 0.0000007f } },
+    { { 0.9f, 0.1f, 0.8f }, { 0.9050000f, 0.0438910f, 0.9384164f },
+      { 0.0000007f, 1.0554591f, 0.0000007f } },
+    { { 0.01f, 0.95f, 0.01f }, { 0.0190050f, 0.7270402f, 0.0625611f },
+      { 0.1545720f, 0.0000007f, 0.3284277f } },
+    { { 0.6f, 0.5f, 0.5f }, { 0.6050000f, 0.3681612f, 0.7500000f },
+      { 0.6063548f, 0.6728913f, 0.3535421f } },
+};
+
+static const int64_t cb_mmr[3][7] = {
+    {  419430, 7549747, -251658, 167772,  83886, -335544,  251658 },
+    {   83886, -419430,  167772,      0, 251658,   83886, -167772 },
+    {  -83886,  167772,       0,  83886, -83886,  167772,   83886 },
+};
+
+static const int ycc[9] = { 8192, 799, 1681, 8192, -933, 1091, 8192, 267, -5545 };
+/* Asymmetric, so that a transposed matrix product shows up. */
+static const int lms[9] = { 17081, -349, -349, -200, 16900, -316, -400, -300, 17084 };
+
+#define COMP_TOL 1e-5f
+#define RGB_TOL  2e-4f
+
+static void set_poly(AVDOVIReshapingCurve *c, int i, int order,
+                     int64_t c0, int64_t c1, int64_t c2)
+{
+    c->mapping_idc[i] = AV_DOVI_MAPPING_POLYNOMIAL;
+    c->poly_order[i]  = order;
+    c->poly_coef[i][0] = c0;
+    c->poly_coef[i][1] = c1;
+    c->poly_coef[i][2] = c2;
+}
+
+static void fill(AVDOVIMetadata *md)
+{
+    AVDOVIRpuDataHeader *hdr  = av_dovi_get_header(md);
+    AVDOVIDataMapping *map    = av_dovi_get_mapping(md);
+    AVDOVIColorMetadata *col  = av_dovi_get_color(md);
+    AVDOVIReshapingCurve *y   = &map->curves[0];
+    AVDOVIReshapingCurve *cb  = &map->curves[1];
+    AVDOVIReshapingCurve *cr  = &map->curves[2];
+
+    hdr->disable_residual_flag = 1;
+    hdr->bl_bit_depth = 10;
+    hdr->coef_log2_denom = 23;
+
+    /* Two polynomial pieces; the second is linear, so its x^2 term is unused. */
+    y->num_pivots = 3;
+    y->pivots[1] = 400;
+    y->pivots[2] = 1023;
+    set_poly(y, 0, 2, 83886, 7549747, 419430);
+    set_poly(y, 1, 1, 41943, 8388608, 1000);
+
+    cb->num_pivots = 2;
+    cb->pivots[1] = 1023;
+    cb->mapping_idc[0] = AV_DOVI_MAPPING_MMR;
+    cb->mmr_order[0] = 3;
+    cb->mmr_constant[0] = -838861;
+    memcpy(cb->mmr_coef[0], cb_mmr, sizeof(cb_mmr));
+
+    /* 1.5 * x, clamped to the outer pivots */
+    cr->num_pivots = 2;
+    cr->pivots[0] = 64;
+    cr->pivots[1] = 960;
+    set_poly(cr, 0, 1, 0, 12582912, 0);
+
+    for (int i = 0; i < 9; i++) {
+        col->ycc_to_rgb_matrix[i] = av_make_q(ycc[i], 1 << 13);
+        col->rgb_to_lms_matrix[i] = av_make_q(lms[i], 1 << 14);
+    }
+    col->ycc_to_rgb_offset[0] = av_make_q(0, 1);
+    col->ycc_to_rgb_offset[1] = av_make_q(1, 2);
+    col->ycc_to_rgb_offset[2] = av_make_q(1, 2);
+    col->source_min_pq = 62;
+    col->source_max_pq = 3696;
+}
+
+static int near(const float *got, const float *want, float tol)
+{
+    for (int i = 0; i < 3; i++)
+        if (!(fabsf(got[i] - want[i]) <= tol))
+            return 0;
+    return 1;
+}
+
+static int check_cases(const FFDoviReshape *s)
+{
+    int fails = 0;
+
+    for (size_t n = 0; n < FF_ARRAY_ELEMS(cases); n++) {
+        float comp[3], rgb[3];
+        for (int c = 0; c < 3; c++)
+            comp[c] = ff_dovi_reshape_comp(&s->curve[c], cases[n].in, c);
+        ff_dovi_reshape_pixel(s, cases[n].in, rgb);
+        printf("case %zu: reshape %s, decode %s\n", n,
+               near(comp, cases[n].comp, COMP_TOL) ? "ok" : "WRONG",
+               near(rgb, cases[n].rgb, RGB_TOL) ? "ok" : "WRONG");
+        fails += !near(comp, cases[n].comp, COMP_TOL) + !near(rgb, cases[n].rgb, RGB_TOL);
+    }
+    return fails;
+}
+
+/* A sample exactly on an inner pivot takes the upper piece: 0.005 + x. */
+static int check_pivot(const FFDoviReshape *s)
+{
+    float sig[3] = { s->curve[0].pivots[1], 0.5f, 0.5f };
+    float got = ff_dovi_reshape_comp(&s->curve[0], sig, 0);
+    int ok = fabsf(got - (0.005f + sig[0])) <= COMP_TOL;
+
+    printf("inner pivot takes the upper piece: %s\n", ok ? "ok" : "WRONG");
+    return !ok;
+}
+
+/* The planted error: one MMR weight off by 0.01 must miss the expected colour. */
+static int check_planted(AVDOVIMetadata *md)
+{
+    FFDoviReshape s;
+    float rgb[3];
+    int detected;
+
+    av_dovi_get_mapping(md)->curves[1].mmr_coef[0][0][1] += 83886;
+    ff_dovi_reshape_init(&s, md);
+    ff_dovi_reshape_pixel(&s, cases[3].in, rgb);
+    detected = !near(rgb, cases[3].rgb, RGB_TOL);
+    av_dovi_get_mapping(md)->curves[1].mmr_coef[0][0][1] -= 83886;
+    printf("planted wrong coefficient: %s\n", detected ? "detected" : "MISSED");
+    return !detected;
+}
+
+static int expect_refusal(AVDOVIMetadata *md, const char *what, int want)
+{
+    FFDoviReshape s;
+    int ret = ff_dovi_reshape_init(&s, md);
+
+    printf("%s: %s\n", what, ret == want ? "refused" : "ACCEPTED");
+    return ret != want;
+}
+
+static int check_refusals(AVDOVIMetadata *md)
+{
+    AVDOVIRpuDataHeader *hdr = av_dovi_get_header(md);
+    AVDOVIReshapingCurve *y  = &av_dovi_get_mapping(md)->curves[0];
+    int fails = 0;
+
+    fails += expect_refusal(NULL, "no metadata", AVERROR(EINVAL));
+    hdr->disable_residual_flag = 0;
+    fails += expect_refusal(md, "residual enhancement layer", AVERROR(ENOTSUP));
+    hdr->disable_residual_flag = 1;
+    y->num_pivots = 1;
+    fails += expect_refusal(md, "single pivot", AVERROR_INVALIDDATA);
+    y->num_pivots = 3;
+    y->pivots[1] = 1023;
+    y->pivots[2] = 400;
+    fails += expect_refusal(md, "descending pivots", AVERROR_INVALIDDATA);
+    y->pivots[1] = 400;
+    y->pivots[2] = 1023;
+    y->poly_order[0] = 3;
+    fails += expect_refusal(md, "polynomial order 3", AVERROR_INVALIDDATA);
+    y->poly_order[0] = 2;
+    return fails;
+}
+
+int main(void)
+{
+    AVDOVIMetadata *md = av_dovi_metadata_alloc(NULL);
+    FFDoviReshape s;
+    int ret, fails = 0;
+
+    if (!md)
+        return 1;
+    fill(md);
+
+    ret = ff_dovi_reshape_init(&s, md);
+    printf("init: %s\n", ret < 0 ? av_err2str(ret) : "ok");
+    if (ret < 0) {
+        av_free(md);
+        return 1;
+    }
+
+    fails += check_cases(&s);
+    fails += check_pivot(&s);
+    fails += check_planted(md);
+    fails += check_refusals(md);
+
+    av_free(md);
+    return fails != 0;
+}
