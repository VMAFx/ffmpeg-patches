 libavfilter/Makefile               |   2 +-
 libavfilter/dovi_reshape.c         | 201 ++++++++++++++++++++++++++
 libavfilter/dovi_reshape.h         |  81 +++++++++++
 libavfilter/tests/dovi_reshape.c   | 221 +++++++++++++++++++++++++++++
 tests/fate/filter-video.mak        |   4 +
 tests/ref/fate/filter-dovi-reshape |  12 ++
 6 files changed, 520 insertions(+), 1 deletion(-)
 create mode 100644 libavfilter/dovi_reshape.c
 create mode 100644 libavfilter/dovi_reshape.h
