diff --git a/libavfilter/dovi_reshape.c b/libavfilter/dovi_reshape.c
new file mode 100644
index 0000000000000000000000000000000000000000..cb6faa138357736519201eebad3e333106ebff00
--- /dev/null
+++ b/libavfilter/dovi_reshape.c
@@ -0,0 +1,201 @@
+/*
+ * Dolby Vision profile 5 reshaping and IPT-PQ-C2 decoding
+ *
+ * The reshaping and decoding steps follow libplacebo v7.360.1
+ * (src/shaders/colorspace.c: pl_shader_dovi_reshape, pl_shader_decode_color;
+ * src/include/libplacebo/utils/libav_internal.h: pl_map_dovi_metadata),
+ * Copyright (C) Niklas Haas and the libplacebo contributors, licensed under
+ * the GNU Lesser General Public License version 2.1 or later.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <math.h>
+#include <string.h>
+
+#include "libavutil/common.h"
+#include "libavutil/csp.h"
+#include "libavutil/error.h"
+#include "libavutil/rational.h"
+
+#include "dovi_reshape.h"
+
+/* Dolby Vision always outputs BT.2020-referred Hunt-Pointer-Estevez LMS. */
+static const double hpe_lms_to_rgb[3][3] = {
+    {  3.06441879, -2.16597676,  0.10155818 },
+    { -0.65612108,  1.78554118, -0.12943749 },
+    {  0.01736321, -0.04725154,  1.03004253 },
+};
+
+static int map_curve(FFDoviCurve *dst, const AVDOVIReshapingCurve *src,
+                     int bl_bit_depth, int coef_log2_denom)
+{
+    const double pivot_scale = 1.0 / ((1 << bl_bit_depth) - 1);
+    const double coef_scale  = ldexp(1.0, -coef_log2_denom);
+
+    if (src->num_pivots < 2 || src->num_pivots > AV_DOVI_MAX_PIECES + 1)
+        return AVERROR_INVALIDDATA;
+
+    dst->num_pivots = src->num_pivots;
+    for (int i = 0; i < src->num_pivots; i++) {
+        if (i && src->pivots[i] < src->pivots[i - 1])
+            return AVERROR_INVALIDDATA;
+        dst->pivots[i] = pivot_scale * src->pivots[i];
+    }
+
+    for (int i = 0; i < src->num_pivots - 1; i++) {
+        dst->method[i] = src->mapping_idc[i];
+        switch (src->mapping_idc[i]) {
+        case AV_DOVI_MAPPING_POLYNOMIAL:
+            if (src->poly_order[i] < 1 || src->poly_order[i] > 2)
+                return AVERROR_INVALIDDATA;
+            for (int k = 0; k < 3; k++)
+                dst->poly[i][k] = k <= src->poly_order[i]
+                                ? coef_scale * src->poly_coef[i][k] : 0.0f;
+            break;
+        case AV_DOVI_MAPPING_MMR:
+            if (src->mmr_order[i] < 1 || src->mmr_order[i] > 3)
+                return AVERROR_INVALIDDATA;
+            dst->mmr_order[i]    = src->mmr_order[i];
+            dst->mmr_constant[i] = coef_scale * src->mmr_constant[i];
+            for (int j = 0; j < src->mmr_order[i]; j++)
+                for (int k = 0; k < 7; k++)
+                    dst->mmr[i][j][k] = coef_scale * src->mmr_coef[i][j][k];
+            break;
+        default:
+            return AVERROR_INVALIDDATA;
+        }
+    }
+    return 0;
+}
+
+static void map_color(FFDoviReshape *out, const AVDOVIColorMetadata *color)
+{
+    double lms[3][3];
+
+    for (int i = 0; i < 3; i++) {
+        out->ycc_offset[i] = av_q2d(color->ycc_to_rgb_offset[i]);
+        for (int j = 0; j < 3; j++) {
+            out->ycc_to_rgb[i][j] = av_q2d(color->ycc_to_rgb_matrix[3 * i + j]);
+            lms[i][j] = av_q2d(color->rgb_to_lms_matrix[3 * i + j]);
+        }
+    }
+
+    /* lms_to_rgb = hpe_lms_to_rgb * rgb_to_lms_matrix */
+    for (int i = 0; i < 3; i++)
+        for (int j = 0; j < 3; j++)
+            out->lms_to_rgb[i][j] = hpe_lms_to_rgb[i][0] * lms[0][j] +
+                                    hpe_lms_to_rgb[i][1] * lms[1][j] +
+                                    hpe_lms_to_rgb[i][2] * lms[2][j];
+
+    out->min_pq = color->source_min_pq / 4095.0f;
+    out->max_pq = color->source_max_pq / 4095.0f;
+}
+
+int ff_dovi_reshape_init(FFDoviReshape *out, const AVDOVIMetadata *md)
+{
+    const AVDOVIRpuDataHeader *header;
+    const AVDOVIDataMapping *mapping;
+    int ret;
+
+    memset(out, 0, sizeof(*out));
+    if (!md)
+        return AVERROR(EINVAL);
+
+    header  = av_dovi_get_header(md);
+    mapping = av_dovi_get_mapping(md);
+    if (!header->disable_residual_flag)
+        return AVERROR(ENOTSUP);
+    if (header->bl_bit_depth < 8 || header->bl_bit_depth > 16 ||
+        header->coef_log2_denom > 32)
+        return AVERROR_INVALIDDATA;
+
+    for (int c = 0; c < 3; c++) {
+        ret = map_curve(&out->curve[c], &mapping->curves[c],
+                        header->bl_bit_depth, header->coef_log2_denom);
+        if (ret < 0)
+            return ret;
+    }
+
+    map_color(out, av_dovi_get_color(md));
+    return 0;
+}
+
+static float reshape_mmr(const FFDoviCurve *curve, int i, const float sig[3])
+{
+    const float x[7] = {
+        sig[0], sig[1], sig[2],
+        sig[0] * sig[1], sig[0] * sig[2], sig[1] * sig[2],
+        sig[0] * sig[1] * sig[2],
+    };
+    float pow_x[7], s = curve->mmr_constant[i];
+
+    memcpy(pow_x, x, sizeof(pow_x));
+    for (int j = 0; j < curve->mmr_order[i]; j++) {
+        for (int k = 0; k < 7; k++)
+            s += curve->mmr[i][j][k] * pow_x[k];
+        for (int k = 0; k < 7; k++)
+            pow_x[k] *= x[k];
+    }
+    return s;
+}
+
+float ff_dovi_reshape_comp(const FFDoviCurve *curve, const float sig[3], int c)
+{
+    float s = sig[c];
+    int i = 0;
+
+    if (!curve->num_pivots)
+        return s;
+
+    /* The outer pivots only bound the output; the inner ones pick the piece. */
+    while (i < curve->num_pivots - 2 && s >= curve->pivots[i + 1])
+        i++;
+
+    if (curve->method[i] == AV_DOVI_MAPPING_POLYNOMIAL) {
+        const float *k = curve->poly[i];
+        s = (k[2] * s + k[1]) * s + k[0];
+    } else {
+        s = reshape_mmr(curve, i, sig);
+    }
+    return av_clipf(s, curve->pivots[0], curve->pivots[curve->num_pivots - 1]);
+}
+
+static void mul3(const float m[3][3], const float in[3], float out[3])
+{
+    for (int i = 0; i < 3; i++)
+        out[i] = m[i][0] * in[0] + m[i][1] * in[1] + m[i][2] * in[2];
+}
+
+void ff_dovi_reshape_pixel(const FFDoviReshape *s, const float ycc[3], float rgb[3])
+{
+    const av_csp_trc_function pq_eotf = av_csp_trc_func_inv_from_id(AVCOL_TRC_SMPTE2084);
+    const av_csp_trc_function pq_oetf = av_csp_trc_func_from_id(AVCOL_TRC_SMPTE2084);
+    float sig[3], ipt[3], lms[3];
+
+    for (int c = 0; c < 3; c++)
+        sig[c] = av_clipf(ycc[c], 0.0f, 1.0f);
+    for (int c = 0; c < 3; c++)
+        ipt[c] = ff_dovi_reshape_comp(&s->curve[c], sig, c) - s->ycc_offset[c];
+
+    mul3(s->ycc_to_rgb, ipt, lms);
+    for (int c = 0; c < 3; c++)
+        lms[c] = pq_eotf(FFMAX(lms[c], 0.0f));
+    mul3(s->lms_to_rgb, lms, rgb);
+    for (int c = 0; c < 3; c++)
+        rgb[c] = pq_oetf(rgb[c]);
+}
diff --git a/libavfilter/dovi_reshape.h b/libavfilter/dovi_reshape.h
new file mode 100644
index 0000000000000000000000000000000000000000..f5e2543129f94225f5f9059006368aad1ce0d6a7
--- /dev/null
+++ b/libavfilter/dovi_reshape.h
@@ -0,0 +1,81 @@
+/*
+ * Dolby Vision profile 5 reshaping and IPT-PQ-C2 decoding
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
