+/**
+ * @file
+ * Apply the Dolby Vision RPU reshaping of each frame and decode the result to
+ * PQ BT.2020 RGB, so that zscale and tonemap can process profile 5 content.
+ */
+
+#include <math.h>
+
+#include "libavutil/csp.h"
+#include "libavutil/dict.h"
+#include "libavutil/dovi_meta.h"
+#include "libavutil/frame.h"
+#include "libavutil/mastering_display_metadata.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+
+#include "avfilter.h"
+#include "dovi_reshape.h"
+#include "filters.h"
+#include "formats.h"
+#include "video.h"
+
+/* Bilinear taps from the luma grid into one chroma plane, per axis. */
+typedef struct ChromaTaps {
+    int   *i0, *i1;
+    float *w;
+} ChromaTaps;
+
+typedef struct DoviReshapeContext {
+    const AVClass *class;
+    const AVPixFmtDescriptor *desc;
+    float norm;
+    int loc;                 ///< chroma location the taps were built for, or -1
+    ChromaTaps tx, ty;
+} DoviReshapeContext;
+
+typedef struct ThreadData {
+    const FFDoviReshape *rs;
+    const AVFrame *in;
+    AVFrame *out;
+} ThreadData;
+
+static const enum AVPixelFormat in_fmts[] = {
+    AV_PIX_FMT_YUV420P,   AV_PIX_FMT_YUV422P,   AV_PIX_FMT_YUV444P,
+    AV_PIX_FMT_YUV420P10, AV_PIX_FMT_YUV422P10, AV_PIX_FMT_YUV444P10,
+    AV_PIX_FMT_YUV420P12, AV_PIX_FMT_YUV422P12, AV_PIX_FMT_YUV444P12,
+    AV_PIX_FMT_NONE,
+};
+
+static int query_formats(const AVFilterContext *ctx,
+                         AVFilterFormatsConfig **cfg_in,
+                         AVFilterFormatsConfig **cfg_out)
+{
+    int ret;
+
+    ret = ff_formats_ref(ff_make_pixel_format_list(in_fmts), &cfg_in[0]->formats);
+    if (ret < 0)
+        return ret;
+    ret = ff_formats_ref(ff_make_formats_list_singleton(AV_PIX_FMT_GBRPF32),
+                         &cfg_out[0]->formats);
+    if (ret < 0)
+        return ret;
+    ret = ff_formats_ref(ff_all_color_spaces(), &cfg_in[0]->color_spaces);
+    if (ret < 0)
+        return ret;
+    ret = ff_formats_ref(ff_make_formats_list_singleton(AVCOL_SPC_RGB),
+                         &cfg_out[0]->color_spaces);
+    if (ret < 0)
+        return ret;
+    ret = ff_formats_ref(ff_all_color_ranges(), &cfg_in[0]->color_ranges);
+    if (ret < 0)
+        return ret;
+    return ff_formats_ref(ff_make_formats_list_singleton(AVCOL_RANGE_JPEG),
+                          &cfg_out[0]->color_ranges);
+}
+
+/* Chroma sample c sits at luma position (c << shift) + offset. */
+static int init_taps(ChromaTaps *t, int len, int shift, float offset, int clen)
+{
+    t->i0 = av_malloc_array(len, sizeof(*t->i0));
+    t->i1 = av_malloc_array(len, sizeof(*t->i1));
+    t->w  = av_malloc_array(len, sizeof(*t->w));
+    if (!t->i0 || !t->i1 || !t->w)
+        return AVERROR(ENOMEM);
+
+    for (int x = 0; x < len; x++) {
+        float pos = av_clipf((x - offset) / (1 << shift), 0.0f, clen - 1);
+        int i = FFMIN((int)pos, clen - 1);
+        t->i0[x] = i;
+        t->i1[x] = FFMIN(i + 1, clen - 1);
+        t->w[x]  = pos - i;
+    }
+    return 0;
+}
+
+static void free_taps(ChromaTaps *t)
+{
+    av_freep(&t->i0);
+    av_freep(&t->i1);
+    av_freep(&t->w);
+}
+
+static int config_input(AVFilterLink *inlink)
+{
+    DoviReshapeContext *s = inlink->dst->priv;
+
+    s->desc = av_pix_fmt_desc_get(inlink->format);
+    s->norm = 1.0f / ((1 << s->desc->comp[0].depth) - 1);
+    s->loc  = -1;
+    return 0;
+}
+
+/* Chroma siting is a frame property, so the taps follow the frame. */
+static int update_taps(DoviReshapeContext *s, const AVFrame *in)
+{
+    const AVPixFmtDescriptor *desc = s->desc;
+    enum AVChromaLocation loc = in->chroma_location;
+    int cw = AV_CEIL_RSHIFT(in->width,  desc->log2_chroma_w);
+    int ch = AV_CEIL_RSHIFT(in->height, desc->log2_chroma_h);
+    int xpos = 0, ypos = 0, ret;
+
+    if (loc == AVCHROMA_LOC_UNSPECIFIED)
+        loc = AVCHROMA_LOC_LEFT;
+    if ((int)loc == s->loc)
+        return 0;
+
+    if (desc->log2_chroma_w || desc->log2_chroma_h)
+        av_chroma_location_enum_to_pos(&xpos, &ypos, loc);
+    free_taps(&s->tx);
+    free_taps(&s->ty);
+    s->loc = -1;
+    ret = init_taps(&s->tx, in->width, desc->log2_chroma_w,
+                    desc->log2_chroma_w ? xpos / 256.0f : 0.0f, cw);
+    if (ret >= 0)
+        ret = init_taps(&s->ty, in->height, desc->log2_chroma_h,
+                        desc->log2_chroma_h ? ypos / 256.0f : 0.0f, ch);
+    if (ret >= 0)
+        s->loc = loc;
+    return ret;
+}
+
+static av_always_inline float sample(const uint8_t *row, int x, int hbd)
+{
+    return hbd ? ((const uint16_t *)row)[x] : row[x];
+}
+
+static float chroma(const AVFrame *in, int p, const DoviReshapeContext *s,
+                    int x, int y, int hbd)
+{
+    const ChromaTaps *tx = &s->tx, *ty = &s->ty;
+    const uint8_t *r0 = in->data[p] + ty->i0[y] * in->linesize[p];
+    const uint8_t *r1 = in->data[p] + ty->i1[y] * in->linesize[p];
+    float top = sample(r0, tx->i0[x], hbd) * (1.0f - tx->w[x]) +
+                sample(r0, tx->i1[x], hbd) * tx->w[x];
+    float bot = sample(r1, tx->i0[x], hbd) * (1.0f - tx->w[x]) +
+                sample(r1, tx->i1[x], hbd) * tx->w[x];
+
+    return (top + (bot - top) * ty->w[y]) * s->norm;
+}
+
+static int reshape_slice(AVFilterContext *ctx, void *arg, int jobnr, int nb_jobs)
+{
+    const DoviReshapeContext *s = ctx->priv;
+    const ThreadData *td = arg;
+    const AVFrame *in = td->in;
+    AVFrame *out = td->out;
+    const int hbd = s->desc->comp[0].depth > 8;
+    const int y0 = in->height * jobnr / nb_jobs;
+    const int y1 = in->height * (jobnr + 1) / nb_jobs;
+
+    for (int y = y0; y < y1; y++) {
+        const uint8_t *luma = in->data[0] + y * in->linesize[0];
+        float *g = (float *)(out->data[0] + y * out->linesize[0]);
+        float *b = (float *)(out->data[1] + y * out->linesize[1]);
+        float *r = (float *)(out->data[2] + y * out->linesize[2]);
+
+        for (int x = 0; x < in->width; x++) {
+            float ycc[3], rgb[3];
+            ycc[0] = sample(luma, x, hbd) * s->norm;
+            ycc[1] = chroma(in, 1, s, x, y, hbd);
+            ycc[2] = chroma(in, 2, s, x, y, hbd);
+            ff_dovi_reshape_pixel(td->rs, ycc, rgb);
+            r[x] = rgb[0];
+            g[x] = rgb[1];
+            b[x] = rgb[2];
+        }
+    }
+    return 0;
+}
+
+/*
+ * The level 1 block carries the per-shot luminance range. Tone mappers that
+ * read only static metadata (ff_determine_signal_peak) see it as the content
+ * light level of the frame, as libplacebo does with max_pq_y and avg_pq_y.
+ */
+static int set_light_level(AVFrame *out, av_csp_trc_function pq_eotf)
+{
+    const AVFrameSideData *sd = av_frame_get_side_data(out, AV_FRAME_DATA_DOVI_METADATA);
+    const AVDOVIDmData *l1 = sd ? av_dovi_find_level((const AVDOVIMetadata *)sd->data, 1) : NULL;
+    AVContentLightMetadata *clm;
+    int ret;
+
+    av_frame_remove_side_data(out, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    if (!l1) {
+        av_dict_set(&out->metadata, "lavfi.dovi.l1_max_pq", NULL, 0);
+        av_dict_set(&out->metadata, "lavfi.dovi.l1_avg_pq", NULL, 0);
+        return 0;
+    }
+    clm = av_content_light_metadata_create_side_data(out);
+    if (!clm)
+        return AVERROR(ENOMEM);
+    clm->MaxCLL  = lrint(pq_eotf(l1->l1.max_pq / 4095.0));
+    clm->MaxFALL = lrint(pq_eotf(l1->l1.avg_pq / 4095.0));
+
+    ret = av_dict_set_int(&out->metadata, "lavfi.dovi.l1_max_pq", l1->l1.max_pq, 0);
+    if (ret < 0)
+        return ret;
+    return av_dict_set_int(&out->metadata, "lavfi.dovi.l1_avg_pq", l1->l1.avg_pq, 0);
+}
+
+/* The reshaped signal is described by the RPU, not by the base layer. */
+static int set_output_props(AVFrame *out, const FFDoviReshape *rs)
+{
+    const av_csp_trc_function pq_eotf = av_csp_trc_func_inv_from_id(AVCOL_TRC_SMPTE2084);
+    const AVColorPrimariesDesc *bt2020 = av_csp_primaries_desc_from_id(AVCOL_PRI_BT2020);
+    AVMasteringDisplayMetadata *mdm;
+    int ret = set_light_level(out, pq_eotf);
+
+    if (ret < 0)
+        return ret;
+    av_frame_remove_side_data(out, AV_FRAME_DATA_DOVI_METADATA);
+    av_frame_remove_side_data(out, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+    av_frame_remove_side_data(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+
+    out->color_primaries = AVCOL_PRI_BT2020;
+    out->color_trc       = AVCOL_TRC_SMPTE2084;
+    out->colorspace      = AVCOL_SPC_RGB;
+    out->color_range     = AVCOL_RANGE_JPEG;
+
+    mdm = av_mastering_display_metadata_create_side_data(out);
+    if (!mdm)
+        return AVERROR(ENOMEM);
+    mdm->display_primaries[0][0] = bt2020->prim.r.x;
+    mdm->display_primaries[0][1] = bt2020->prim.r.y;
+    mdm->display_primaries[1][0] = bt2020->prim.g.x;
+    mdm->display_primaries[1][1] = bt2020->prim.g.y;
+    mdm->display_primaries[2][0] = bt2020->prim.b.x;
+    mdm->display_primaries[2][1] = bt2020->prim.b.y;
+    mdm->white_point[0] = bt2020->wp.x;
+    mdm->white_point[1] = bt2020->wp.y;
+    mdm->min_luminance = av_d2q(pq_eotf(rs->min_pq), 1 << 16);
+    mdm->max_luminance = av_d2q(pq_eotf(rs->max_pq), 1 << 16);
+    mdm->has_primaries = 1;
+    mdm->has_luminance = 1;
+    return 0;
+}
+
+static int check_input(AVFilterContext *ctx, const AVFrame *in, FFDoviReshape *rs)
+{
+    const AVFrameSideData *sd = av_frame_get_side_data(in, AV_FRAME_DATA_DOVI_METADATA);
+    int ret;
+
+    if (!sd) {
+        av_log(ctx, AV_LOG_ERROR, "Frame carries no Dolby Vision metadata\n");
+        return AVERROR(EINVAL);
+    }
+    if (in->color_range == AVCOL_RANGE_MPEG) {
+        av_log(ctx, AV_LOG_ERROR, "Limited range base layers are not supported\n");
+        return AVERROR(ENOTSUP);
+    }
+    ret = ff_dovi_reshape_init(rs, (const AVDOVIMetadata *)sd->data);
+    if (ret == AVERROR(ENOTSUP))
+        av_log(ctx, AV_LOG_ERROR, "The RPU signals a residual enhancement "
+               "layer; only single-layer streams such as profile 5 are supported\n");
+    else if (ret < 0)
+        av_log(ctx, AV_LOG_ERROR, "Invalid Dolby Vision reshaping metadata\n");
+    return ret;
+}
+
+static int filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *ctx  = inlink->dst;
+    AVFilterLink *outlink = ctx->outputs[0];
+    FFDoviReshape rs;
+    ThreadData td;
+    AVFrame *out;
+    int ret;
+
+    ret = check_input(ctx, in, &rs);
+    if (ret >= 0)
+        ret = update_taps(ctx->priv, in);
+    if (ret < 0) {
+        av_frame_free(&in);
+        return ret;
+    }
+
+    out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!out) {
+        av_frame_free(&in);
+        return AVERROR(ENOMEM);
+    }
+    ret = av_frame_copy_props(out, in);
+    if (ret >= 0)
+        ret = set_output_props(out, &rs);
+    if (ret < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return ret;
+    }
+
+    td = (ThreadData) { .rs = &rs, .in = in, .out = out };
+    ff_filter_execute(ctx, reshape_slice, &td, NULL,
+                      FFMIN(in->height, ff_filter_get_nb_threads(ctx)));
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+}
+
+static av_cold void uninit(AVFilterContext *ctx)
+{
+    DoviReshapeContext *s = ctx->priv;
+
+    free_taps(&s->tx);
+    free_taps(&s->ty);
+}
+
+static const AVClass dovi_reshape_class = {
+    .class_name = "dovi_reshape",
+    .item_name  = av_default_item_name,
+    .version    = LIBAVUTIL_VERSION_INT,
+    .category   = AV_CLASS_CATEGORY_FILTER,
+};
+
+static const AVFilterPad dovi_reshape_inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = filter_frame,
+        .config_props = config_input,
+    },
+};
+
+const FFFilter ff_vf_dovi_reshape = {
+    .p.name        = "dovi_reshape",
+    .p.description = NULL_IF_CONFIG_SMALL("Apply Dolby Vision reshaping and output PQ BT.2020 RGB."),
+    .p.priv_class  = &dovi_reshape_class,
+    .p.flags       = AVFILTER_FLAG_SLICE_THREADS,
+    .priv_size     = sizeof(DoviReshapeContext),
+    .uninit        = uninit,
+    FILTER_INPUTS(dovi_reshape_inputs),
+    FILTER_OUTPUTS(ff_video_default_filterpad),
+    FILTER_QUERY_FUNC2(query_formats),
+};
