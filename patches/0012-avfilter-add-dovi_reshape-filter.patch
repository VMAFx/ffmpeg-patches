--- a/libavfilter/tests/dovi_reshape.c
+++ b/libavfilter/tests/dovi_reshape.c
@@ -18,11 +18,22 @@
 
 #include <math.h>
 #include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
 
+#include "libavutil/csp.h"
+#include "libavutil/dict.h"
 #include "libavutil/dovi_meta.h"
 #include "libavutil/error.h"
+#include "libavutil/frame.h"
+#include "libavutil/log.h"
+#include "libavutil/mastering_display_metadata.h"
 #include "libavutil/mem.h"
 
+#include "libavfilter/avfilter.h"
+#include "libavfilter/buffersink.h"
+#include "libavfilter/buffersrc.h"
+
 #include "libavfilter/dovi_reshape.c"
 
 /*
@@ -194,15 +205,218 @@ static int check_refusals(AVDOVIMetadata *md)
     return fails;
 }
 
-int main(void)
+/*
+ * The filter, run in a graph on a 16x8 yuv420p10 frame. Chroma is a
+ * horizontal ramp that is constant down each column, so bilinear upsampling
+ * is exact and the expected colour of every pixel follows from the siting.
+ */
+#define FW 16
+#define FH 8
+#define L1_MAX_PQ 2081
+#define L1_AVG_PQ 1400
+#define FILTER_TOL 1e-4f
+
+static int luma_at(int x, int y)  { return 100 + 55 * x + 7 * y; }
+static float cb_at(float c)       { return 300 + 40 * c; }
+static float cr_at(float c)       { return 700 - 30 * c; }
+
+static AVFrame *make_frame(const AVDOVIMetadata *md, size_t md_size,
+                           enum AVChromaLocation loc, enum AVColorRange range)
+{
+    AVFrame *f = av_frame_alloc();
+    AVFrameSideData *sd = NULL;
+
+    if (!f)
+        return NULL;
+    f->format = AV_PIX_FMT_YUV420P10;
+    f->width  = FW;
+    f->height = FH;
+    f->color_range = range;
+    f->chroma_location = loc;
+    if (av_frame_get_buffer(f, 0) >= 0)
+        sd = av_frame_new_side_data(f, AV_FRAME_DATA_DOVI_METADATA, md_size);
+    if (!sd) {
+        av_frame_free(&f);
+        return NULL;
+    }
+    memcpy(sd->data, md, md_size);
+    for (int y = 0; y < FH; y++) {
+        uint16_t *row = (uint16_t *)(f->data[0] + y * f->linesize[0]);
+        for (int x = 0; x < FW; x++)
+            row[x] = luma_at(x, y);
+    }
+    for (int y = 0; y < FH / 2; y++) {
+        uint16_t *cb = (uint16_t *)(f->data[1] + y * f->linesize[1]);
+        uint16_t *cr = (uint16_t *)(f->data[2] + y * f->linesize[2]);
+        for (int c = 0; c < FW / 2; c++) {
+            cb[c] = cb_at(c);
+            cr[c] = cr_at(c);
+        }
+    }
+    return f;
+}
+
+/* Runs buffer -> dovi_reshape -> buffersink on one frame. */
+static int run_filter(AVFrame *in, AVFrame *out)
 {
-    AVDOVIMetadata *md = av_dovi_metadata_alloc(NULL);
+    AVFilterGraph *g = avfilter_graph_alloc();
+    AVFilterContext *src = NULL, *dr = NULL, *sink = NULL;
+    char args[128];
+    int ret;
+
+    if (!g)
+        return AVERROR(ENOMEM);
+    snprintf(args, sizeof(args), "video_size=%dx%d:pix_fmt=%d:time_base=1/25:range=%d",
+             in->width, in->height, in->format, in->color_range);
+    ret = avfilter_graph_create_filter(&src, avfilter_get_by_name("buffer"), "in", args, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_graph_create_filter(&dr, avfilter_get_by_name("dovi_reshape"), "dr", NULL, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_graph_create_filter(&sink, avfilter_get_by_name("buffersink"), "out", NULL, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_link(src, 0, dr, 0);
+    if (ret >= 0)
+        ret = avfilter_link(dr, 0, sink, 0);
+    if (ret >= 0)
+        ret = avfilter_graph_config(g, NULL);
+    if (ret >= 0)
+        ret = av_buffersrc_add_frame_flags(src, in, AV_BUFFERSRC_FLAG_KEEP_REF);
+    if (ret >= 0)
+        ret = av_buffersrc_add_frame(src, NULL);
+    if (ret >= 0)
+        ret = av_buffersink_get_frame(sink, out);
+    avfilter_graph_free(&g);
+    return ret;
+}
+
+/* Expected output for left (co-sited) horizontal chroma siting. */
+static int pixels_match(const FFDoviReshape *s, const AVFrame *out)
+{
+    for (int y = 0; y < FH; y++) {
+        for (int x = 0; x < FW; x++) {
+            float c = FFMIN(x / 2.0f, FW / 2 - 1), ycc[3], rgb[3], got[3];
+            ycc[0] = luma_at(x, y) / 1023.0f;
+            ycc[1] = cb_at(c) / 1023.0f;
+            ycc[2] = cr_at(c) / 1023.0f;
+            ff_dovi_reshape_pixel(s, ycc, rgb);
+            got[0] = ((const float *)(out->data[2] + y * out->linesize[2]))[x];
+            got[1] = ((const float *)(out->data[0] + y * out->linesize[0]))[x];
+            got[2] = ((const float *)(out->data[1] + y * out->linesize[1]))[x];
+            if (!near(got, rgb, FILTER_TOL))
+                return 0;
+        }
+    }
+    return 1;
+}
+
+static int side_data_ok(const FFDoviReshape *s, const AVFrame *out)
+{
+    const av_csp_trc_function pq_eotf = av_csp_trc_func_inv_from_id(AVCOL_TRC_SMPTE2084);
+    const AVFrameSideData *mdm_sd = av_frame_get_side_data(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+    const AVFrameSideData *clm_sd = av_frame_get_side_data(out, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    const AVMasteringDisplayMetadata *mdm;
+    const AVContentLightMetadata *clm;
+    const AVDictionaryEntry *e_max, *e_avg;
+    char *end_max = NULL, *end_avg = NULL;
+    long max_pq, avg_pq;
+
+    if (av_frame_get_side_data(out, AV_FRAME_DATA_DOVI_METADATA) || !mdm_sd || !clm_sd)
+        return 0;
+
+    e_max = av_dict_get(out->metadata, "lavfi.dovi.l1_max_pq", NULL, 0);
+    e_avg = av_dict_get(out->metadata, "lavfi.dovi.l1_avg_pq", NULL, 0);
+    if (!e_max || !e_avg || !e_max->value || !e_avg->value)
+        return 0;
+
+    max_pq = strtol(e_max->value, &end_max, 10);
+    avg_pq = strtol(e_avg->value, &end_avg, 10);
+    if (*end_max || *end_avg || end_max == e_max->value || end_avg == e_avg->value)
+        return 0;
+    if (max_pq != L1_MAX_PQ || avg_pq != L1_AVG_PQ)
+        return 0;
+
+    mdm = (const AVMasteringDisplayMetadata *)mdm_sd->data;
+    clm = (const AVContentLightMetadata *)clm_sd->data;
+    return mdm->has_luminance &&
+           fabs(av_q2d(mdm->max_luminance) - pq_eotf(s->max_pq)) < 0.01 &&
+           fabs(av_q2d(mdm->min_luminance) - pq_eotf(s->min_pq)) < 0.01 &&
+           clm->MaxCLL  == lrint(pq_eotf(L1_MAX_PQ / 4095.0)) &&
+           clm->MaxFALL == lrint(pq_eotf(L1_AVG_PQ / 4095.0)) &&
+           out->format == AV_PIX_FMT_GBRPF32 && out->colorspace == AVCOL_SPC_RGB &&
+           out->color_trc == AVCOL_TRC_SMPTE2084 && out->color_primaries == AVCOL_PRI_BT2020 &&
+           out->color_range == AVCOL_RANGE_JPEG;
+}
+
+/* Returns 1 when the filter output matches the reference colours. */
+static int filter_matches(const FFDoviReshape *s, const AVDOVIMetadata *md, size_t md_size,
+                          enum AVChromaLocation loc, int *side_ok)
+{
+    AVFrame *in = make_frame(md, md_size, loc, AVCOL_RANGE_JPEG);
+    AVFrame *out = av_frame_alloc();
+    int ret = in && out ? run_filter(in, out) : AVERROR(ENOMEM);
+    int match = ret >= 0 && pixels_match(s, out);
+
+    if (side_ok)
+        *side_ok = ret >= 0 && side_data_ok(s, out);
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return ret < 0 ? ret : match;
+}
+
+static int check_filter(AVDOVIMetadata *md, size_t md_size)
+{
+    AVDOVIDmData *l1 = av_dovi_get_ext(md, 0);
+    AVFrame *in, *out;
+    FFDoviReshape s;
+    int ret, side_ok = 0, fails = 0;
+
+    md->num_ext_blocks = 1;
+    l1->level = 1;
+    l1->l1.max_pq = L1_MAX_PQ;
+    l1->l1.avg_pq = L1_AVG_PQ;
+    ff_dovi_reshape_init(&s, md);
+
+    ret = filter_matches(&s, md, md_size, AVCHROMA_LOC_UNSPECIFIED, &side_ok);
+    printf("pixels, unspecified siting read as left: %s\n", ret == 1 ? "ok" : "WRONG");
+    printf("side data: %s\n", side_ok ? "ok" : "WRONG");
+    fails += (ret != 1) + !side_ok;
+
+    ret = filter_matches(&s, md, md_size, AVCHROMA_LOC_CENTER, NULL);
+    printf("planted wrong chroma siting: %s\n", ret == 0 ? "detected" : "MISSED");
+    fails += ret != 0;
+
+    av_dovi_get_mapping(md)->curves[1].mmr_coef[0][0][1] += 83886;
+    ret = filter_matches(&s, md, md_size, AVCHROMA_LOC_LEFT, NULL);
+    av_dovi_get_mapping(md)->curves[1].mmr_coef[0][0][1] -= 83886;
+    printf("planted wrong coefficient in the frame: %s\n", ret == 0 ? "detected" : "MISSED");
+    fails += ret != 0;
+
+    in  = make_frame(md, md_size, AVCHROMA_LOC_LEFT, AVCOL_RANGE_MPEG);
+    out = av_frame_alloc();
+    ret = in && out ? run_filter(in, out) : AVERROR(ENOMEM);
+    printf("limited range: %s\n", ret == AVERROR(ENOTSUP) ? "refused" : "ACCEPTED");
+    fails += ret != AVERROR(ENOTSUP);
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return fails;
+}
+
+int main(int argc, char **argv)
+{
+    size_t md_size;
+    AVDOVIMetadata *md = av_dovi_metadata_alloc(&md_size);
     FFDoviReshape s;
     int ret, fails = 0;
 
     if (!md)
         return 1;
     fill(md);
+    if (argc > 1 && !strcmp(argv[1], "filter")) {
+        av_log_set_level(AV_LOG_QUIET);
+        fails = check_filter(md, md_size);
+        av_free(md);
+        return fails != 0;
+    }
 
     ret = ff_dovi_reshape_init(&s, md);
     printf("init: %s\n", ret < 0 ? av_err2str(ret) : "ok");
