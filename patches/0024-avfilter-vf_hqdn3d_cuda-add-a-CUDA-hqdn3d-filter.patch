+__device__ static inline unsigned int load_sample(unsigned int raw,
+                                                  unsigned int s_depth,
+                                                  unsigned int s_msb)
+{
+    unsigned int shift = 16u - s_depth;
+    unsigned int sample_val = (s_msb != 0u) ? (raw >> shift) : raw;
+    unsigned int rounding = (shift > 0u) ? (((1u << shift) - 1u) >> 1u) : 0u;
+    return (sample_val << shift) + rounding;
+}
+
+__device__ static inline unsigned int store_sample(unsigned int val,
+                                                   unsigned int s_depth,
+                                                   unsigned int s_msb)
+{
+    unsigned int shift = 16u - s_depth;
+    unsigned int stored = val >> shift;
+    if (s_msb != 0u) {
+        unsigned int max_val = (1u << s_depth) - 1u;
+        if (stored > max_val)
+            stored = max_val;
+        return stored << shift;
+    }
+    return stored;
+}
+
+__device__ static inline int lowpass(int prev_val, int cur_val,
+                                     const short *coef_tables,
+                                     unsigned int t_offset,
+                                     unsigned int l_bits)
+{
+    int d = (prev_val - cur_val) >> (8 - (int)l_bits);
+    int center = 256 << (int)l_bits;
+    int idx = (int)t_offset + center + d;
+    int coef = (int)coef_tables[idx];
+    return cur_val + coef;
+}
+
+template <typename T2>
+__device__ static inline T2 make_vec2(unsigned int u, unsigned int v);
+
+template <>
+__device__ inline uchar2 make_vec2<uchar2>(unsigned int u, unsigned int v)
+{
+    return make_uchar2((unsigned char)u, (unsigned char)v);
+}
+
+template <>
+__device__ inline ushort2 make_vec2<ushort2>(unsigned int u, unsigned int v)
+{
+    return make_ushort2((unsigned short)u, (unsigned short)v);
+}
+
+template <typename T>
+__device__ static void horizontal_planar_row(
+    const unsigned char *src, int src_pitch,
+    unsigned short *h_data, int h_offset,
+    const short *coef_tables, int spatial_offset,
+    int width, int y,
+    int depth, int lut_bits, int is_msb)
+{
+    const T *row = (const T *)(src + y * src_pitch);
+    int h_row_start = h_offset + y * width;
+    unsigned int raw0 = (unsigned int)row[0];
+    unsigned int pixel_ant = load_sample(raw0, depth, is_msb);
+
+    if (y == 0) {
+        for (int x = 0; x < width; x++) {
+            unsigned int raw = (unsigned int)row[x];
+            unsigned int cur = load_sample(raw, depth, is_msb);
+            pixel_ant = (unsigned int)lowpass((int)pixel_ant, (int)cur,
+                                              coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_start + x] = (unsigned short)pixel_ant;
+        }
+    } else {
+        h_data[h_row_start + 0] = (unsigned short)pixel_ant;
+        for (int x = 0; x + 1 < width; x++) {
+            unsigned int raw = (unsigned int)row[x + 1];
+            unsigned int cur = load_sample(raw, depth, is_msb);
+            pixel_ant = (unsigned int)lowpass((int)pixel_ant, (int)cur,
+                                              coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_start + x + 1] = (unsigned short)pixel_ant;
+        }
+    }
+}
+
+template <typename T2>
+__device__ static void horizontal_semiplanar_row(
+    const unsigned char *src, int src_pitch,
+    unsigned short *h_data, int h_offset_u, int h_offset_v,
+    const short *coef_tables, int spatial_offset,
+    int width, int y,
+    int depth, int lut_bits, int is_msb)
+{
+    const T2 *row = (const T2 *)(src + y * src_pitch);
+    int h_row_u = h_offset_u + y * width;
+    int h_row_v = h_offset_v + y * width;
+    T2 raw0 = row[0];
+    unsigned int pixel_ant_u = load_sample((unsigned int)raw0.x, depth, is_msb);
+    unsigned int pixel_ant_v = load_sample((unsigned int)raw0.y, depth, is_msb);
+
+    if (y == 0) {
+        for (int x = 0; x < width; x++) {
+            T2 raw = row[x];
+            unsigned int cur_u = load_sample((unsigned int)raw.x, depth, is_msb);
+            unsigned int cur_v = load_sample((unsigned int)raw.y, depth, is_msb);
+            pixel_ant_u = (unsigned int)lowpass((int)pixel_ant_u, (int)cur_u,
+                                                coef_tables, spatial_offset, lut_bits);
+            pixel_ant_v = (unsigned int)lowpass((int)pixel_ant_v, (int)cur_v,
+                                                coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_u + x] = (unsigned short)pixel_ant_u;
+            h_data[h_row_v + x] = (unsigned short)pixel_ant_v;
+        }
+    } else {
+        h_data[h_row_u + 0] = (unsigned short)pixel_ant_u;
+        h_data[h_row_v + 0] = (unsigned short)pixel_ant_v;
+        for (int x = 0; x + 1 < width; x++) {
+            T2 raw = row[x + 1];
+            unsigned int cur_u = load_sample((unsigned int)raw.x, depth, is_msb);
+            unsigned int cur_v = load_sample((unsigned int)raw.y, depth, is_msb);
+            pixel_ant_u = (unsigned int)lowpass((int)pixel_ant_u, (int)cur_u,
+                                                coef_tables, spatial_offset, lut_bits);
+            pixel_ant_v = (unsigned int)lowpass((int)pixel_ant_v, (int)cur_v,
+                                                coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_u + x + 1] = (unsigned short)pixel_ant_u;
+            h_data[h_row_v + x + 1] = (unsigned short)pixel_ant_v;
+        }
+    }
+}
+
+template <typename T>
+__device__ static void vertical_planar_temporal_col(
+    const unsigned char *src, int src_pitch,
+    unsigned char *dst, int dst_pitch,
+    unsigned short *frame_ant_data, int fa_offset,
+    const short *coef_tables, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame)
+{
+    for (int y = 0; y < height; y++) {
+        const T *src_row = (const T *)(src + y * src_pitch);
+        unsigned int raw = (unsigned int)src_row[x];
+        int cur = (int)load_sample(raw, depth, is_msb);
+        int fa_idx = fa_offset + y * width + x;
+        int prev_ant = first_frame ? cur : (int)frame_ant_data[fa_idx];
+        int tmp = lowpass(prev_ant, cur, coef_tables, temporal_offset, lut_bits);
+        frame_ant_data[fa_idx] = (unsigned short)tmp;
+        unsigned int out_val = store_sample((unsigned int)tmp, depth, is_msb);
+        T *dst_row = (T *)(dst + y * dst_pitch);
+        dst_row[x] = (T)out_val;
+    }
+}
+
+template <typename T>
+__device__ static void vertical_planar_spatial_col(
+    const unsigned char *src, int src_pitch,
+    unsigned char *dst, int dst_pitch,
+    const unsigned short *h_data, int h_offset,
+    unsigned short *frame_ant_data, int fa_offset,
+    const short *coef_tables, int spatial_offset, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame)
+{
+    int line_ant = (int)h_data[h_offset + x];
+    for (int y = 0; y < height; y++) {
+        int spat_tmp = line_ant;
+        if (y > 0) {
+            int h_val = (int)h_data[h_offset + y * width + x];
+            spat_tmp = lowpass(line_ant, h_val, coef_tables, spatial_offset, lut_bits);
+            line_ant = (int)(unsigned short)spat_tmp;
+        }
+        int fa_idx = fa_offset + y * width + x;
+        int prev_ant;
+        if (first_frame) {
+            const T *src_row = (const T *)(src + y * src_pitch);
+            unsigned int raw = (unsigned int)src_row[x];
+            prev_ant = (int)load_sample(raw, depth, is_msb);
+        } else {
+            prev_ant = (int)frame_ant_data[fa_idx];
+        }
+        int temp_tmp = lowpass(prev_ant, spat_tmp, coef_tables, temporal_offset, lut_bits);
+        frame_ant_data[fa_idx] = (unsigned short)temp_tmp;
+        unsigned int out_val = store_sample((unsigned int)temp_tmp, depth, is_msb);
+        T *dst_row = (T *)(dst + y * dst_pitch);
+        dst_row[x] = (T)out_val;
+    }
+}
+
+template <typename T2>
+__device__ static void vertical_semiplanar_temporal_col(
+    const unsigned char *src, int src_pitch,
+    unsigned char *dst, int dst_pitch,
+    unsigned short *frame_ant_data, int fa_offset_u, int fa_offset_v,
+    const short *coef_tables, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame)
+{
+    for (int y = 0; y < height; y++) {
+        const T2 *src_row = (const T2 *)(src + y * src_pitch);
+        T2 raw = src_row[x];
+        int cur_u = (int)load_sample((unsigned int)raw.x, depth, is_msb);
+        int cur_v = (int)load_sample((unsigned int)raw.y, depth, is_msb);
+        int fa_u = fa_offset_u + y * width + x;
+        int fa_v = fa_offset_v + y * width + x;
+        int prev_u = first_frame ? cur_u : (int)frame_ant_data[fa_u];
+        int prev_v = first_frame ? cur_v : (int)frame_ant_data[fa_v];
+        int tmp_u = lowpass(prev_u, cur_u, coef_tables, temporal_offset, lut_bits);
+        int tmp_v = lowpass(prev_v, cur_v, coef_tables, temporal_offset, lut_bits);
+        frame_ant_data[fa_u] = (unsigned short)tmp_u;
+        frame_ant_data[fa_v] = (unsigned short)tmp_v;
+        unsigned int out_u = store_sample((unsigned int)tmp_u, depth, is_msb);
+        unsigned int out_v = store_sample((unsigned int)tmp_v, depth, is_msb);
+        T2 *dst_row = (T2 *)(dst + y * dst_pitch);
+        dst_row[x] = make_vec2<T2>(out_u, out_v);
+    }
+}
+
+template <typename T2>
+__device__ static void vertical_semiplanar_spatial_col(
+    const unsigned char *src, int src_pitch,
+    unsigned char *dst, int dst_pitch,
+    const unsigned short *h_data, int h_offset_u, int h_offset_v,
+    unsigned short *frame_ant_data, int fa_offset_u, int fa_offset_v,
+    const short *coef_tables, int spatial_offset, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame)
+{
+    int line_ant_u = (int)h_data[h_offset_u + x];
+    int line_ant_v = (int)h_data[h_offset_v + x];
+    for (int y = 0; y < height; y++) {
+        int spat_tmp_u = line_ant_u;
+        int spat_tmp_v = line_ant_v;
+        if (y > 0) {
+            int h_u = (int)h_data[h_offset_u + y * width + x];
+            int h_v = (int)h_data[h_offset_v + y * width + x];
+            spat_tmp_u = lowpass(line_ant_u, h_u, coef_tables, spatial_offset, lut_bits);
+            spat_tmp_v = lowpass(line_ant_v, h_v, coef_tables, spatial_offset, lut_bits);
+            line_ant_u = (int)(unsigned short)spat_tmp_u;
+            line_ant_v = (int)(unsigned short)spat_tmp_v;
+        }
+        int fa_u = fa_offset_u + y * width + x;
+        int fa_v = fa_offset_v + y * width + x;
+        int prev_u, prev_v;
+        if (first_frame) {
+            const T2 *src_row = (const T2 *)(src + y * src_pitch);
+            T2 raw = src_row[x];
+            prev_u = (int)load_sample((unsigned int)raw.x, depth, is_msb);
+            prev_v = (int)load_sample((unsigned int)raw.y, depth, is_msb);
+        } else {
+            prev_u = (int)frame_ant_data[fa_u];
+            prev_v = (int)frame_ant_data[fa_v];
+        }
+        int temp_tmp_u = lowpass(prev_u, spat_tmp_u, coef_tables, temporal_offset, lut_bits);
+        int temp_tmp_v = lowpass(prev_v, spat_tmp_v, coef_tables, temporal_offset, lut_bits);
+        frame_ant_data[fa_u] = (unsigned short)temp_tmp_u;
+        frame_ant_data[fa_v] = (unsigned short)temp_tmp_v;
+        unsigned int out_u = store_sample((unsigned int)temp_tmp_u, depth, is_msb);
+        unsigned int out_v = store_sample((unsigned int)temp_tmp_v, depth, is_msb);
+        T2 *dst_row = (T2 *)(dst + y * dst_pitch);
+        dst_row[x] = make_vec2<T2>(out_u, out_v);
+    }
+}
