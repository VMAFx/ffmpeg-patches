+#define DIV_UP(a, b) ( ((a) + (b) - 1) / (b) )
+#define BLOCK_SIZE 128
+#define CHECK_CU(x) FF_CUDA_CHECK_DL(ctx, s->hwctx->internal->cuda_dl, x)
+
+typedef struct HQDN3DCUDAContext {
+    const AVClass *class;
+    AVCUDADeviceContext *hwctx;
+
+    CUmodule    cu_module;
+    CUfunction  cu_func_horiz_planar_8;
+    CUfunction  cu_func_horiz_planar_16;
+    CUfunction  cu_func_horiz_semiplanar_8;
+    CUfunction  cu_func_horiz_semiplanar_16;
+    CUfunction  cu_func_vert_planar_8;
+    CUfunction  cu_func_vert_planar_16;
+    CUfunction  cu_func_vert_semiplanar_8;
+    CUfunction  cu_func_vert_semiplanar_16;
+    CUstream    cu_stream;
+
+    CUdeviceptr tables_buf;
+    CUdeviceptr h_buf;
+    CUdeviceptr frame_ant_buf;
+
+    double strength[4];
+
+    int hsub, vsub;
+    int depth;
+    int is_msb;
+    int is_semiplanar;
+    int width, height;
+    enum AVPixelFormat sw_format;
+
+    int spatial_enabled[2];
+    int first_frame;
+    int initialized;
+
+    AVBufferRef *out_frames_ref;
+} HQDN3DCUDAContext;
+
+static int validate_format(AVFilterContext *ctx, enum AVPixelFormat sw_format,
+                           int *depth, int *is_msb, int *is_semiplanar)
+{
+    switch (sw_format) {
+    case AV_PIX_FMT_YUV420P:
+    case AV_PIX_FMT_YUV422P:
+    case AV_PIX_FMT_YUV444P:
+        *depth = 8;
+        *is_msb = 0;
+        *is_semiplanar = 0;
+        return 0;
+    case AV_PIX_FMT_YUV420P10:
+    case AV_PIX_FMT_YUV444P10:
+        *depth = 10;
+        *is_msb = 0;
+        *is_semiplanar = 0;
+        return 0;
+    case AV_PIX_FMT_YUV444P16:
+        *depth = 16;
+        *is_msb = 0;
+        *is_semiplanar = 0;
+        return 0;
+    case AV_PIX_FMT_NV12:
+        *depth = 8;
+        *is_msb = 0;
+        *is_semiplanar = 1;
+        return 0;
+    case AV_PIX_FMT_P010:
+        *depth = 10;
+        *is_msb = 1;
+        *is_semiplanar = 1;
+        return 0;
+    case AV_PIX_FMT_P016:
+        *depth = 16;
+        *is_msb = 1;
+        *is_semiplanar = 1;
+        return 0;
+    default:
+        av_log(ctx, AV_LOG_ERROR, "Unsupported sw_format: %s\n",
+               av_get_pix_fmt_name(sw_format));
+        return AVERROR(ENOSYS);
+    }
+}
+
+static av_cold int hqdn3d_cuda_init(AVFilterContext *ctx)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+
+    s->out_frames_ref = NULL;
+    ff_hqdn3d_default_strengths(s->strength);
+
+    av_log(ctx, AV_LOG_VERBOSE, "ls:%f cs:%f lt:%f ct:%f\n",
+           s->strength[LUMA_SPATIAL], s->strength[CHROMA_SPATIAL],
+           s->strength[LUMA_TMP], s->strength[CHROMA_TMP]);
+
+    return 0;
+}
+
+static void free_buffers(AVFilterContext *ctx)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+
+    if (s->tables_buf) {
+        cu->cuMemFree(s->tables_buf);
+        s->tables_buf = 0;
+    }
+    if (s->h_buf) {
+        cu->cuMemFree(s->h_buf);
+        s->h_buf = 0;
+    }
+    if (s->frame_ant_buf) {
+        cu->cuMemFree(s->frame_ant_buf);
+        s->frame_ant_buf = 0;
+    }
+}
+
+static int init_buffers(AVFilterContext *ctx, int w, int h)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    size_t tables_sz = (size_t)4 * (512 << lut_bits) * sizeof(int16_t);
+    int cw = AV_CEIL_RSHIFT(w, s->hsub);
+    int ch = AV_CEIL_RSHIFT(h, s->vsub);
+    size_t samples = (size_t)w * h + (size_t)2 * cw * ch;
+    size_t data_sz = samples * sizeof(uint16_t);
+    int ret;
+
+    ret = CHECK_CU(cu->cuMemAlloc(&s->tables_buf, tables_sz));
+    if (ret < 0)
+        return ret;
+
+    ret = CHECK_CU(cu->cuMemAlloc(&s->h_buf, data_sz));
+    if (ret < 0) {
+        free_buffers(ctx);
+        return ret;
+    }
+
+    ret = CHECK_CU(cu->cuMemAlloc(&s->frame_ant_buf, data_sz));
+    if (ret < 0) {
+        free_buffers(ctx);
+        return ret;
+    }
+
+    return 0;
+}
+
+static int calc_coefs(AVFilterContext *ctx)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    size_t tables_sz = (size_t)4 * table_entries * sizeof(int16_t);
+    int16_t *tables = av_malloc(tables_sz);
+    int ret;
+
+    if (!tables)
+        return AVERROR(ENOMEM);
+
+    for (int i = 0; i < 4; i++) {
+        int16_t *ct = tables + i * table_entries;
+        ff_hqdn3d_precalc_coefs(s->strength[i], s->depth, ct);
+    }
+
+    s->spatial_enabled[0] = s->strength[LUMA_SPATIAL] != 0.0;
+    s->spatial_enabled[1] = s->strength[CHROMA_SPATIAL] != 0.0;
+
+    ret = CHECK_CU(cu->cuMemcpyHtoD(s->tables_buf, tables, tables_sz));
+    av_free(tables);
+    return ret;
+}
+
+static int create_out_frames_ctx(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    AVHWFramesContext *in_hwfc = (AVHWFramesContext *)in->hw_frames_ctx->data;
+    AVHWFramesContext *frames_ctx;
+    AVBufferRef *device_ref = in_hwfc->device_ref ? in_hwfc->device_ref : ctx->hw_device_ctx;
+    int err;
+
+    if (!device_ref)
+        return AVERROR(EINVAL);
+
+    av_buffer_unref(&s->out_frames_ref);
+
+    s->out_frames_ref = av_hwframe_ctx_alloc(device_ref);
+    if (!s->out_frames_ref)
+        return AVERROR(ENOMEM);
+
+    frames_ctx = (AVHWFramesContext *)s->out_frames_ref->data;
+    frames_ctx->format    = AV_PIX_FMT_CUDA;
+    frames_ctx->sw_format = in_hwfc->sw_format;
+    frames_ctx->width     = in->width;
+    frames_ctx->height    = in->height;
+
+    err = av_hwframe_ctx_init(s->out_frames_ref);
+    if (err < 0) {
+        av_buffer_unref(&s->out_frames_ref);
+        return err;
+    }
+
+    ctx->outputs[0]->w = in->width;
+    ctx->outputs[0]->h = in->height;
+    return 0;
+}
+
+static AVFrame *alloc_output_frame(HQDN3DCUDAContext *s, AVFilterLink *outlink, AVFrame *in)
+{
+    AVFrame *out;
+    int err;
+
+    if (s->out_frames_ref) {
+        out = av_frame_alloc();
+        if (!out)
+            return NULL;
+        err = av_hwframe_get_buffer(s->out_frames_ref, out, 0);
+        if (err < 0) {
+            av_frame_free(&out);
+            return NULL;
+        }
+    } else {
+        out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+        if (!out)
+            return NULL;
+    }
+
+    if (av_frame_copy_props(out, in) < 0) {
+        av_frame_free(&out);
+        return NULL;
+    }
+    return out;
+}
+
+static av_cold int cuda_hqdn3d_load_functions(AVFilterContext *ctx)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CUcontext dummy, cuda_ctx = s->hwctx->cuda_ctx;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int ret;
+
+    extern const unsigned char ff_vf_hqdn3d_cuda_ptx_data[];
+    extern const unsigned int ff_vf_hqdn3d_cuda_ptx_len;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(cuda_ctx));
+    if (ret < 0)
+        return ret;
+
+    ret = ff_cuda_load_module(ctx, s->hwctx, &s->cu_module,
+                              ff_vf_hqdn3d_cuda_ptx_data, ff_vf_hqdn3d_cuda_ptx_len);
+    if (ret < 0) {
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        return ret;
+    }
+
+    ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_horiz_planar_8, s->cu_module, "hqdn3d_horizontal_planar_8"));
+    if (ret >= 0)
+        ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_horiz_planar_16, s->cu_module, "hqdn3d_horizontal_planar_16"));
+    if (ret >= 0)
+        ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_horiz_semiplanar_8, s->cu_module, "hqdn3d_horizontal_semiplanar_8"));
+    if (ret >= 0)
+        ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_horiz_semiplanar_16, s->cu_module, "hqdn3d_horizontal_semiplanar_16"));
+    if (ret >= 0)
+        ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_vert_planar_8, s->cu_module, "hqdn3d_vertical_planar_8"));
+    if (ret >= 0)
+        ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_vert_planar_16, s->cu_module, "hqdn3d_vertical_planar_16"));
+    if (ret >= 0)
+        ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_vert_semiplanar_8, s->cu_module, "hqdn3d_vertical_semiplanar_8"));
+    if (ret >= 0)
+        ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_vert_semiplanar_16, s->cu_module, "hqdn3d_vertical_semiplanar_16"));
+
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    return ret;
+}
+
+static int check_format_and_size(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    AVHWFramesContext *hwfc = (AVHWFramesContext *)in->hw_frames_ctx->data;
+    int err;
+
+    err = validate_format(ctx, hwfc->sw_format, &s->depth, &s->is_msb, &s->is_semiplanar);
+    if (err < 0)
+        return err;
+
+    if (in->width != s->width || in->height != s->height || hwfc->sw_format != s->sw_format) {
+        if (s->initialized) {
+            free_buffers(ctx);
+            err = init_buffers(ctx, in->width, in->height);
+            if (err < 0)
+                return err;
+            err = calc_coefs(ctx);
+            if (err < 0)
+                return err;
+            err = create_out_frames_ctx(ctx, in);
+            if (err < 0)
+                return err;
+            s->first_frame = 1;
+        }
+        s->sw_format = hwfc->sw_format;
+        s->width = in->width;
+        s->height = in->height;
+        s->hsub = av_pix_fmt_desc_get(hwfc->sw_format)->log2_chroma_w;
+        s->vsub = av_pix_fmt_desc_get(hwfc->sw_format)->log2_chroma_h;
+    }
+    return 0;
+}
+
+static int init_filter(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    int err;
+
+    err = init_buffers(ctx, in->width, in->height);
+    if (err < 0)
+        return err;
+
+    err = calc_coefs(ctx);
+    if (err < 0) {
+        free_buffers(ctx);
+        return err;
+    }
+
+    s->initialized = 1;
+    s->first_frame = 1;
+    return 0;
+}
+
+static int dispatch_horizontal_chroma(AVFilterContext *ctx, AVFrame *in,
+                                      int cw, int ch, int off_u, int off_v,
+                                      int lut_bits, int table_entries)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int spatial_offset = 2 * table_entries;
+    int ret;
+
+    if (s->is_semiplanar) {
+        CUdeviceptr src_ptr = (CUdeviceptr)in->data[1];
+        int src_pitch = in->linesize[1];
+        void *args[] = {
+            &src_ptr, &src_pitch,
+            &s->h_buf, &off_u, &off_v,
+            &s->tables_buf, &spatial_offset,
+            &cw, &ch,
+            &s->depth, &lut_bits, &s->is_msb
+        };
+        CUfunction func = (s->depth == 8) ? s->cu_func_horiz_semiplanar_8 : s->cu_func_horiz_semiplanar_16;
+        return CHECK_CU(cu->cuLaunchKernel(func,
+                                           DIV_UP(ch, BLOCK_SIZE), 1, 1,
+                                           BLOCK_SIZE, 1, 1,
+                                           0, s->cu_stream, args, NULL));
+    }
+
+    CUfunction func = (s->depth == 8) ? s->cu_func_horiz_planar_8 : s->cu_func_horiz_planar_16;
+    for (int p = 1; p <= 2; p++) {
+        CUdeviceptr src_ptr = (CUdeviceptr)in->data[p];
+        int src_pitch = in->linesize[p];
+        int h_offset = (p == 1) ? off_u : off_v;
+        void *args[] = {
+            &src_ptr, &src_pitch,
+            &s->h_buf, &h_offset,
+            &s->tables_buf, &spatial_offset,
+            &cw, &ch,
+            &s->depth, &lut_bits, &s->is_msb
+        };
+        ret = CHECK_CU(cu->cuLaunchKernel(func,
+                                          DIV_UP(ch, BLOCK_SIZE), 1, 1,
+                                          BLOCK_SIZE, 1, 1,
+                                          0, s->cu_stream, args, NULL));
+        if (ret < 0)
+            return ret;
+    }
+    return 0;
+}
+
+static int dispatch_horizontal(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    int cw = AV_CEIL_RSHIFT(s->width, s->hsub);
+    int ch = AV_CEIL_RSHIFT(s->height, s->vsub);
+    int off_u = s->width * s->height;
+    int off_v = s->width * s->height + cw * ch;
+
+    if (s->spatial_enabled[0]) {
+        CUdeviceptr src_ptr = (CUdeviceptr)in->data[0];
+        int src_pitch = in->linesize[0];
+        int h_offset = 0;
+        int spatial_offset = 0 * table_entries;
+        void *args[] = {
+            &src_ptr, &src_pitch,
+            &s->h_buf, &h_offset,
+            &s->tables_buf, &spatial_offset,
+            &s->width, &s->height,
+            &s->depth, &lut_bits, &s->is_msb
+        };
+        CUfunction func = (s->depth == 8) ? s->cu_func_horiz_planar_8 : s->cu_func_horiz_planar_16;
+        int ret = CHECK_CU(cu->cuLaunchKernel(func,
+                                              DIV_UP(s->height, BLOCK_SIZE), 1, 1,
+                                              BLOCK_SIZE, 1, 1,
+                                              0, s->cu_stream, args, NULL));
+        if (ret < 0)
+            return ret;
+    }
+
+    if (!s->spatial_enabled[1])
+        return 0;
+
+    return dispatch_horizontal_chroma(ctx, in, cw, ch, off_u, off_v, lut_bits, table_entries);
+}
+
+static int dispatch_vertical_semiplanar(AVFilterContext *ctx, AVFrame *in, AVFrame *out,
+                                        int cw, int ch, int off_u, int off_v,
+                                        int lut_bits, int table_entries)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int spatial_offset = 2 * table_entries;
+    int temporal_offset = 3 * table_entries;
+    int spatial_enabled = s->spatial_enabled[1];
+    CUdeviceptr src_ptr = (CUdeviceptr)in->data[1];
+    int src_pitch = in->linesize[1];
+    CUdeviceptr dst_ptr = (CUdeviceptr)out->data[1];
+    int dst_pitch = out->linesize[1];
+    void *args[] = {
+        &src_ptr, &src_pitch,
+        &dst_ptr, &dst_pitch,
+        &s->h_buf, &off_u, &off_v,
+        &s->frame_ant_buf, &off_u, &off_v,
+        &s->tables_buf,
+        &spatial_offset, &temporal_offset,
+        &cw, &ch,
+        &s->depth, &lut_bits, &s->is_msb,
+        &s->first_frame, &spatial_enabled
+    };
+    CUfunction func = (s->depth == 8) ? s->cu_func_vert_semiplanar_8 : s->cu_func_vert_semiplanar_16;
+    return CHECK_CU(cu->cuLaunchKernel(func,
+                                       DIV_UP(cw, BLOCK_SIZE), 1, 1,
+                                       BLOCK_SIZE, 1, 1,
+                                       0, s->cu_stream, args, NULL));
+}
+
+static int dispatch_vertical_planar(AVFilterContext *ctx, AVFrame *in, AVFrame *out,
+                                    int cw, int ch, int off_u, int off_v,
+                                    int lut_bits, int table_entries)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int spatial_offset = 2 * table_entries;
+    int temporal_offset = 3 * table_entries;
+    int spatial_enabled = s->spatial_enabled[1];
+    CUfunction func = (s->depth == 8) ? s->cu_func_vert_planar_8 : s->cu_func_vert_planar_16;
+    int ret;
+
+    for (int p = 1; p <= 2; p++) {
+        CUdeviceptr src_ptr = (CUdeviceptr)in->data[p];
+        int src_pitch = in->linesize[p];
+        CUdeviceptr dst_ptr = (CUdeviceptr)out->data[p];
+        int dst_pitch = out->linesize[p];
+        int h_offset = (p == 1) ? off_u : off_v;
+        int fa_offset = (p == 1) ? off_u : off_v;
+        void *args[] = {
+            &src_ptr, &src_pitch,
+            &dst_ptr, &dst_pitch,
+            &s->h_buf, &h_offset,
+            &s->frame_ant_buf, &fa_offset,
+            &s->tables_buf,
+            &spatial_offset, &temporal_offset,
+            &cw, &ch,
+            &s->depth, &lut_bits, &s->is_msb,
+            &s->first_frame, &spatial_enabled
+        };
+        ret = CHECK_CU(cu->cuLaunchKernel(func,
+                                          DIV_UP(cw, BLOCK_SIZE), 1, 1,
+                                          BLOCK_SIZE, 1, 1,
+                                          0, s->cu_stream, args, NULL));
+        if (ret < 0)
+            return ret;
+    }
+    return 0;
+}
+
+static int dispatch_vertical(AVFilterContext *ctx, AVFrame *in, AVFrame *out)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    int cw = AV_CEIL_RSHIFT(s->width, s->hsub);
+    int ch = AV_CEIL_RSHIFT(s->height, s->vsub);
+    int off_u = s->width * s->height;
+    int off_v = s->width * s->height + cw * ch;
+    int ret;
+
+    {
+        CUdeviceptr src_ptr = (CUdeviceptr)in->data[0];
+        int src_pitch = in->linesize[0];
+        CUdeviceptr dst_ptr = (CUdeviceptr)out->data[0];
+        int dst_pitch = out->linesize[0];
+        int h_offset = 0;
+        int fa_offset = 0;
+        int spatial_offset = 0 * table_entries;
+        int temporal_offset = 1 * table_entries;
+        int spatial_enabled = s->spatial_enabled[0];
+        void *args[] = {
+            &src_ptr, &src_pitch,
+            &dst_ptr, &dst_pitch,
+            &s->h_buf, &h_offset,
+            &s->frame_ant_buf, &fa_offset,
+            &s->tables_buf,
+            &spatial_offset, &temporal_offset,
+            &s->width, &s->height,
+            &s->depth, &lut_bits, &s->is_msb,
+            &s->first_frame, &spatial_enabled
+        };
+        CUfunction func = (s->depth == 8) ? s->cu_func_vert_planar_8 : s->cu_func_vert_planar_16;
+        ret = CHECK_CU(cu->cuLaunchKernel(func,
+                                          DIV_UP(s->width, BLOCK_SIZE), 1, 1,
+                                          BLOCK_SIZE, 1, 1,
+                                          0, s->cu_stream, args, NULL));
+        if (ret < 0)
+            return ret;
+    }
+
+    if (s->is_semiplanar)
+        return dispatch_vertical_semiplanar(ctx, in, out, cw, ch, off_u, off_v, lut_bits, table_entries);
+    return dispatch_vertical_planar(ctx, in, out, cw, ch, off_u, off_v, lut_bits, table_entries);
+}
+
+static int exec_filter(AVFilterContext *ctx, AVFrame *in, AVFrame *out)
+{
+    int ret;
+
+    ret = dispatch_horizontal(ctx, in);
+    if (ret < 0)
+        return ret;
+
+    return dispatch_vertical(ctx, in, out);
+}
+
+static int cuda_hqdn3d_filter_frame(AVFilterLink *link, AVFrame *in)
+{
+    AVFilterContext *ctx = link->dst;
+    HQDN3DCUDAContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    CUcontext dummy;
+    AVFrame *out = NULL;
+    int ret;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+    if (ret < 0) {
+        av_frame_free(&in);
+        return ret;
+    }
+
+    ret = check_format_and_size(ctx, in);
+    if (ret < 0) {
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        av_frame_free(&in);
+        return ret;
+    }
+
+    if (!s->initialized) {
+        ret = init_filter(ctx, in);
+        if (ret < 0) {
+            CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+            av_frame_free(&in);
+            return ret;
+        }
+    }
+
+    out = alloc_output_frame(s, outlink, in);
+    if (!out) {
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        av_frame_free(&in);
+        return AVERROR(ENOMEM);
+    }
+
+    ret = exec_filter(ctx, in, out);
+    if (ret < 0) {
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return ret;
+    }
+
+    ret = CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    if (ret < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return ret;
+    }
+
+    s->first_frame = 0;
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+}
+
+static int cuda_hqdn3d_config_props(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    HQDN3DCUDAContext *s = ctx->priv;
+    AVFilterLink *inlink = ctx->inputs[0];
+    FilterLink *inl = ff_filter_link(inlink);
+    FilterLink *outl = ff_filter_link(outlink);
+    AVHWFramesContext *in_frames_ctx;
+    CUcontext dummy;
+    int err;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(ctx, AV_LOG_ERROR, "No hw context provided on input\n");
+        return AVERROR(EINVAL);
+    }
+    in_frames_ctx = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+
+    err = validate_format(ctx, in_frames_ctx->sw_format, &s->depth, &s->is_msb, &s->is_semiplanar);
+    if (err < 0)
+        return err;
+
+    s->hwctx = in_frames_ctx->device_ctx->hwctx;
+    s->cu_stream = s->hwctx->stream;
+
+    av_buffer_unref(&outl->hw_frames_ctx);
+    outl->hw_frames_ctx = av_buffer_ref(inl->hw_frames_ctx);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+
+    outlink->w = inlink->w;
+    outlink->h = inlink->h;
+    outlink->time_base = inlink->time_base;
+    outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+
+    if (!s->cu_module) {
+        err = cuda_hqdn3d_load_functions(ctx);
+        if (err < 0)
+            return err;
+    }
+
+    if (s->initialized) {
+        CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+        err = CHECK_CU(cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+        if (err < 0)
+            return err;
+        free_buffers(ctx);
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        s->initialized = 0;
+    }
+    av_buffer_unref(&s->out_frames_ref);
+    s->width = 0;
+    s->height = 0;
+    s->sw_format = AV_PIX_FMT_NONE;
+    s->first_frame = 1;
+
+    return 0;
+}
+
+static av_cold void hqdn3d_cuda_uninit(AVFilterContext *ctx)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    CUcontext dummy;
+
+    if (s->hwctx) {
+        CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+        CHECK_CU(cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+        free_buffers(ctx);
+        if (s->cu_module) {
+            CHECK_CU(cu->cuModuleUnload(s->cu_module));
+            s->cu_module = NULL;
+        }
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    }
+    av_buffer_unref(&s->out_frames_ref);
+    s->initialized = 0;
+}
+
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    HQDN3DCUDAContext *s = ctx->priv;
+    int ret;
+
+    ret = ff_filter_process_command(ctx, cmd, args, res, res_len, flags);
+    if (ret < 0)
+        return ret;
+
+    if (s->initialized) {
+        CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+        CUcontext dummy;
+        ret = CHECK_CU(cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+        if (ret < 0)
+            return ret;
+        ret = calc_coefs(ctx);
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        return ret;
+    }
+
+    return 0;
+}
+
+#define OFFSET(x) offsetof(HQDN3DCUDAContext, x)
+#define FLAGS (AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_RUNTIME_PARAM)
+static const AVOption hqdn3d_cuda_options[] = {
+    { "luma_spatial",   "spatial luma strength",    OFFSET(strength[LUMA_SPATIAL]),   AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0, DBL_MAX, FLAGS },
+    { "chroma_spatial", "spatial chroma strength",  OFFSET(strength[CHROMA_SPATIAL]), AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0, DBL_MAX, FLAGS },
+    { "luma_tmp",       "temporal luma strength",   OFFSET(strength[LUMA_TMP]),       AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0, DBL_MAX, FLAGS },
+    { "chroma_tmp",     "temporal chroma strength", OFFSET(strength[CHROMA_TMP]),     AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0, DBL_MAX, FLAGS },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(hqdn3d_cuda);
+
+static const AVFilterPad hqdn3d_cuda_inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = &cuda_hqdn3d_filter_frame,
+    }
+};
+
+static const AVFilterPad hqdn3d_cuda_outputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = &cuda_hqdn3d_config_props,
+    }
+};
+
+const FFFilter ff_vf_hqdn3d_cuda = {
+    .p.name         = "hqdn3d_cuda",
+    .p.description  = NULL_IF_CONFIG_SMALL("Apply a High Quality 3D Denoiser using CUDA"),
+    .p.priv_class   = &hqdn3d_cuda_class,
+    .p.flags        = AVFILTER_FLAG_HWDEVICE,
+    .priv_size      = sizeof(HQDN3DCUDAContext),
+    .init           = &hqdn3d_cuda_init,
+    .uninit         = &hqdn3d_cuda_uninit,
+    .process_command = &process_command,
+    FILTER_INPUTS(hqdn3d_cuda_inputs),
+    FILTER_OUTPUTS(hqdn3d_cuda_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_CUDA),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
