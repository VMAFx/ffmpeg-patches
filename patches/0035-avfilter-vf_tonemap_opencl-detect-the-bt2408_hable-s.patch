+static int zero_peak_stats_buffer(AVFilterContext *avctx)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    cl_uint zero = 0;
+    cl_int cle;
+
+    cle = clEnqueueFillBuffer(ctx->command_queue, ctx->peak_stats_mem,
+                              &zero, sizeof(zero), 0, sizeof(FFTonemapPeakStats),
+                              0, NULL, NULL);
+    if (cle != CL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to clear peak stats buffer: %d.\n", cle);
+        return AVERROR(EIO);
+    }
+    return 0;
+}
+
+static int enqueue_peak_kernel(AVFilterContext *avctx, AVFrame *input)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    size_t global_work[2];
+    size_t local_work[2] = { 16, 16 };
+    cl_int cle;
+
+    cle  = clSetKernelArg(ctx->peak_kernel, 0, sizeof(cl_mem), &input->data[0]);
+    cle |= clSetKernelArg(ctx->peak_kernel, 1, sizeof(cl_mem), &input->data[1]);
+    cle |= clSetKernelArg(ctx->peak_kernel, 2, sizeof(cl_mem), &ctx->peak_stats_mem);
+    if (cle != CL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to set peak kernel arguments: %d.\n", cle);
+        return AVERROR(EIO);
+    }
+
+    global_work[0] = FFALIGN(input->width, 16);
+    global_work[1] = FFALIGN(input->height, 16);
+
+    cle = clEnqueueNDRangeKernel(ctx->command_queue, ctx->peak_kernel, 2, NULL,
+                                 global_work, local_work, 0, NULL, NULL);
+    if (cle != CL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to enqueue peak kernel: %d.\n", cle);
+        return AVERROR(EIO);
+    }
+    return 0;
+}
+
+static int read_peak_stats(AVFilterContext *avctx, FFTonemapPeakStats *stats)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    cl_int cle;
+
+    cle = clEnqueueReadBuffer(ctx->command_queue, ctx->peak_stats_mem, CL_TRUE,
+                              0, sizeof(*stats), stats, 0, NULL, NULL);
+    if (cle != CL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to read peak stats buffer: %d.\n", cle);
+        return AVERROR(EIO);
+    }
+    return 0;
+}
+
+static int detect_signal_peak(AVFilterContext *avctx, AVFrame *input, double *peak_out)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    FFTonemapPeakStats stats;
+    int err;
+
+    err = zero_peak_stats_buffer(avctx);
+    if (err < 0)
+        return err;
+
+    err = enqueue_peak_kernel(avctx, input);
+    if (err < 0)
+        return err;
+
+    err = read_peak_stats(avctx, &stats);
+    if (err < 0)
+        return err;
+
+    ctx->peak_state.threshold = ctx->scene_threshold;
+    *peak_out = ff_tonemap_peak_update(&ctx->peak_state, &stats);
+    return 0;
+}
