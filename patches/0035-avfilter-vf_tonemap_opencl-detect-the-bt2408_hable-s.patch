new file mode 100644
index 0000000000000000000000000000000000000000..7312ac6e27aa765447fbc961447ce09f10907fd4
--- /dev/null
+++ b/libavfilter/opencl/tonemap_peak.cl
@@ -0,0 +1,124 @@
+/*
+ * Peak detection compute kernel for tonemap_opencl
+ *
+ * The dynamic peak detection follows libplacebo v7.360.1
+ * (src/shaders/colorspace.c: pl_shader_detect_peak, measure_peak,
+ * update_peak_buf), Copyright (C) Niklas Haas and the libplacebo
+ * contributors, licensed under the GNU Lesser General Public License
+ * version 2.1 or later.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef REFERENCE_WHITE
+#define REFERENCE_WHITE 100.0f
+#endif
+#ifndef ST2084_MAX_LUMINANCE
+#define ST2084_MAX_LUMINANCE 10000.0f
+#endif
+
+#define PQ_MAX 16383.0f
+
+#define STATS_SUM_LO    0
+#define STATS_SUM_HI    1
+#define STATS_WG_COUNT  2
+#define STATS_WG_ACTIVE 3
+#define STATS_MAX_PQ    4
+#define STATS_HIST      5
+
+extern float3 bt2408_yuv2lrgb(float3 yuv);
+
+__kernel void tonemap_peak(__read_only image2d_t src1,
+                           __read_only image2d_t src2,
+                           __global    uint        *stats)
+{
+    const sampler_t sampler = (CLK_NORMALIZED_COORDS_FALSE |
+                               CLK_ADDRESS_CLAMP_TO_EDGE   |
+                               CLK_FILTER_NEAREST);
+    __local uint tile_sum;
+    __local uint tile_max;
+    __local uint tile_black;
+    __local uint tile_valid;
+    __local uint tile_hist[64];
+
+    size_t lx = get_local_id(0);
+    size_t ly = get_local_id(1);
+    size_t lid = ly * 16 + lx;
+
+    int x = get_global_id(0);
+    int y = get_global_id(1);
+    int width = get_image_width(src1);
+    int height = get_image_height(src1);
+
+    if (lid == 0) {
+        tile_sum = 0;
+        tile_max = 0;
+        tile_black = 0;
+        tile_valid = 0;
+    }
+    if (lid < 64)
+        tile_hist[lid] = 0;
+
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    if (x < width && y < height) {
+        atomic_inc(&tile_valid);
+
+        float y_in = read_imagef(src1, sampler, (int2)(x, y)).x;
+        float2 uv_in = read_imagef(src2, sampler, (int2)(x / 2, y / 2)).xy;
+        float3 lrgb = bt2408_yuv2lrgb((float3)(y_in, uv_in.x, uv_in.y));
+
+        float luma = 0.2627f * lrgb.x + 0.6780f * lrgb.y + 0.0593f * lrgb.z;
+        float nits = luma * REFERENCE_WHITE;
+        float nx = clamp(nits / ST2084_MAX_LUMINANCE, 0.0f, 1.0f);
+        float xm = powr(max(nx, 0.0f), ST2084_M1);
+        float y_pq_f = powr((ST2084_C1 + ST2084_C2 * xm) / (1.0f + ST2084_C3 * xm), ST2084_M2);
+        float t = clamp(y_pq_f / 0.01f, 0.0f, 1.0f);
+        y_pq_f *= t * t * (3.0f - 2.0f * t);
+        y_pq_f = clamp(y_pq_f, 0.0f, 1.0f);
+        uint y_pq = (uint)(PQ_MAX * y_pq_f);
+
+        atomic_add(&tile_sum, y_pq);
+        atomic_max(&tile_max, y_pq);
+        if (y_pq == 0)
+            atomic_inc(&tile_black);
+        int bin = clamp(((int)y_pq >> 7) - 64, 0, 63);
+        atomic_inc(&tile_hist[bin]);
+    }
+
+    barrier(CLK_LOCAL_MEM_FENCE);
+
+    if (lid == 0) {
+        if (tile_valid > 0) {
+            tile_hist[0] -= tile_black;
+            uint num = tile_valid - tile_black;
+            atomic_add(&stats[STATS_WG_COUNT], 1);
+            if (num > 0) {
+                atomic_add(&stats[STATS_WG_ACTIVE], 1);
+                uint tile_sum_avg = tile_sum / num;
+                uint prev = atomic_add(&stats[STATS_SUM_LO], tile_sum_avg);
+                if (prev + tile_sum_avg < prev)
+                    atomic_add(&stats[STATS_SUM_HI], 1);
+                atomic_max(&stats[STATS_MAX_PQ], tile_max);
+            }
+            for (int i = 0; i < 64; i++) {
+                if (tile_hist[i] > 0)
+                    atomic_add(&stats[STATS_HIST + i], tile_hist[i]);
+            }
+        }
+    }
+}
