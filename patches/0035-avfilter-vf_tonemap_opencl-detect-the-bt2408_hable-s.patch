 libavfilter/Makefile               |   3 +-
 libavfilter/opencl/tonemap_peak.cl | 124 ++++++++++++++++
 libavfilter/opencl_source.h        |   1 +
 libavfilter/vf_tonemap_opencl.c    | 218 +++++++++++++++++++++++++----
 5 files changed, 330 insertions(+), 36 deletions(-)
 create mode 100644 libavfilter/opencl/tonemap_peak.cl

