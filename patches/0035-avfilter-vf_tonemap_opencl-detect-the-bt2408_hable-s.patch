+static int create_peak_objects(AVFilterContext *avctx)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    cl_int cle;
+
+    if (!ctx->peak_detect || ctx->tonemap != TONEMAP_BT2408_HABLE)
+        return 0;
+
+    ctx->peak_kernel = clCreateKernel(ctx->ocf.program, "tonemap_peak", &cle);
+    if (!ctx->peak_kernel || cle != CL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to create peak kernel: %d.\n", cle);
+        return AVERROR(EIO);
+    }
+
+    ctx->peak_stats_mem = clCreateBuffer(ctx->ocf.hwctx->context, CL_MEM_READ_WRITE,
+                                         sizeof(FFTonemapPeakStats), NULL, &cle);
+    if (!ctx->peak_stats_mem || cle != CL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to create peak stats buffer: %d.\n", cle);
+        return AVERROR(EIO);
+    }
+
+    return 0;
+}
