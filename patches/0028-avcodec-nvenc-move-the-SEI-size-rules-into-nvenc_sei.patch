From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lusoris <lusoris@proton.me>
Date: Sun, 18 Oct 2026 08:58:38 +0200
Subject: [PATCH] avcodec/nvenc: move the SEI size rules into nvenc_sei.h

The hevc_nvenc non-VCL limit, the SEI budget, the emulation prevention
byte count, the SEI NAL unit size and the truncation rule for user data
unregistered SEI were private to nvenc.c. Code that prepares SEI
payloads before they reach the encoder has to apply the same numbers
and so had to keep its own copy of them.

Move them into nvenc_sei.h as plain C on stddef.h and stdint.h only,
without libav* or NVENC headers, so such code can include the header
instead of copying it. nvenc_sei_nal_size() and
nvenc_udu_sei_truncated() now take the payload, its type and its size
instead of an NV_ENC_SEI_PAYLOAD. The reserve of 256 bytes gets a name,
NVENC_HEVC_SEI_RESERVE.

No change in behavior: the old and the new functions return the same
values on 1000000 random payloads of up to 1300 bytes with zero-byte
shares from 0 to 100 %.

Signed-off-by: lusoris <lusoris@proton.me>
---
 libavcodec/nvenc.c     | 65 ++++--------------------------
 libavcodec/nvenc_sei.h | 91 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 98 insertions(+), 58 deletions(-)
 create mode 100644 libavcodec/nvenc_sei.h

diff --git a/libavcodec/nvenc.c b/libavcodec/nvenc.c
index 042cf493f5c2ab7ba3d7b29935ca5ed21cb33b5c..0e627457929c6c0286a882d74e09b02ec72acc61 100644
--- a/libavcodec/nvenc.c
+++ b/libavcodec/nvenc.c
@@ -43,15 +43,7 @@
 #include "codec_desc.h"
 #include "encode.h"
 #include "internal.h"
-
-/* hevc_nvenc fails nvEncLockBitstream() with NV_ENC_ERR_OUT_OF_MEMORY when the
- * non-VCL NAL units of one picture, VPS, SPS, PPS, access unit delimiter and
- * every SEI in Annex B form, exceed 1024 bytes. The SEI passed in
- * seiPayloadArray get what is left after 256 bytes for the NAL units the
- * encoder writes on its own (at most 128 bytes measured, plus the HDR and
- * 3D reference display SEI it builds from the picture parameters). */
-#define NVENC_HEVC_NON_VCL_LIMIT 1024
-#define NVENC_HEVC_SEI_BUDGET    (NVENC_HEVC_NON_VCL_LIMIT - 256)
+#include "nvenc_sei.h"
 
 #define CHECK_CU(x) FF_CUDA_CHECK_DL(avctx, dl_fn->cuda_dl, x)
 
@@ -2695,36 +2687,10 @@ static int output_ready(AVCodecContext *avctx, int flush)
     return (nb_ready > 0) && (nb_ready + nb_pending >= ctx->async_depth);
 }
 
-/* Annex B size of the SEI NAL unit NVENC writes for one payload: start code,
- * NAL unit header, payload type and size, the payload with its emulation
- * prevention bytes and the trailing bits, plus one byte for emulation
- * prevention across the size and payload boundary. The payload is scanned only
- * when the rest fits into limit. */
-/* Emulation prevention bytes size bytes of payload p need, after zeros zero
- * bytes. */
-static size_t nvenc_sei_epb_count(const uint8_t *p, uint32_t size, int zeros)
+/* Annex B size of the SEI NAL unit NVENC writes for sei, see nvenc_sei.h. */
+static size_t nvenc_sei_payload_nal_size(const NV_ENC_SEI_PAYLOAD *sei, size_t limit)
 {
-    size_t epb = 0;
-
-    for (uint32_t i = 0; i < size; i++) {
-        if (zeros >= 2 && p[i] <= 3) {
-            epb++;
-            zeros = 0;
-        }
-        zeros = p[i] ? 0 : zeros + 1;
-    }
-    return epb;
-}
-
-static size_t nvenc_sei_nal_size(const NV_ENC_SEI_PAYLOAD *sei, size_t limit)
-{
-    size_t size = 4 + 2 + sei->payloadType / 255 + 1 + sei->payloadSize / 255 + 1 +
-                  sei->payloadSize + 1 + 1;
-
-    if (size > limit)
-        return size;
-
-    return size + nvenc_sei_epb_count(sei->payload, sei->payloadSize, 0);
+    return nvenc_sei_nal_size(sei->payload, sei->payloadType, sei->payloadSize, limit);
 }
 
 /* Charge one user data unregistered SEI against the picture's budget, or log
@@ -2733,7 +2699,7 @@ static int nvenc_hevc_sei_fits(AVCodecContext *avctx, const AVFrame *frame,
                                const NV_ENC_SEI_PAYLOAD *sei, size_t *budget)
 {
     NvencContext *ctx = avctx->priv_data;
-    size_t size = nvenc_sei_nal_size(sei, *budget);
+    size_t size = nvenc_sei_payload_nal_size(sei, *budget);
 
     if (size <= *budget) {
         *budget -= size;
@@ -2749,23 +2715,6 @@ static int nvenc_hevc_sei_fits(AVCodecContext *avctx, const AVFrame *frame,
     return 0;
 }
 
-/* NVENC escapes the user data unregistered SEI of a picture into a buffer of
- * 4/3 of the largest payload of the picture plus 5 bytes. A payload whose
- * emulation prevention bytes do not fit is written truncated, without its end
- * and trailing bits, and decoders discard the NAL unit. Only a payload that
- * needs more emulation prevention bytes than about a third of its size, as
- * long runs of zero bytes do, can overflow it. Measured with driver
- * 615.78.08 for h264_nvenc and hevc_nvenc. */
-static int nvenc_udu_sei_truncated(const NV_ENC_SEI_PAYLOAD *sei, uint32_t pmax)
-{
-    /* The last payload size byte is zero when the size is a multiple of 255. */
-    size_t epb  = nvenc_sei_epb_count(sei->payload, sei->payloadSize,
-                                      !(sei->payloadSize % 255));
-    size_t room = 4 * ((size_t)pmax + 5) / 3;
-
-    return sei->payloadSize + 3 + epb > room;
-}
-
 /* Drop the user data unregistered SEI in sei_data[first, count) that NVENC
  * would truncate and return the new count. Dropping the largest payload
  * shrinks the room of the others, so repeat until nothing is dropped. */
@@ -2785,7 +2734,7 @@ static int nvenc_drop_truncated_udu_sei(AVCodecContext *avctx, const AVFrame *fr
         for (int i = first; i < count; i++) {
             NV_ENC_SEI_PAYLOAD *sei = &ctx->sei_data[i];
 
-            if (!nvenc_udu_sei_truncated(sei, pmax)) {
+            if (!nvenc_udu_sei_truncated(sei->payload, sei->payloadSize, pmax)) {
                 ctx->sei_data[kept++] = *sei;
                 continue;
             }
@@ -2885,7 +2834,7 @@ static int prepare_sei_data_array(AVCodecContext *avctx, const AVFrame *frame)
     /* The A/53 and timecode SEI above come out of the same budget. */
     if (avctx->codec->id == AV_CODEC_ID_HEVC) {
         for (i = 0; i < sei_count; i++)
-            sei_budget -= FFMIN(sei_budget, nvenc_sei_nal_size(&ctx->sei_data[i], sei_budget));
+            sei_budget -= FFMIN(sei_budget, nvenc_sei_payload_nal_size(&ctx->sei_data[i], sei_budget));
     }
 
     udu_first = sei_count;
diff --git a/libavcodec/nvenc_sei.h b/libavcodec/nvenc_sei.h
new file mode 100644
index 0000000000000000000000000000000000000000..de76d02d231673e70f5fc323bf5e9d5dde12eac9
--- /dev/null
+++ b/libavcodec/nvenc_sei.h
@@ -0,0 +1,91 @@
