+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Sizes of the SEI that NVENC writes for payloads passed in
+ * seiPayloadArray. Plain C without libav* or NVENC headers, so that code
+ * which prepares SEI payloads outside libavcodec can apply the same limits.
+ */
+
+#ifndef AVCODEC_NVENC_SEI_H
+#define AVCODEC_NVENC_SEI_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* hevc_nvenc fails nvEncLockBitstream() with NV_ENC_ERR_OUT_OF_MEMORY when the
+ * non-VCL NAL units of one picture, VPS, SPS, PPS, access unit delimiter and
+ * every SEI in Annex B form, exceed 1024 bytes. The SEI passed in
+ * seiPayloadArray get what is left after 256 bytes for the NAL units the
+ * encoder writes on its own (at most 128 bytes measured, plus the HDR and
+ * 3D reference display SEI it builds from the picture parameters). */
+#define NVENC_HEVC_NON_VCL_LIMIT 1024
+#define NVENC_HEVC_SEI_RESERVE   256
+#define NVENC_HEVC_SEI_BUDGET    (NVENC_HEVC_NON_VCL_LIMIT - NVENC_HEVC_SEI_RESERVE)
+
+/* Emulation prevention bytes size bytes of payload p need, after zeros zero
+ * bytes. */
+static inline size_t nvenc_sei_epb_count(const uint8_t *p, uint32_t size, int zeros)
+{
+    size_t epb = 0;
+
+    for (uint32_t i = 0; i < size; i++) {
+        if (zeros >= 2 && p[i] <= 3) {
+            epb++;
+            zeros = 0;
+        }
+        zeros = p[i] ? 0 : zeros + 1;
+    }
+    return epb;
+}
+
+/* Annex B size of the SEI NAL unit NVENC writes for one payload of the given
+ * type and size: start code, NAL unit header, payload type and size, the
+ * payload with its emulation prevention bytes and the trailing bits, plus one
+ * byte for emulation prevention across the size and payload boundary. The
+ * payload is scanned only when the rest fits into limit. */
+static inline size_t nvenc_sei_nal_size(const uint8_t *p, uint32_t type,
+                                        uint32_t size, size_t limit)
+{
+    size_t nal = 4 + 2 + type / 255 + 1 + size / 255 + 1 + (size_t)size + 1 + 1;
+
+    if (nal > limit)
+        return nal;
+
+    return nal + nvenc_sei_epb_count(p, size, 0);
+}
+
+/* NVENC escapes the user data unregistered SEI of a picture into a buffer of
+ * 4/3 of the largest payload of the picture plus 5 bytes. A payload whose
+ * emulation prevention bytes do not fit is written truncated, without its end
+ * and trailing bits, and decoders discard the NAL unit. Only a payload that
+ * needs more emulation prevention bytes than about a third of its size, as
+ * long runs of zero bytes do, can overflow it. Measured with driver
+ * 615.78.08 for h264_nvenc and hevc_nvenc. pmax is the size of the largest
+ * user data unregistered payload of the picture. */
+static inline int nvenc_udu_sei_truncated(const uint8_t *p, uint32_t size, uint32_t pmax)
+{
+    /* The last payload size byte is zero when the size is a multiple of 255. */
+    size_t epb  = nvenc_sei_epb_count(p, size, !(size % 255));
+    size_t room = 4 * ((size_t)pmax + 5) / 3;
+
+    return size + 3 + epb > room;
+}
+
+#endif /* AVCODEC_NVENC_SEI_H */
