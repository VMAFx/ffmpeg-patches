 fate-filter-bt2408-hable: CMD = run libavfilter/tests/bt2408_hable$(EXESUF)
 
+FATE_FILTER-$(CONFIG_ZSCALE_FILTER) += fate-filter-zscale-light-levels
+fate-filter-zscale-light-levels: libavfilter/tests/zscale_light_levels$(EXESUF)
+fate-filter-zscale-light-levels: CMD = run libavfilter/tests/zscale_light_levels$(EXESUF)
+
 FATE_FILTER-$(CONFIG_TONEMAP_FILTER) += fate-filter-tonemap-bt2408-hable
 fate-filter-tonemap-bt2408-hable: libavfilter/tests/bt2408_hable$(EXESUF)
 fate-filter-tonemap-bt2408-hable: CMD = run libavfilter/tests/bt2408_hable$(EXESUF) filter
diff --git a/tests/ref/fate/filter-zscale-light-levels b/tests/ref/fate/filter-zscale-light-levels
new file mode 100644
index 0000000000000000000000000000000000000000..a58aa5c7961d825cdf748b7485ea50db4317befa
--- /dev/null
+++ b/tests/ref/fate/filter-zscale-light-levels
@@ -0,0 +1,4 @@
+t=linear: light level kept, mastering display kept, ICC profile dropped
+t=linear:p=bt709: light level dropped, mastering display dropped, ICC profile dropped
+t=bt709: light level dropped, mastering display dropped, ICC profile dropped
+w=8:h=4: light level kept, mastering display kept, ICC profile kept
