+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* Which colour-dependent side data zscale keeps on a transfer change. */
+
+#include <stdio.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/log.h"
+#include "libavutil/mastering_display_metadata.h"
+
+#include "libavfilter/avfilter.h"
+#include "libavfilter/buffersink.h"
+#include "libavfilter/buffersrc.h"
+
+#define FW 16
+#define FH 8
+
+/* Runs buffer -> zscale=<args> -> buffersink on one frame. */
+static int run_filter(AVFrame *in, AVFrame *out, const char *zargs)
+{
+    AVFilterGraph *g = avfilter_graph_alloc();
+    AVFilterContext *src = NULL, *zs = NULL, *sink = NULL;
+    char args[128];
+    int ret;
+
+    if (!g)
+        return AVERROR(ENOMEM);
+    snprintf(args, sizeof(args), "video_size=%dx%d:pix_fmt=%d:time_base=1/25:colorspace=%d",
+             in->width, in->height, in->format, in->colorspace);
+    ret = avfilter_graph_create_filter(&src, avfilter_get_by_name("buffer"), "in", args, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_graph_create_filter(&zs, avfilter_get_by_name("zscale"), "zs", zargs, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_graph_create_filter(&sink, avfilter_get_by_name("buffersink"), "out", NULL, NULL, g);
+    if (ret >= 0)
+        ret = avfilter_link(src, 0, zs, 0);
+    if (ret >= 0)
+        ret = avfilter_link(zs, 0, sink, 0);
+    if (ret >= 0)
+        ret = avfilter_graph_config(g, NULL);
+    if (ret >= 0)
+        ret = av_buffersrc_add_frame_flags(src, in, AV_BUFFERSRC_FLAG_KEEP_REF);
+    if (ret >= 0)
+        ret = av_buffersrc_add_frame(src, NULL);
+    if (ret >= 0)
+        ret = av_buffersink_get_frame(sink, out);
+    avfilter_graph_free(&g);
+    return ret;
+}
+
+static int add_side_data(AVFrame *f)
+{
+    AVContentLightMetadata *cll = av_content_light_metadata_create_side_data(f);
+    AVMasteringDisplayMetadata *md = av_mastering_display_metadata_create_side_data(f);
+
+    if (!cll || !md || !av_frame_new_side_data(f, AV_FRAME_DATA_ICC_PROFILE, 16))
+        return AVERROR(ENOMEM);
+    cll->MaxCLL = 1000;
+    md->max_luminance = av_make_q(1000, 1);
+    md->min_luminance = av_make_q(1, 10000);
+    md->has_luminance = 1;
+    return 0;
+}
+
+/* A PQ BT.2020 frame with light levels and an ICC profile. */
+static AVFrame *make_frame(void)
+{
+    AVFrame *f = av_frame_alloc();
+
+    if (!f)
+        return NULL;
+    f->format = AV_PIX_FMT_GBRPF32;
+    f->width  = FW;
+    f->height = FH;
+    f->color_primaries = AVCOL_PRI_BT2020;
+    f->color_trc       = AVCOL_TRC_SMPTE2084;
+    f->colorspace      = AVCOL_SPC_RGB;
+    if (av_frame_get_buffer(f, 0) < 0 || add_side_data(f) < 0) {
+        av_frame_free(&f);
+        return NULL;
+    }
+    for (int p = 0; p < 3; p++)
+        for (int y = 0; y < FH; y++)
+            for (int x = 0; x < FW; x++)
+                ((float *)(f->data[p] + y * f->linesize[p]))[x] = 0.5f;
+    return f;
+}
+
+static const char *has(const AVFrame *f, enum AVFrameSideDataType type)
+{
+    return av_frame_get_side_data(f, type) ? "kept" : "dropped";
+}
+
+/* Prints which side data survive zscale=<zargs>; returns 0 when the run worked. */
+static int report(const char *zargs)
+{
+    AVFrame *in = make_frame(), *out = av_frame_alloc();
+    int ret = in && out ? run_filter(in, out, zargs) : AVERROR(ENOMEM);
+
+    if (ret >= 0)
+        printf("%s: light level %s, mastering display %s, ICC profile %s\n", zargs,
+               has(out, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL),
+               has(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA),
+               has(out, AV_FRAME_DATA_ICC_PROFILE));
+    else
+        printf("%s: failed\n", zargs);
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return ret < 0;
+}
+
+int main(void)
+{
+    int fails = 0;
+
+    av_log_set_level(AV_LOG_QUIET);
+    fails += report("t=linear");
+    fails += report("t=linear:p=bt709");
+    fails += report("t=bt709");
+    fails += report("w=8:h=4");
+    return fails != 0;
+}
diff --git a/libavfilter/vf_zscale.c b/libavfilter/vf_zscale.c
index b14d704663abe76de9f12124fa60d7a8a2eec4ee..80216c0f1925d67eab4ed747847bf159d5c68230 100644
--- a/libavfilter/vf_zscale.c
+++ b/libavfilter/vf_zscale.c
@@ -745,6 +745,42 @@ static int filter_slice(AVFilterContext *ctx, void *data, int job_nr, int n_jobs
     return 0;
 }
 
+/*
+ * Linear light in the same primaries keeps the light levels of its source, so
+ * a tone mapper further down can still read the peak from them.
+ */
+static void remove_color_dependent_keep_light(AVFrame *out)
+{
+    for (int i = out->nb_side_data - 1; i >= 0; i--) {
+        const AVSideDataDescriptor *desc;
+        enum AVFrameSideDataType type;
+
+        if (i >= out->nb_side_data)
+            continue;
+        type = out->side_data[i]->type;
+        desc = av_frame_side_data_desc(type);
+        if (type == AV_FRAME_DATA_CONTENT_LIGHT_LEVEL ||
+            type == AV_FRAME_DATA_MASTERING_DISPLAY_METADATA)
+            continue;
+        if (desc && desc->props & AV_SIDE_DATA_PROP_COLOR_DEPENDENT)
+            av_frame_side_data_remove(&out->side_data, &out->nb_side_data, type);
+    }
+}
+
+static void prune_side_data(AVFrame *out, const AVFrame *in)
+{
+    int changed = 0;
+
+    if (out->width != in->width || out->height != in->height)
+        changed |= AV_SIDE_DATA_PROP_SIZE_DEPENDENT;
+    if (out->color_trc != in->color_trc && out->color_trc == AVCOL_TRC_LINEAR &&
+        out->color_primaries == in->color_primaries)
+        remove_color_dependent_keep_light(out);
+    else if (out->color_trc != in->color_trc || out->color_primaries != in->color_primaries)
+        changed |= AV_SIDE_DATA_PROP_COLOR_DEPENDENT;
+    av_frame_side_data_remove_by_props(&out->side_data, &out->nb_side_data, changed);
+}
+
 static int filter_frame(AVFilterLink *link, AVFrame *in)
 {
     AVFilterContext *ctx = link->dst;
@@ -753,7 +789,7 @@ static int filter_frame(AVFilterLink *link, AVFrame *in)
     const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(link->format);
     const AVPixFmtDescriptor *odesc = av_pix_fmt_desc_get(outlink->format);
     char buf[32];
-    int ret = 0, changed = 0;
+    int ret = 0;
     AVFrame *out = NULL;
     ThreadData td;
 
@@ -827,11 +863,7 @@ static int filter_frame(AVFilterLink *link, AVFrame *in)
                   (int64_t)in->sample_aspect_ratio.den * outlink->w * link->h,
                   INT_MAX);
 
-        if (out->width != in->width || out->height != in->height)
-            changed |= AV_SIDE_DATA_PROP_SIZE_DEPENDENT;
-        if (out->color_trc != in->color_trc || out->color_primaries != in->color_primaries)
-            changed |= AV_SIDE_DATA_PROP_COLOR_DEPENDENT;
-        av_frame_side_data_remove_by_props(&out->side_data, &out->nb_side_data, changed);
+        prune_side_data(out, in);
 
         td.in = in;
         td.out = out;
