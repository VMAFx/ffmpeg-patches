+#include "hqdn3d_coefs.h"
+
+typedef struct HQDN3DOpenCLContext {
+    OpenCLFilterContext ocf;
+
+    int initialised;
+    cl_kernel kernel_horiz_planar;
+    cl_kernel kernel_horiz_semiplanar;
+    cl_kernel kernel_vert_planar;
+    cl_kernel kernel_vert_semiplanar;
+    cl_command_queue command_queue;
+
+    cl_mem tables_buf;
+    cl_mem h_buf;
+    cl_mem frame_ant_buf;
+
+    double strength[4];
+
+    int hsub, vsub;
+    int depth;
+    int is_msb;
+    int is_semiplanar;
+    int width, height;
+    enum AVPixelFormat sw_format;
+
+    int spatial_enabled[2];
+    int first_frame;
+
+    AVBufferRef *out_frames_ref;
+} HQDN3DOpenCLContext;
+
+static int validate_format(AVFilterContext *ctx, enum AVPixelFormat sw_format,
+                           int *depth, int *is_msb, int *is_semiplanar)
+{
+    switch (sw_format) {
+    case AV_PIX_FMT_YUV420P:
+    case AV_PIX_FMT_YUV422P:
+    case AV_PIX_FMT_YUV444P:
+        *depth = 8;
+        *is_msb = 0;
+        *is_semiplanar = 0;
+        return 0;
+    case AV_PIX_FMT_YUV420P16:
+    case AV_PIX_FMT_YUV444P16:
+        *depth = 16;
+        *is_msb = 0;
+        *is_semiplanar = 0;
+        return 0;
+    case AV_PIX_FMT_NV12:
+        *depth = 8;
+        *is_msb = 0;
+        *is_semiplanar = 1;
+        return 0;
+    case AV_PIX_FMT_P010:
+        *depth = 10;
+        *is_msb = 1;
+        *is_semiplanar = 1;
+        return 0;
+    case AV_PIX_FMT_P012:
+        *depth = 12;
+        *is_msb = 1;
+        *is_semiplanar = 1;
+        return 0;
+    case AV_PIX_FMT_P016:
+        *depth = 16;
+        *is_msb = 1;
+        *is_semiplanar = 1;
+        return 0;
+    default:
+        av_log(ctx, AV_LOG_ERROR, "Unsupported sw_format: %s\n",
+               av_get_pix_fmt_name(sw_format));
+        return AVERROR(ENOSYS);
+    }
+}
+
+#define OFFSET(x) offsetof(HQDN3DOpenCLContext, x)
+#define FLAGS AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_RUNTIME_PARAM
+
+static const AVOption hqdn3d_opencl_options[] = {
+    { "luma_spatial",   "spatial luma strength",    OFFSET(strength[LUMA_SPATIAL]),   AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "chroma_spatial", "spatial chroma strength",  OFFSET(strength[CHROMA_SPATIAL]), AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "luma_tmp",       "temporal luma strength",   OFFSET(strength[LUMA_TMP]),       AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "chroma_tmp",     "temporal chroma strength", OFFSET(strength[CHROMA_TMP]),     AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(hqdn3d_opencl);
+
+static av_cold int hqdn3d_opencl_init(AVFilterContext *ctx)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+
+    ff_opencl_filter_init(ctx);
+    s->out_frames_ref = NULL;
+    ff_hqdn3d_default_strengths(s->strength);
+
+    av_log(ctx, AV_LOG_VERBOSE, "ls:%f cs:%f lt:%f ct:%f\n",
+           s->strength[LUMA_SPATIAL], s->strength[CHROMA_SPATIAL],
+           s->strength[LUMA_TMP], s->strength[CHROMA_TMP]);
+
+    return 0;
+}
+
+static void free_buffers(AVFilterContext *ctx)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+
+    if (s->tables_buf) {
+        clReleaseMemObject(s->tables_buf);
+        s->tables_buf = NULL;
+    }
+    if (s->h_buf) {
+        clReleaseMemObject(s->h_buf);
+        s->h_buf = NULL;
+    }
+    if (s->frame_ant_buf) {
+        clReleaseMemObject(s->frame_ant_buf);
+        s->frame_ant_buf = NULL;
+    }
+}
+
+static void release_kernels(HQDN3DOpenCLContext *s)
+{
+    if (s->kernel_horiz_planar) {
+        clReleaseKernel(s->kernel_horiz_planar);
+        s->kernel_horiz_planar = NULL;
+    }
+    if (s->kernel_horiz_semiplanar) {
+        clReleaseKernel(s->kernel_horiz_semiplanar);
+        s->kernel_horiz_semiplanar = NULL;
+    }
+    if (s->kernel_vert_planar) {
+        clReleaseKernel(s->kernel_vert_planar);
+        s->kernel_vert_planar = NULL;
+    }
+    if (s->kernel_vert_semiplanar) {
+        clReleaseKernel(s->kernel_vert_semiplanar);
+        s->kernel_vert_semiplanar = NULL;
+    }
+}
+
+static av_cold void hqdn3d_opencl_uninit(AVFilterContext *ctx)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+
+    release_kernels(s);
+    if (s->command_queue) {
+        clReleaseCommandQueue(s->command_queue);
+        s->command_queue = NULL;
+    }
+    free_buffers(ctx);
+    av_buffer_unref(&s->out_frames_ref);
+    ff_opencl_filter_uninit(ctx);
+    s->initialised = 0;
+}
+
+static int init_buffers(AVFilterContext *ctx, int w, int h)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    cl_context clctx = s->ocf.hwctx->context;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    size_t tables_sz = (size_t)4 * (512 << lut_bits) * sizeof(int16_t);
+    int cw = AV_CEIL_RSHIFT(w, s->hsub);
+    int ch = AV_CEIL_RSHIFT(h, s->vsub);
+    size_t samples = (size_t)w * h + (size_t)2 * cw * ch;
+    size_t data_sz = samples * sizeof(uint16_t);
+    cl_int cle;
+
+    s->tables_buf = clCreateBuffer(clctx, CL_MEM_READ_ONLY, tables_sz, NULL, &cle);
+    if (cle != CL_SUCCESS)
+        return AVERROR(EIO);
+
+    s->h_buf = clCreateBuffer(clctx, CL_MEM_READ_WRITE, data_sz, NULL, &cle);
+    if (cle != CL_SUCCESS) {
+        free_buffers(ctx);
+        return AVERROR(EIO);
+    }
+
+    s->frame_ant_buf = clCreateBuffer(clctx, CL_MEM_READ_WRITE, data_sz, NULL, &cle);
+    if (cle != CL_SUCCESS) {
+        free_buffers(ctx);
+        return AVERROR(EIO);
+    }
+
+    return 0;
+}
+
+static int calc_coefs(AVFilterContext *ctx)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    size_t tables_sz = (size_t)4 * table_entries * sizeof(int16_t);
+    int16_t *tables = av_malloc(tables_sz);
+    cl_int cle;
+
+    if (!tables)
+        return AVERROR(ENOMEM);
+
+    for (int i = 0; i < 4; i++) {
+        int16_t *ct = tables + i * table_entries;
+        ff_hqdn3d_precalc_coefs(s->strength[i], s->depth, ct);
+    }
+
+    s->spatial_enabled[0] = s->strength[LUMA_SPATIAL] != 0.0;
+    s->spatial_enabled[1] = s->strength[CHROMA_SPATIAL] != 0.0;
+
+    cle = clEnqueueWriteBuffer(s->command_queue, s->tables_buf, CL_TRUE,
+                               0, tables_sz, tables, 0, NULL, NULL);
+    av_free(tables);
+    if (cle != CL_SUCCESS) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to write tables buffer: %d\n", cle);
+        return AVERROR(EIO);
+    }
+    return 0;
+}
+
+static int create_out_frames_ctx(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    AVHWFramesContext *in_hwfc = (AVHWFramesContext *)in->hw_frames_ctx->data;
+    AVHWFramesContext *frames_ctx;
+    AVBufferRef *device_ref = in_hwfc->device_ref ? in_hwfc->device_ref : s->ocf.device_ref;
+    int err;
+
+    if (!device_ref)
+        return AVERROR(EINVAL);
+
+    av_buffer_unref(&s->out_frames_ref);
+
+    s->out_frames_ref = av_hwframe_ctx_alloc(device_ref);
+    if (!s->out_frames_ref)
+        return AVERROR(ENOMEM);
+
+    frames_ctx = (AVHWFramesContext *)s->out_frames_ref->data;
+    frames_ctx->format    = AV_PIX_FMT_OPENCL;
+    frames_ctx->sw_format = in_hwfc->sw_format;
+    frames_ctx->width     = in->width;
+    frames_ctx->height    = in->height;
+
+    err = av_hwframe_ctx_init(s->out_frames_ref);
+    if (err < 0) {
+        av_buffer_unref(&s->out_frames_ref);
+        return err;
+    }
+
+    ctx->outputs[0]->w = in->width;
+    ctx->outputs[0]->h = in->height;
+    return 0;
+}
+
+static AVFrame *alloc_output_frame(HQDN3DOpenCLContext *s, AVFilterLink *outlink, AVFrame *in)
+{
+    AVFrame *out;
+    int err;
+
+    if (s->out_frames_ref) {
+        out = av_frame_alloc();
+        if (!out)
+            return NULL;
+        err = av_hwframe_get_buffer(s->out_frames_ref, out, 0);
+        if (err < 0) {
+            av_frame_free(&out);
+            return NULL;
+        }
+    } else {
+        out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+        if (!out)
+            return NULL;
+    }
+
+    if (av_frame_copy_props(out, in) < 0) {
+        av_frame_free(&out);
+        return NULL;
+    }
+    return out;
+}
+
+static int init_opencl_program(AVFilterContext *ctx)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    cl_int cle;
+    int err;
+
+    err = ff_opencl_filter_load_program(ctx, &ff_source_hqdn3d_cl, 1);
+    if (err < 0)
+        return err;
+
+    s->command_queue = clCreateCommandQueue(s->ocf.hwctx->context,
+                                            s->ocf.hwctx->device_id,
+                                            0, &cle);
+    if (cle != CL_SUCCESS) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create command queue: %d\n", cle);
+        return AVERROR(EIO);
+    }
+    return 0;
+}
+
+static int create_opencl_kernels(AVFilterContext *ctx)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    cl_program prog = s->ocf.program;
+    cl_int cle;
+
+    s->kernel_horiz_planar = clCreateKernel(prog, "hqdn3d_horizontal_planar", &cle);
+    if (cle != CL_SUCCESS)
+        return AVERROR(EIO);
+
+    s->kernel_horiz_semiplanar = clCreateKernel(prog, "hqdn3d_horizontal_semiplanar", &cle);
+    if (cle != CL_SUCCESS)
+        return AVERROR(EIO);
+
+    s->kernel_vert_planar = clCreateKernel(prog, "hqdn3d_vertical_planar", &cle);
+    if (cle != CL_SUCCESS)
+        return AVERROR(EIO);
+
+    s->kernel_vert_semiplanar = clCreateKernel(prog, "hqdn3d_vertical_semiplanar", &cle);
+    if (cle != CL_SUCCESS)
+        return AVERROR(EIO);
+
+    return 0;
+}
+
+static int check_format_and_size(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    AVHWFramesContext *hwfc = (AVHWFramesContext *)in->hw_frames_ctx->data;
+    int err;
+
+    err = validate_format(ctx, hwfc->sw_format, &s->depth, &s->is_msb, &s->is_semiplanar);
+    if (err < 0)
+        return err;
+
+    if (in->width != s->width || in->height != s->height || hwfc->sw_format != s->sw_format) {
+        s->hsub = av_pix_fmt_desc_get(hwfc->sw_format)->log2_chroma_w;
+        s->vsub = av_pix_fmt_desc_get(hwfc->sw_format)->log2_chroma_h;
+        if (s->width != 0) {
+            free_buffers(ctx);
+            err = init_buffers(ctx, in->width, in->height);
+            if (err < 0)
+                return err;
+            err = calc_coefs(ctx);
+            if (err < 0)
+                return err;
+            err = create_out_frames_ctx(ctx, in);
+            if (err < 0)
+                return err;
+            s->first_frame = 1;
+        }
+        s->sw_format = hwfc->sw_format;
+        s->width = in->width;
+        s->height = in->height;
+    }
+    return 0;
+}
+
+static int init_filter(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    int err;
+
+    err = init_buffers(ctx, in->width, in->height);
+    if (err < 0)
+        return err;
+
+    err = calc_coefs(ctx);
+    if (err < 0) {
+        free_buffers(ctx);
+        return err;
+    }
+
+    s->first_frame = 1;
+    return 0;
+}
+
+static int set_arg(cl_kernel k, cl_uint idx, size_t sz, const void *ptr)
+{
+    cl_int cle = clSetKernelArg(k, idx, sz, ptr);
+    if (cle != CL_SUCCESS)
+        return AVERROR(EIO);
+    return 0;
+}
+
+static int dispatch_horizontal_luma(AVFilterContext *ctx, AVFrame *in,
+                                    int lut_bits)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    cl_mem img = (cl_mem)in->data[0];
+    int h_offset = 0, spatial_offset = 0;
+    size_t gws[1];
+    int err;
+
+    gws[0] = s->height;
+    err = set_arg(s->kernel_horiz_planar, 0, sizeof(cl_mem), &img);
+    err |= set_arg(s->kernel_horiz_planar, 1, sizeof(cl_mem), &s->h_buf);
+    err |= set_arg(s->kernel_horiz_planar, 2, sizeof(int), &h_offset);
+    err |= set_arg(s->kernel_horiz_planar, 3, sizeof(cl_mem), &s->tables_buf);
+    err |= set_arg(s->kernel_horiz_planar, 4, sizeof(int), &spatial_offset);
+    err |= set_arg(s->kernel_horiz_planar, 5, sizeof(int), &s->width);
+    err |= set_arg(s->kernel_horiz_planar, 6, sizeof(int), &s->height);
+    err |= set_arg(s->kernel_horiz_planar, 7, sizeof(int), &s->depth);
+    err |= set_arg(s->kernel_horiz_planar, 8, sizeof(int), &lut_bits);
+    err |= set_arg(s->kernel_horiz_planar, 9, sizeof(int), &s->is_msb);
+    if (err < 0)
+        return AVERROR(EIO);
+
+    if (clEnqueueNDRangeKernel(s->command_queue, s->kernel_horiz_planar,
+                               1, NULL, gws, NULL, 0, NULL, NULL) != CL_SUCCESS)
+        return AVERROR(EIO);
+    return 0;
+}
+
+static int dispatch_horizontal_chroma_semi(AVFilterContext *ctx, AVFrame *in,
+                                           int cw, int ch, int off_u, int off_v,
+                                           int lut_bits, int spatial_offset)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    cl_mem img = (cl_mem)in->data[1];
+    size_t gws[1];
+    int err;
+
+    gws[0] = ch;
+    err = set_arg(s->kernel_horiz_semiplanar, 0, sizeof(cl_mem), &img);
+    err |= set_arg(s->kernel_horiz_semiplanar, 1, sizeof(cl_mem), &s->h_buf);
+    err |= set_arg(s->kernel_horiz_semiplanar, 2, sizeof(int), &off_u);
+    err |= set_arg(s->kernel_horiz_semiplanar, 3, sizeof(int), &off_v);
+    err |= set_arg(s->kernel_horiz_semiplanar, 4, sizeof(cl_mem), &s->tables_buf);
+    err |= set_arg(s->kernel_horiz_semiplanar, 5, sizeof(int), &spatial_offset);
+    err |= set_arg(s->kernel_horiz_semiplanar, 6, sizeof(int), &cw);
+    err |= set_arg(s->kernel_horiz_semiplanar, 7, sizeof(int), &ch);
+    err |= set_arg(s->kernel_horiz_semiplanar, 8, sizeof(int), &s->depth);
+    err |= set_arg(s->kernel_horiz_semiplanar, 9, sizeof(int), &lut_bits);
+    err |= set_arg(s->kernel_horiz_semiplanar, 10, sizeof(int), &s->is_msb);
+    if (err < 0)
+        return AVERROR(EIO);
+
+    if (clEnqueueNDRangeKernel(s->command_queue, s->kernel_horiz_semiplanar,
+                               1, NULL, gws, NULL, 0, NULL, NULL) != CL_SUCCESS)
+        return AVERROR(EIO);
+    return 0;
+}
+
+static int dispatch_horizontal_chroma_planar(AVFilterContext *ctx, AVFrame *in,
+                                             int cw, int ch, int off_u, int off_v,
+                                             int lut_bits, int spatial_offset)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    size_t gws[1];
+    int offs[2];
+
+    gws[0] = ch;
+    offs[0] = off_u;
+    offs[1] = off_v;
+    for (int p = 1; p <= 2; p++) {
+        cl_mem img = (cl_mem)in->data[p];
+        int err = set_arg(s->kernel_horiz_planar, 0, sizeof(cl_mem), &img);
+        err |= set_arg(s->kernel_horiz_planar, 1, sizeof(cl_mem), &s->h_buf);
+        err |= set_arg(s->kernel_horiz_planar, 2, sizeof(int), &offs[p - 1]);
+        err |= set_arg(s->kernel_horiz_planar, 3, sizeof(cl_mem), &s->tables_buf);
+        err |= set_arg(s->kernel_horiz_planar, 4, sizeof(int), &spatial_offset);
+        err |= set_arg(s->kernel_horiz_planar, 5, sizeof(int), &cw);
+        err |= set_arg(s->kernel_horiz_planar, 6, sizeof(int), &ch);
+        err |= set_arg(s->kernel_horiz_planar, 7, sizeof(int), &s->depth);
+        err |= set_arg(s->kernel_horiz_planar, 8, sizeof(int), &lut_bits);
+        err |= set_arg(s->kernel_horiz_planar, 9, sizeof(int), &s->is_msb);
+        if (err < 0)
+            return AVERROR(EIO);
+
+        if (clEnqueueNDRangeKernel(s->command_queue, s->kernel_horiz_planar,
+                                   1, NULL, gws, NULL, 0, NULL, NULL) != CL_SUCCESS)
+            return AVERROR(EIO);
+    }
+    return 0;
+}
+
+static int dispatch_horizontal(AVFilterContext *ctx, AVFrame *in)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    int cw = AV_CEIL_RSHIFT(s->width, s->hsub);
+    int ch = AV_CEIL_RSHIFT(s->height, s->vsub);
+    int off_u = s->width * s->height;
+    int off_v = off_u + cw * ch;
+    int spatial_offset = CHROMA_SPATIAL * table_entries;
+    int err;
+
+    if (s->spatial_enabled[0]) {
+        err = dispatch_horizontal_luma(ctx, in, lut_bits);
+        if (err < 0)
+            return err;
+    }
+    if (s->spatial_enabled[1]) {
+        if (s->is_semiplanar)
+            return dispatch_horizontal_chroma_semi(ctx, in, cw, ch, off_u, off_v,
+                                                   lut_bits, spatial_offset);
+        return dispatch_horizontal_chroma_planar(ctx, in, cw, ch, off_u, off_v,
+                                                 lut_bits, spatial_offset);
+    }
+    return 0;
+}
+
+static int dispatch_vertical_luma(AVFilterContext *ctx, AVFrame *in, AVFrame *out,
+                                  int lut_bits, int table_entries)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    cl_mem src = (cl_mem)in->data[0];
+    cl_mem dst = (cl_mem)out->data[0];
+    int h_offset = 0, fa_offset = 0;
+    int spatial_offset = LUMA_SPATIAL * table_entries;
+    int temporal_offset = LUMA_TMP * table_entries;
+    size_t gws[1];
+    int err;
+
+    gws[0] = s->width;
+    err = set_arg(s->kernel_vert_planar, 0, sizeof(cl_mem), &src);
+    err |= set_arg(s->kernel_vert_planar, 1, sizeof(cl_mem), &dst);
+    err |= set_arg(s->kernel_vert_planar, 2, sizeof(cl_mem), &s->h_buf);
+    err |= set_arg(s->kernel_vert_planar, 3, sizeof(int), &h_offset);
+    err |= set_arg(s->kernel_vert_planar, 4, sizeof(cl_mem), &s->frame_ant_buf);
+    err |= set_arg(s->kernel_vert_planar, 5, sizeof(int), &fa_offset);
+    err |= set_arg(s->kernel_vert_planar, 6, sizeof(cl_mem), &s->tables_buf);
+    err |= set_arg(s->kernel_vert_planar, 7, sizeof(int), &spatial_offset);
+    err |= set_arg(s->kernel_vert_planar, 8, sizeof(int), &temporal_offset);
+    err |= set_arg(s->kernel_vert_planar, 9, sizeof(int), &s->width);
+    err |= set_arg(s->kernel_vert_planar, 10, sizeof(int), &s->height);
+    err |= set_arg(s->kernel_vert_planar, 11, sizeof(int), &s->depth);
+    err |= set_arg(s->kernel_vert_planar, 12, sizeof(int), &lut_bits);
+    err |= set_arg(s->kernel_vert_planar, 13, sizeof(int), &s->is_msb);
+    err |= set_arg(s->kernel_vert_planar, 14, sizeof(int), &s->first_frame);
+    err |= set_arg(s->kernel_vert_planar, 15, sizeof(int), &s->spatial_enabled[0]);
+    if (err < 0)
+        return AVERROR(EIO);
+
+    if (clEnqueueNDRangeKernel(s->command_queue, s->kernel_vert_planar,
+                               1, NULL, gws, NULL, 0, NULL, NULL) != CL_SUCCESS)
+        return AVERROR(EIO);
+    return 0;
+}
+
+static int dispatch_vertical_chroma_semi(AVFilterContext *ctx, AVFrame *in, AVFrame *out,
+                                         int cw, int ch, int off_u, int off_v,
+                                         int lut_bits, int spatial_offset, int temporal_offset)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    cl_mem src = (cl_mem)in->data[1];
+    cl_mem dst = (cl_mem)out->data[1];
+    size_t gws[1];
+    int err;
+
+    gws[0] = cw;
+    err = set_arg(s->kernel_vert_semiplanar, 0, sizeof(cl_mem), &src);
+    err |= set_arg(s->kernel_vert_semiplanar, 1, sizeof(cl_mem), &dst);
+    err |= set_arg(s->kernel_vert_semiplanar, 2, sizeof(cl_mem), &s->h_buf);
+    err |= set_arg(s->kernel_vert_semiplanar, 3, sizeof(int), &off_u);
+    err |= set_arg(s->kernel_vert_semiplanar, 4, sizeof(int), &off_v);
+    err |= set_arg(s->kernel_vert_semiplanar, 5, sizeof(cl_mem), &s->frame_ant_buf);
+    err |= set_arg(s->kernel_vert_semiplanar, 6, sizeof(int), &off_u);
+    err |= set_arg(s->kernel_vert_semiplanar, 7, sizeof(int), &off_v);
+    err |= set_arg(s->kernel_vert_semiplanar, 8, sizeof(cl_mem), &s->tables_buf);
+    err |= set_arg(s->kernel_vert_semiplanar, 9, sizeof(int), &spatial_offset);
+    err |= set_arg(s->kernel_vert_semiplanar, 10, sizeof(int), &temporal_offset);
+    err |= set_arg(s->kernel_vert_semiplanar, 11, sizeof(int), &cw);
+    err |= set_arg(s->kernel_vert_semiplanar, 12, sizeof(int), &ch);
+    err |= set_arg(s->kernel_vert_semiplanar, 13, sizeof(int), &s->depth);
+    err |= set_arg(s->kernel_vert_semiplanar, 14, sizeof(int), &lut_bits);
+    err |= set_arg(s->kernel_vert_semiplanar, 15, sizeof(int), &s->is_msb);
+    err |= set_arg(s->kernel_vert_semiplanar, 16, sizeof(int), &s->first_frame);
+    err |= set_arg(s->kernel_vert_semiplanar, 17, sizeof(int), &s->spatial_enabled[1]);
+    if (err < 0)
+        return AVERROR(EIO);
+
+    if (clEnqueueNDRangeKernel(s->command_queue, s->kernel_vert_semiplanar,
+                               1, NULL, gws, NULL, 0, NULL, NULL) != CL_SUCCESS)
+        return AVERROR(EIO);
+    return 0;
+}
+
+static int dispatch_vertical_chroma_planar(AVFilterContext *ctx, AVFrame *in, AVFrame *out,
+                                           int cw, int ch, int off_u, int off_v,
+                                           int lut_bits, int spatial_offset, int temporal_offset)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    size_t gws[1];
+    int offs[2];
+
+    gws[0] = cw;
+    offs[0] = off_u;
+    offs[1] = off_v;
+    for (int p = 1; p <= 2; p++) {
+        cl_mem src = (cl_mem)in->data[p];
+        cl_mem dst = (cl_mem)out->data[p];
+        int err = set_arg(s->kernel_vert_planar, 0, sizeof(cl_mem), &src);
+        err |= set_arg(s->kernel_vert_planar, 1, sizeof(cl_mem), &dst);
+        err |= set_arg(s->kernel_vert_planar, 2, sizeof(cl_mem), &s->h_buf);
+        err |= set_arg(s->kernel_vert_planar, 3, sizeof(int), &offs[p - 1]);
+        err |= set_arg(s->kernel_vert_planar, 4, sizeof(cl_mem), &s->frame_ant_buf);
+        err |= set_arg(s->kernel_vert_planar, 5, sizeof(int), &offs[p - 1]);
+        err |= set_arg(s->kernel_vert_planar, 6, sizeof(cl_mem), &s->tables_buf);
+        err |= set_arg(s->kernel_vert_planar, 7, sizeof(int), &spatial_offset);
+        err |= set_arg(s->kernel_vert_planar, 8, sizeof(int), &temporal_offset);
+        err |= set_arg(s->kernel_vert_planar, 9, sizeof(int), &cw);
+        err |= set_arg(s->kernel_vert_planar, 10, sizeof(int), &ch);
+        err |= set_arg(s->kernel_vert_planar, 11, sizeof(int), &s->depth);
+        err |= set_arg(s->kernel_vert_planar, 12, sizeof(int), &lut_bits);
+        err |= set_arg(s->kernel_vert_planar, 13, sizeof(int), &s->is_msb);
+        err |= set_arg(s->kernel_vert_planar, 14, sizeof(int), &s->first_frame);
+        err |= set_arg(s->kernel_vert_planar, 15, sizeof(int), &s->spatial_enabled[1]);
+        if (err < 0)
+            return AVERROR(EIO);
+
+        if (clEnqueueNDRangeKernel(s->command_queue, s->kernel_vert_planar,
+                                   1, NULL, gws, NULL, 0, NULL, NULL) != CL_SUCCESS)
+            return AVERROR(EIO);
+    }
+    return 0;
+}
+
+static int dispatch_vertical(AVFilterContext *ctx, AVFrame *in, AVFrame *out)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    int lut_bits = HQDN3D_LUT_BITS(s->depth);
+    int table_entries = 512 << lut_bits;
+    int cw = AV_CEIL_RSHIFT(s->width, s->hsub);
+    int ch = AV_CEIL_RSHIFT(s->height, s->vsub);
+    int off_u = s->width * s->height;
+    int off_v = off_u + cw * ch;
+    int spatial_offset = CHROMA_SPATIAL * table_entries;
+    int temporal_offset = CHROMA_TMP * table_entries;
+    int err;
+
+    err = dispatch_vertical_luma(ctx, in, out, lut_bits, table_entries);
+    if (err < 0)
+        return err;
+
+    if (s->is_semiplanar)
+        return dispatch_vertical_chroma_semi(ctx, in, out, cw, ch, off_u, off_v,
+                                             lut_bits, spatial_offset, temporal_offset);
+    return dispatch_vertical_chroma_planar(ctx, in, out, cw, ch, off_u, off_v,
+                                           lut_bits, spatial_offset, temporal_offset);
+}
+
+static int hqdn3d_opencl_filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *ctx = inlink->dst;
+    HQDN3DOpenCLContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    AVFrame *out = NULL;
+    int err;
+
+    err = check_format_and_size(ctx, in);
+    if (err < 0) {
+        av_frame_free(&in);
+        return err;
+    }
+
+    if (!s->tables_buf) {
+        err = init_filter(ctx, in);
+        if (err < 0) {
+            av_frame_free(&in);
+            return err;
+        }
+    }
+
+    out = alloc_output_frame(s, outlink, in);
+    if (!out) {
+        av_frame_free(&in);
+        return AVERROR(ENOMEM);
+    }
+
+    err = dispatch_horizontal(ctx, in);
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    err = dispatch_vertical(ctx, in, out);
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    if (clFinish(s->command_queue) != CL_SUCCESS) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return AVERROR(EIO);
+    }
+    s->first_frame = 0;
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+}
+
+static int hqdn3d_opencl_config_props(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    HQDN3DOpenCLContext *s = ctx->priv;
+    int err;
+
+    err = ff_opencl_filter_config_output(outlink);
+    if (err < 0)
+        return err;
+
+    if (!s->initialised) {
+        err = init_opencl_program(ctx);
+        if (err < 0)
+            return err;
+        err = create_opencl_kernels(ctx);
+        if (err < 0)
+            return err;
+        s->initialised = 1;
+    }
+
+    free_buffers(ctx);
+    av_buffer_unref(&s->out_frames_ref);
+    s->width = 0;
+    s->height = 0;
+    s->sw_format = AV_PIX_FMT_NONE;
+    s->first_frame = 1;
+
+    return 0;
+}
+
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    HQDN3DOpenCLContext *s = ctx->priv;
+    int ret;
+
+    ret = ff_filter_process_command(ctx, cmd, args, res, res_len, flags);
+    if (ret < 0)
+        return ret;
+
+    if (s->tables_buf)
+        return calc_coefs(ctx);
+
+    return 0;
+}
+
+static const AVFilterPad hqdn3d_opencl_inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = &hqdn3d_opencl_filter_frame,
+        .config_props = &ff_opencl_filter_config_input,
+    },
+};
+
+static const AVFilterPad hqdn3d_opencl_outputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = &hqdn3d_opencl_config_props,
+    },
+};
+
+const FFFilter ff_vf_hqdn3d_opencl = {
+    .p.name         = "hqdn3d_opencl",
+    .p.description  = NULL_IF_CONFIG_SMALL("Apply high quality 3d denoise filter using OpenCL"),
+    .p.priv_class   = &hqdn3d_opencl_class,
+    .p.flags        = AVFILTER_FLAG_HWDEVICE,
+    .priv_size      = sizeof(HQDN3DOpenCLContext),
+    .init           = &hqdn3d_opencl_init,
+    .uninit         = &hqdn3d_opencl_uninit,
+    FILTER_INPUTS(hqdn3d_opencl_inputs),
+    FILTER_OUTPUTS(hqdn3d_opencl_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_OPENCL),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+    .process_command = &process_command,
+};
