+#define CL_TARGET_OPENCL_VERSION 120
+#include "opencl.h"
+#include "opencl_source.h"
+
+#include <float.h>
+#include <stdint.h>
+#include "libavutil/avassert.h"
+#include "libavutil/common.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
