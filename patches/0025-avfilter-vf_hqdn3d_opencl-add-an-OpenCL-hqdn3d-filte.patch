+
+const sampler_t sampler = (CLK_NORMALIZED_COORDS_FALSE |
+                           CLK_ADDRESS_CLAMP_TO_EDGE   |
+                           CLK_FILTER_NEAREST);
+
+static inline uint load_sample(uint raw, uint s_depth, uint s_msb)
+{
+    uint shift = 16u - s_depth;
+    uint sample_val = (s_msb != 0u) ? (raw >> shift) : raw;
+    uint rounding = (shift > 0u) ? (((1u << shift) - 1u) >> 1u) : 0u;
+    return (sample_val << shift) + rounding;
+}
+
+static inline uint store_sample(uint val, uint s_depth, uint s_msb)
+{
+    uint shift = 16u - s_depth;
+    uint stored = val >> shift;
+    if (s_msb != 0u) {
+        uint max_val = (1u << s_depth) - 1u;
+        if (stored > max_val)
+            stored = max_val;
+        return stored << shift;
+    }
+    return stored;
+}
+
+static inline int lowpass(int prev_val, int cur_val,
+                          __global const short *coef_tables,
+                          int t_offset,
+                          int l_bits)
+{
+    int d = (prev_val - cur_val) >> (8 - l_bits);
+    int center = 256 << l_bits;
+    int idx = t_offset + center + d;
+    int coef = (int)coef_tables[idx];
+    return cur_val + coef;
+}
+
+__kernel void hqdn3d_horizontal_planar(
+    __read_only image2d_t in_img,
+    __global ushort *h_data, int h_offset,
+    __global const short *coef_tables, int spatial_offset,
+    int width, int height,
+    int depth, int lut_bits, int is_msb)
+{
+    int y = get_global_id(0);
+    float max_norm = (depth <= 8) ? 255.0f : 65535.0f;
+    int h_row_start = h_offset + y * width;
+    uint raw0, pixel_ant;
+
+    if (y >= height)
+        return;
+
+    raw0 = (uint)convert_int_rte(read_imagef(in_img, sampler, (int2)(0, y)).x * max_norm);
+    pixel_ant = load_sample(raw0, depth, is_msb);
+
+    if (y == 0) {
+        for (int x = 0; x < width; x++) {
+            uint raw = (uint)convert_int_rte(read_imagef(in_img, sampler, (int2)(x, 0)).x * max_norm);
+            uint cur = load_sample(raw, depth, is_msb);
+            pixel_ant = (uint)lowpass((int)pixel_ant, (int)cur, coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_start + x] = (ushort)pixel_ant;
+        }
+    } else {
+        h_data[h_row_start + 0] = (ushort)pixel_ant;
+        for (int x = 0; x + 1 < width; x++) {
+            uint raw = (uint)convert_int_rte(read_imagef(in_img, sampler, (int2)(x + 1, y)).x * max_norm);
+            uint cur = load_sample(raw, depth, is_msb);
+            pixel_ant = (uint)lowpass((int)pixel_ant, (int)cur, coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_start + x + 1] = (ushort)pixel_ant;
+        }
+    }
+}
+
+__kernel void hqdn3d_horizontal_semiplanar(
+    __read_only image2d_t in_img,
+    __global ushort *h_data, int h_offset_u, int h_offset_v,
+    __global const short *coef_tables, int spatial_offset,
+    int width, int height,
+    int depth, int lut_bits, int is_msb)
+{
+    int y = get_global_id(0);
+    float max_norm = (depth <= 8) ? 255.0f : 65535.0f;
+    int h_row_u = h_offset_u + y * width;
+    int h_row_v = h_offset_v + y * width;
+    float4 raw0;
+    uint pixel_ant_u, pixel_ant_v;
+
+    if (y >= height)
+        return;
+
+    raw0 = read_imagef(in_img, sampler, (int2)(0, y));
+    pixel_ant_u = load_sample((uint)convert_int_rte(raw0.x * max_norm), depth, is_msb);
+    pixel_ant_v = load_sample((uint)convert_int_rte(raw0.y * max_norm), depth, is_msb);
+
+    if (y == 0) {
+        for (int x = 0; x < width; x++) {
+            float4 raw = read_imagef(in_img, sampler, (int2)(x, 0));
+            uint cur_u = load_sample((uint)convert_int_rte(raw.x * max_norm), depth, is_msb);
+            uint cur_v = load_sample((uint)convert_int_rte(raw.y * max_norm), depth, is_msb);
+            pixel_ant_u = (uint)lowpass((int)pixel_ant_u, (int)cur_u, coef_tables, spatial_offset, lut_bits);
+            pixel_ant_v = (uint)lowpass((int)pixel_ant_v, (int)cur_v, coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_u + x] = (ushort)pixel_ant_u;
+            h_data[h_row_v + x] = (ushort)pixel_ant_v;
+        }
+    } else {
+        h_data[h_row_u + 0] = (ushort)pixel_ant_u;
+        h_data[h_row_v + 0] = (ushort)pixel_ant_v;
+        for (int x = 0; x + 1 < width; x++) {
+            float4 raw = read_imagef(in_img, sampler, (int2)(x + 1, y));
+            uint cur_u = load_sample((uint)convert_int_rte(raw.x * max_norm), depth, is_msb);
+            uint cur_v = load_sample((uint)convert_int_rte(raw.y * max_norm), depth, is_msb);
+            pixel_ant_u = (uint)lowpass((int)pixel_ant_u, (int)cur_u, coef_tables, spatial_offset, lut_bits);
+            pixel_ant_v = (uint)lowpass((int)pixel_ant_v, (int)cur_v, coef_tables, spatial_offset, lut_bits);
+            h_data[h_row_u + x + 1] = (ushort)pixel_ant_u;
+            h_data[h_row_v + x + 1] = (ushort)pixel_ant_v;
+        }
+    }
+}
+
+static void vertical_planar_temporal(
+    __read_only image2d_t in_img,
+    __write_only image2d_t out_img,
+    __global ushort *frame_ant_data, int fa_offset,
+    __global const short *coef_tables, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame, float max_norm)
+{
+    for (int y = 0; y < height; y++) {
+        uint raw = (uint)convert_int_rte(read_imagef(in_img, sampler, (int2)(x, y)).x * max_norm);
+        int cur = (int)load_sample(raw, depth, is_msb);
+        int fa_idx = fa_offset + y * width + x;
+        int prev_ant = first_frame ? cur : (int)frame_ant_data[fa_idx];
+        int tmp = lowpass(prev_ant, cur, coef_tables, temporal_offset, lut_bits);
+        uint out_val = store_sample((uint)tmp, depth, is_msb);
+        frame_ant_data[fa_idx] = (ushort)tmp;
+        write_imagef(out_img, (int2)(x, y), (float4)((float)out_val / max_norm, 0.0f, 0.0f, 0.0f));
+    }
+}
+
+static void vertical_planar_spatial(
+    __read_only image2d_t in_img,
+    __write_only image2d_t out_img,
+    __global const ushort *h_data, int h_offset,
+    __global ushort *frame_ant_data, int fa_offset,
+    __global const short *coef_tables, int spatial_offset, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame, float max_norm)
+{
+    int line_ant = (int)h_data[h_offset + x];
+    for (int y = 0; y < height; y++) {
+        int spat_tmp = line_ant;
+        int fa_idx = fa_offset + y * width + x;
+        int prev_ant;
+        if (y > 0) {
+            int h_val = (int)h_data[h_offset + y * width + x];
+            spat_tmp = lowpass(line_ant, h_val, coef_tables, spatial_offset, lut_bits);
+            line_ant = (int)(ushort)spat_tmp;
+        }
+        if (first_frame) {
+            uint raw = (uint)convert_int_rte(read_imagef(in_img, sampler, (int2)(x, y)).x * max_norm);
+            prev_ant = (int)load_sample(raw, depth, is_msb);
+        } else {
+            prev_ant = (int)frame_ant_data[fa_idx];
+        }
+        int temp_tmp = lowpass(prev_ant, spat_tmp, coef_tables, temporal_offset, lut_bits);
+        uint out_val = store_sample((uint)temp_tmp, depth, is_msb);
+        frame_ant_data[fa_idx] = (ushort)temp_tmp;
+        write_imagef(out_img, (int2)(x, y), (float4)((float)out_val / max_norm, 0.0f, 0.0f, 0.0f));
+    }
+}
+
+__kernel void hqdn3d_vertical_planar(
+    __read_only image2d_t in_img,
+    __write_only image2d_t out_img,
+    __global const ushort *h_data, int h_offset,
+    __global ushort *frame_ant_data, int fa_offset,
+    __global const short *coef_tables, int spatial_offset, int temporal_offset,
+    int width, int height,
+    int depth, int lut_bits, int is_msb, int first_frame, int spatial_enabled)
+{
+    int x = get_global_id(0);
+    float max_norm = (depth <= 8) ? 255.0f : 65535.0f;
+
+    if (x >= width)
+        return;
+
+    if (spatial_enabled == 0) {
+        vertical_planar_temporal(in_img, out_img, frame_ant_data, fa_offset,
+                                 coef_tables, temporal_offset, width, height, x,
+                                 depth, lut_bits, is_msb, first_frame, max_norm);
+    } else {
+        vertical_planar_spatial(in_img, out_img, h_data, h_offset, frame_ant_data, fa_offset,
+                                coef_tables, spatial_offset, temporal_offset, width, height, x,
+                                depth, lut_bits, is_msb, first_frame, max_norm);
+    }
+}
+
+static void vertical_semiplanar_temporal(
+    __read_only image2d_t in_img,
+    __write_only image2d_t out_img,
+    __global ushort *frame_ant_data, int fa_offset_u, int fa_offset_v,
+    __global const short *coef_tables, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame, float max_norm)
+{
+    for (int y = 0; y < height; y++) {
+        float4 raw = read_imagef(in_img, sampler, (int2)(x, y));
+        int cur_u = (int)load_sample((uint)convert_int_rte(raw.x * max_norm), depth, is_msb);
+        int cur_v = (int)load_sample((uint)convert_int_rte(raw.y * max_norm), depth, is_msb);
+        int fa_u = fa_offset_u + y * width + x;
+        int fa_v = fa_offset_v + y * width + x;
+        int prev_u = first_frame ? cur_u : (int)frame_ant_data[fa_u];
+        int prev_v = first_frame ? cur_v : (int)frame_ant_data[fa_v];
+        int tmp_u = lowpass(prev_u, cur_u, coef_tables, temporal_offset, lut_bits);
+        int tmp_v = lowpass(prev_v, cur_v, coef_tables, temporal_offset, lut_bits);
+        uint out_u = store_sample((uint)tmp_u, depth, is_msb);
+        uint out_v = store_sample((uint)tmp_v, depth, is_msb);
+        frame_ant_data[fa_u] = (ushort)tmp_u;
+        frame_ant_data[fa_v] = (ushort)tmp_v;
+        write_imagef(out_img, (int2)(x, y), (float4)((float)out_u / max_norm, (float)out_v / max_norm, 0.0f, 0.0f));
+    }
+}
+
+static void vertical_semiplanar_spatial(
+    __read_only image2d_t in_img,
+    __write_only image2d_t out_img,
+    __global const ushort *h_data, int h_offset_u, int h_offset_v,
+    __global ushort *frame_ant_data, int fa_offset_u, int fa_offset_v,
+    __global const short *coef_tables, int spatial_offset, int temporal_offset,
+    int width, int height, int x,
+    int depth, int lut_bits, int is_msb, int first_frame, float max_norm)
+{
+    int line_ant_u = (int)h_data[h_offset_u + x];
+    int line_ant_v = (int)h_data[h_offset_v + x];
+    for (int y = 0; y < height; y++) {
+        int spat_tmp_u = line_ant_u;
+        int spat_tmp_v = line_ant_v;
+        int fa_u = fa_offset_u + y * width + x;
+        int fa_v = fa_offset_v + y * width + x;
+        int prev_u, prev_v;
+        if (y > 0) {
+            int h_u = (int)h_data[h_offset_u + y * width + x];
+            int h_v = (int)h_data[h_offset_v + y * width + x];
+            spat_tmp_u = lowpass(line_ant_u, h_u, coef_tables, spatial_offset, lut_bits);
+            spat_tmp_v = lowpass(line_ant_v, h_v, coef_tables, spatial_offset, lut_bits);
+            line_ant_u = (int)(ushort)spat_tmp_u;
+            line_ant_v = (int)(ushort)spat_tmp_v;
+        }
+        if (first_frame) {
+            float4 raw = read_imagef(in_img, sampler, (int2)(x, y));
+            prev_u = (int)load_sample((uint)convert_int_rte(raw.x * max_norm), depth, is_msb);
+            prev_v = (int)load_sample((uint)convert_int_rte(raw.y * max_norm), depth, is_msb);
+        } else {
+            prev_u = (int)frame_ant_data[fa_u];
+            prev_v = (int)frame_ant_data[fa_v];
+        }
+        int temp_tmp_u = lowpass(prev_u, spat_tmp_u, coef_tables, temporal_offset, lut_bits);
+        int temp_tmp_v = lowpass(prev_v, spat_tmp_v, coef_tables, temporal_offset, lut_bits);
+        uint out_u = store_sample((uint)temp_tmp_u, depth, is_msb);
+        uint out_v = store_sample((uint)temp_tmp_v, depth, is_msb);
+        frame_ant_data[fa_u] = (ushort)temp_tmp_u;
+        frame_ant_data[fa_v] = (ushort)temp_tmp_v;
+        write_imagef(out_img, (int2)(x, y), (float4)((float)out_u / max_norm, (float)out_v / max_norm, 0.0f, 0.0f));
+    }
+}
+
+__kernel void hqdn3d_vertical_semiplanar(
+    __read_only image2d_t in_img,
+    __write_only image2d_t out_img,
+    __global const ushort *h_data, int h_offset_u, int h_offset_v,
+    __global ushort *frame_ant_data, int fa_offset_u, int fa_offset_v,
+    __global const short *coef_tables, int spatial_offset, int temporal_offset,
+    int width, int height,
+    int depth, int lut_bits, int is_msb, int first_frame, int spatial_enabled)
+{
+    int x = get_global_id(0);
+    float max_norm = (depth <= 8) ? 255.0f : 65535.0f;
+
+    if (x >= width)
+        return;
+
+    if (spatial_enabled == 0) {
+        vertical_semiplanar_temporal(in_img, out_img, frame_ant_data, fa_offset_u, fa_offset_v,
+                                     coef_tables, temporal_offset, width, height, x,
+                                     depth, lut_bits, is_msb, first_frame, max_norm);
+    } else {
+        vertical_semiplanar_spatial(in_img, out_img, h_data, h_offset_u, h_offset_v,
+                                    frame_ant_data, fa_offset_u, fa_offset_v,
+                                    coef_tables, spatial_offset, temporal_offset, width, height, x,
+                                    depth, lut_bits, is_msb, first_frame, max_norm);
+    }
+}
diff --git a/libavfilter/opencl_source.h b/libavfilter/opencl_source.h
index 4a7b945e029fbff9a5795481d455dc5afd90d90b..65546425d65f6c3ffc71e9ffe7ad88c5a8e72453 100644
