index 0000000000000000000000000000000000000000..502afad6583087617f1d1079089abd4dc7a04aeb
--- /dev/null
+++ b/libavfilter/vf_tonemap_vulkan.c
@@ -0,0 +1,399 @@
+/*
+ * HDR to SDR tone mapping with the Hable curve on the intensity of IPT
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <float.h>
+
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#include "vulkan_filter.h"
+#include "bt2408_hable.h"
+#include "colorspace.h"
+#include "filters.h"
+#include "formats.h"
+#include "video.h"
+
+extern const unsigned char ff_bt2408_hable_comp_spv_data[];
+extern const unsigned int ff_bt2408_hable_comp_spv_len;
+
+enum TonemapAlgorithm {
+    TONEMAP_BT2408_HABLE,
+    TONEMAP_NB,
+};
+
+typedef struct TonemapVulkanContext {
+    FFVulkanContext vkctx;
+
+    int initialized;
+    FFVkExecPool e;
+    AVVulkanDeviceQueueFamily *qf;
+    FFVulkanShader shd;
+    VkSampler sampler;
+
+    /* Options */
+    int tonemap;
+    enum AVPixelFormat format;
+    double peak;
+
+    /* Storage buffer for tone map params */
+    FFVkBuffer params_buf;
+    FFBT2408Hable bt2408;
+    double bt2408_peak;
+    enum AVColorPrimaries bt2408_prim;
+
+    /* Push constants */
+    struct {
+        int32_t out_p010;
+    } opts;
+} TonemapVulkanContext;
+
+static av_cold void tonemap_vulkan_uninit(AVFilterContext *avctx)
+{
+    TonemapVulkanContext *s = avctx->priv;
+    FFVulkanContext *vkctx = &s->vkctx;
+    FFVulkanFunctions *vk = &vkctx->vkfn;
+
+    ff_vk_exec_pool_free(vkctx, &s->e);
+    ff_vk_shader_free(vkctx, &s->shd);
+    ff_vk_free_buf(vkctx, &s->params_buf);
+
+    if (s->sampler)
+        vk->DestroySampler(vkctx->hwctx->act_dev, s->sampler,
+                           vkctx->hwctx->alloc);
+
+    ff_vk_uninit(&s->vkctx);
+
+    s->initialized = 0;
+}
+
+static int tonemap_vulkan_check_input(AVFilterContext *ctx, const AVFrame *in)
+{
+    if (in->color_trc != AVCOL_TRC_SMPTE2084 ||
+        in->colorspace != AVCOL_SPC_BT2020_NCL ||
+        in->color_range == AVCOL_RANGE_JPEG) {
+        av_log(ctx, AV_LOG_ERROR,
+               "Unsupported input color properties: trc '%s', colorspace '%s', range '%s' "
+               "(expected smpte2084, bt2020nc, and limited range)\n",
+               av_color_transfer_name(in->color_trc),
+               av_color_space_name(in->colorspace),
+               av_color_range_name(in->color_range));
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
+
+static int setup_bt2408(AVFilterContext *avctx, const AVFrame *input, double peak)
+{
+    TonemapVulkanContext *s = avctx->priv;
+    uint8_t *mapped;
+    int err, i;
+
+    if (peak == s->bt2408_peak && input->color_primaries == s->bt2408_prim)
+        return 0;
+
+    err = ff_bt2408_hable_init(&s->bt2408, input->color_primaries, peak * REFERENCE_WHITE);
+    if (err < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Unsupported primaries '%s' or peak %f\n",
+               av_color_primaries_name(input->color_primaries), peak);
+        return err;
+    }
+
+    for (i = 0; i < s->e.pool_size; i++)
+        ff_vk_exec_wait(&s->vkctx, &s->e.contexts[i]);
+
+    err = ff_vk_map_buffer(&s->vkctx, &s->params_buf, &mapped, 0);
+    if (err < 0)
+        return err;
+    memcpy(mapped, &s->bt2408, sizeof(s->bt2408));
+    err = ff_vk_unmap_buffer(&s->vkctx, &s->params_buf, 1);
+    if (err < 0)
+        return err;
+
+    s->bt2408_peak = peak;
+    s->bt2408_prim = input->color_primaries;
+    return 0;
+}
+
+static av_cold int init_pipeline(AVFilterContext *ctx)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    FFVulkanContext *vkctx = &s->vkctx;
+    int err;
+
+    err = ff_vk_exec_pool_init(vkctx, s->qf, &s->e, s->qf->num * 4, 0, 0, 0, NULL);
+    if (err < 0)
+        return err;
+
+    err = ff_vk_init_sampler(vkctx, &s->sampler, 0, VK_FILTER_NEAREST);
+    if (err < 0)
+        return err;
+
+    const FFVulkanDescriptorSetBinding desc_img[] = {
+        {
+            .type     = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+            .stages   = VK_SHADER_STAGE_COMPUTE_BIT,
+            .elems    = 2,
+            .samplers = DUP_SAMPLER(s->sampler),
+        },
+        {
+            .type   = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .stages = VK_SHADER_STAGE_COMPUTE_BIT,
+            .elems  = 2,
+        },
+    };
+    const FFVulkanDescriptorSetBinding desc_buf[] = {
+        {
+            .type   = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+            .stages = VK_SHADER_STAGE_COMPUTE_BIT,
+        },
+    };
+
+    ff_vk_shader_load(&s->shd, VK_SHADER_STAGE_COMPUTE_BIT, NULL,
+                      (uint32_t []) { 16, 16, 1 }, 0);
+
+    ff_vk_shader_add_push_const(&s->shd, 0, sizeof(s->opts),
+                                VK_SHADER_STAGE_COMPUTE_BIT);
+
+    ff_vk_shader_add_descriptor_set(vkctx, &s->shd, desc_img, 2, 0);
+    ff_vk_shader_add_descriptor_set(vkctx, &s->shd, desc_buf, 1, 1);
+
+    err = ff_vk_shader_link(vkctx, &s->shd,
+                            ff_bt2408_hable_comp_spv_data,
+                            ff_bt2408_hable_comp_spv_len, "main");
+    if (err < 0)
+        return err;
+
+    return ff_vk_shader_register_exec(vkctx, &s->e, &s->shd);
+}
+
+static av_cold int init_filter(AVFilterContext *ctx)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    FFVulkanContext *vkctx = &s->vkctx;
+    int err;
+
+    s->qf = ff_vk_qf_find(vkctx, VK_QUEUE_COMPUTE_BIT, 0);
+    if (!s->qf) {
+        av_log(ctx, AV_LOG_ERROR, "Device has no compute queues\n");
+        return AVERROR(ENOTSUP);
+    }
+
+    err = init_pipeline(ctx);
+    if (err < 0) {
+        tonemap_vulkan_uninit(ctx);
+        return err;
+    }
+
+    err = ff_vk_create_buf(vkctx, &s->params_buf, sizeof(FFBT2408Hable), NULL, NULL,
+                           VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+                           VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+    if (err < 0) {
+        tonemap_vulkan_uninit(ctx);
+        return err;
+    }
+
+    err = ff_vk_shader_update_desc_buffer(vkctx, &s->e.contexts[0], &s->shd,
+                                          1, 0, 0,
+                                          &s->params_buf, 0, s->params_buf.size,
+                                          VK_FORMAT_UNDEFINED);
+    if (err < 0) {
+        tonemap_vulkan_uninit(ctx);
+        return err;
+    }
+
+    s->shd.lg_size[0] <<= 1;
+    s->shd.lg_size[1] <<= 1;
+
+    s->opts.out_p010 = s->vkctx.output_format == AV_PIX_FMT_P010;
+    s->bt2408_peak = -1.0;
+    s->bt2408_prim = AVCOL_PRI_UNSPECIFIED;
+    s->initialized = 1;
+
+    return 0;
+}
+
+static void tonemap_vulkan_set_props(AVFrame *out)
+{
+    out->color_primaries = AVCOL_PRI_BT709;
+    out->color_trc       = AVCOL_TRC_BT709;
+    out->colorspace      = AVCOL_SPC_BT709;
+    out->color_range     = AVCOL_RANGE_MPEG;
+    av_frame_remove_side_data(out, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL);
+    av_frame_remove_side_data(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
+}
+
+static int tonemap_vulkan_filter_frame(AVFilterLink *link, AVFrame *in)
+{
+    AVFilterContext *ctx = link->dst;
+    TonemapVulkanContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    double peak = s->peak ? s->peak : ff_determine_signal_peak(in);
+    AVFrame *out;
+    int err;
+
+    out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!out) {
+        av_frame_free(&in);
+        return AVERROR(ENOMEM);
+    }
+
+    err = tonemap_vulkan_check_input(ctx, in);
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    if (!s->initialized) {
+        err = init_filter(ctx);
+        if (err < 0) {
+            av_frame_free(&in);
+            av_frame_free(&out);
+            return err;
+        }
+    }
+
+    err = setup_bt2408(ctx, in, peak);
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    err = ff_vk_filter_process_simple(&s->vkctx, &s->e, &s->shd, out, in,
+                                      s->sampler, 1, &s->opts, sizeof(s->opts));
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    err = av_frame_copy_props(out, in);
+    if (err < 0) {
+        av_frame_free(&in);
+        av_frame_free(&out);
+        return err;
+    }
+
+    tonemap_vulkan_set_props(out);
+    av_frame_free(&in);
+
+    return ff_filter_frame(outlink, out);
+}
+
+static int tonemap_vulkan_config_input(AVFilterLink *inlink)
+{
+    AVFilterContext *avctx = inlink->dst;
+    TonemapVulkanContext *s = avctx->priv;
+    int err = ff_vk_filter_config_input(inlink);
+
+    if (err < 0)
+        return err;
+
+    if (s->vkctx.input_format != AV_PIX_FMT_P010) {
+        av_log(avctx, AV_LOG_ERROR, "Unsupported input format %s, only p010 supported\n",
+               av_get_pix_fmt_name(s->vkctx.input_format));
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
+
+static int tonemap_vulkan_config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *avctx = outlink->src;
+    TonemapVulkanContext *s = avctx->priv;
+
+    if (s->format != AV_PIX_FMT_NONE &&
+        s->format != AV_PIX_FMT_NV12 &&
+        s->format != AV_PIX_FMT_P010) {
+        av_log(avctx, AV_LOG_ERROR, "Unsupported output format, only nv12 and p010 supported\n");
+        return AVERROR(EINVAL);
+    }
+
+    s->vkctx.output_format = (s->format == AV_PIX_FMT_NONE) ? AV_PIX_FMT_NV12 : s->format;
+
+    return ff_vk_filter_config_output(outlink);
+}
+
+#define OFFSET(x) offsetof(TonemapVulkanContext, x)
+#define FLAGS (AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_VIDEO_PARAM)
+static const AVOption tonemap_vulkan_options[] = {
+    { "tonemap", "tone map algorithm selection", OFFSET(tonemap), AV_OPT_TYPE_INT, { .i64 = TONEMAP_BT2408_HABLE }, 0, TONEMAP_NB - 1, FLAGS, .unit = "tonemap" },
+    {     "bt2408_hable", "ITU-R BT.2408 tone mapping with Hable curve on IPT", 0, AV_OPT_TYPE_CONST, { .i64 = TONEMAP_BT2408_HABLE }, 0, 0, FLAGS, .unit = "tonemap" },
+    { "peak", "signal peak override (units of 100 cd/m^2)", OFFSET(peak), AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "format", "output pixel format", OFFSET(format), AV_OPT_TYPE_PIXEL_FMT, { .i64 = AV_PIX_FMT_NV12 }, AV_PIX_FMT_NONE, INT_MAX, FLAGS, .unit = "fmt" },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(tonemap_vulkan);
+
+static const AVFilterPad tonemap_vulkan_inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = &tonemap_vulkan_filter_frame,
+        .config_props = &tonemap_vulkan_config_input,
+    },
+};
+
+static const AVFilterPad tonemap_vulkan_outputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = &tonemap_vulkan_config_output,
+    },
+};
+
+static int tonemap_vulkan_query_formats(const AVFilterContext *avctx,
+                                        AVFilterFormatsConfig **cfg_in,
+                                        AVFilterFormatsConfig **cfg_out)
+{
+    static const enum AVPixelFormat pix_fmts[] = {
+        AV_PIX_FMT_VULKAN, AV_PIX_FMT_NONE,
+    };
+    int err;
+
+    err = ff_set_common_formats_from_list2(avctx, cfg_in, cfg_out, pix_fmts);
+    if (err < 0)
+        return err;
+
+    err = ff_formats_ref(ff_make_formats_list_singleton(AVCOL_SPC_BT709),
+                         &cfg_out[0]->color_spaces);
+    if (err < 0)
+        return err;
+
+    return ff_formats_ref(ff_make_formats_list_singleton(AVCOL_RANGE_MPEG),
+                          &cfg_out[0]->color_ranges);
+}
+
+const FFFilter ff_vf_tonemap_vulkan = {
+    .p.name         = "tonemap_vulkan",
+    .p.description  = NULL_IF_CONFIG_SMALL("Tone map HDR video to SDR with Vulkan"),
+    .p.priv_class   = &tonemap_vulkan_class,
+    .p.flags        = AVFILTER_FLAG_HWDEVICE,
+    .priv_size      = sizeof(TonemapVulkanContext),
+    .init           = &ff_vk_filter_init,
+    .uninit         = &tonemap_vulkan_uninit,
+    FILTER_INPUTS(tonemap_vulkan_inputs),
+    FILTER_OUTPUTS(tonemap_vulkan_outputs),
+    FILTER_QUERY_FUNC2(&tonemap_vulkan_query_formats),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
