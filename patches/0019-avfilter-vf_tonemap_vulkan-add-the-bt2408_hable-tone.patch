+
+#pragma shader_stage(compute)
+
+#extension GL_EXT_shader_image_load_formatted : require
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_EXT_nonuniform_qualifier : require
+
+layout (local_size_x_id = 253, local_size_y_id = 254, local_size_z_id = 255) in;
+
+layout (set = 0, binding = 0) uniform sampler2D input_img[];
+layout (set = 0, binding = 1) uniform writeonly image2D output_img[];
+
+#define BT2408_LUT_SIZE 256
+#define BT2408_SDR_WHITE 203.0f
+
+struct bt2408_hable {
+    float rgb_to_lms[3][3];
+    float lms_to_rgb[3][3];
+    float lut_min;
+    float lut_max;
+    float lut[BT2408_LUT_SIZE];
+    float black_scale;
+    float black_offset;
+};
+
+layout (std430, set = 1, binding = 0) readonly buffer BT2408Buffer {
+    bt2408_hable s;
+};
+
+layout (push_constant, std430) uniform pushConstants {
+    int out_p010;
+};
+
+#define BT2408_IN_CODE (65535.0f / 64.0f)
+
+const float ST2084_M1 = 0.1593017578125f;
+const float ST2084_M2 = 78.84375f;
+const float ST2084_C1 = 0.8359375f;
+const float ST2084_C2 = 18.8515625f;
+const float ST2084_C3 = 18.6875f;
+const float ST2084_MAX_LUMINANCE = 10000.0f;
+const float REFERENCE_WHITE = 100.0f;
+
+const float rgb_matrix[9] = float[9](
+    1.00000000f,  0.00000000f,  1.47460000f,
+    1.00000000f, -0.16455313f, -0.57135313f,
+    1.00000000f,  1.88140000f,  0.00000000f
+);
+
+const float yuv_matrix[9] = float[9](
+     0.21260000f,  0.71520000f,  0.07220000f,
+    -0.11457211f, -0.38542789f,  0.50000000f,
+     0.50000000f, -0.45415291f, -0.04584709f
+);
+
+float eotf_st2084(float x) {
+    float p = pow(max(x, 0.0f), 1.0f / ST2084_M2);
+    float a = max(p - ST2084_C1, 0.0f);
+    float b = max(ST2084_C2 - ST2084_C3 * p, 1e-6f);
+    float c = pow(a / b, 1.0f / ST2084_M1);
+    return x > 0.0f ? c * ST2084_MAX_LUMINANCE / REFERENCE_WHITE : 0.0f;
+}
+
+vec3 bt2408_yuv2lrgb(vec3 yuv) {
+    vec3 c = yuv * BT2408_IN_CODE;
+    c = vec3((c.x - 64.0f) / 876.0f, (c.y - 512.0f) / 896.0f, (c.z - 512.0f) / 896.0f);
+    vec3 rgb = vec3(
+        rgb_matrix[0] * c.x + rgb_matrix[1] * c.y + rgb_matrix[2] * c.z,
+        rgb_matrix[3] * c.x + rgb_matrix[4] * c.y + rgb_matrix[5] * c.z,
+        rgb_matrix[6] * c.x + rgb_matrix[7] * c.y + rgb_matrix[8] * c.z
+    );
+    return vec3(eotf_st2084(rgb.x), eotf_st2084(rgb.y), eotf_st2084(rgb.z));
+}
+
+float delinearize(float c) {
+    return c <= 0.0f ? 0.0f : pow(c, 1.0f / 2.4f);
+}
+
+vec3 bt2408_lrgb2yuv(vec3 c) {
+    vec3 rgb = vec3(delinearize(c.x), delinearize(c.y), delinearize(c.z));
+    vec3 yuv = vec3(
+        yuv_matrix[0] * rgb.x + yuv_matrix[1] * rgb.y + yuv_matrix[2] * rgb.z,
+        yuv_matrix[3] * rgb.x + yuv_matrix[4] * rgb.y + yuv_matrix[5] * rgb.z,
+        yuv_matrix[6] * rgb.x + yuv_matrix[7] * rgb.y + yuv_matrix[8] * rgb.z
+    );
+    float out_shift = out_p010 != 0 ? 4.0f : 1.0f;
+    float out_code  = out_p010 != 0 ? (65535.0f / 64.0f) : 255.0f;
+    yuv = vec3(yuv.x * 219.0f + 16.0f, yuv.y * 224.0f + 128.0f, yuv.z * 224.0f + 128.0f) * out_shift;
+    return yuv / out_code;
+}
+
+float bt2408_pq_oetf(float nits) {
+    float y = pow(max(nits, 0.0f) / 10000.0f, ST2084_M1);
+    return pow((ST2084_C1 + ST2084_C2 * y) / (1.0f + ST2084_C3 * y), ST2084_M2);
+}
+
+float bt2408_pq_eotf(float x) {
+    float p = pow(max(x, 0.0f), 1.0f / ST2084_M2);
+    return pow(max(p - ST2084_C1, 0.0f) / (ST2084_C2 - ST2084_C3 * p),
+               1.0f / ST2084_M1) * 10000.0f;
+}
+
+vec3 bt2408_mul_rgb_to_lms(vec3 v) {
+    return vec3(s.rgb_to_lms[0][0] * v.x + s.rgb_to_lms[0][1] * v.y + s.rgb_to_lms[0][2] * v.z,
+                s.rgb_to_lms[1][0] * v.x + s.rgb_to_lms[1][1] * v.y + s.rgb_to_lms[1][2] * v.z,
+                s.rgb_to_lms[2][0] * v.x + s.rgb_to_lms[2][1] * v.y + s.rgb_to_lms[2][2] * v.z);
+}
+
+vec3 bt2408_mul_lms_to_rgb(vec3 v) {
+    return vec3(s.lms_to_rgb[0][0] * v.x + s.lms_to_rgb[0][1] * v.y + s.lms_to_rgb[0][2] * v.z,
+                s.lms_to_rgb[1][0] * v.x + s.lms_to_rgb[1][1] * v.y + s.lms_to_rgb[1][2] * v.z,
+                s.lms_to_rgb[2][0] * v.x + s.lms_to_rgb[2][1] * v.y + s.lms_to_rgb[2][2] * v.z);
+}
+
+float bt2408_lut(float i) {
+    float pos = (i - s.lut_min) / (s.lut_max - s.lut_min) * float(BT2408_LUT_SIZE - 1);
+    pos = clamp(pos, 0.0f, float(BT2408_LUT_SIZE - 1));
+    int idx = min(int(pos), BT2408_LUT_SIZE - 2);
+    return s.lut[idx] + (pos - float(idx)) * (s.lut[idx + 1] - s.lut[idx]);
+}
+
+float bt2408_hull(float x) {
+    return ((x - 6.0f) * x + 9.0f) * x;
+}
+
+vec3 bt2408_hable_pixel(vec3 rgb) {
+    vec3 lms = bt2408_mul_rgb_to_lms(rgb);
+    vec3 ipt;
+
+    lms = vec3(bt2408_pq_oetf(lms.x * BT2408_SDR_WHITE),
+               bt2408_pq_oetf(lms.y * BT2408_SDR_WHITE),
+               bt2408_pq_oetf(lms.z * BT2408_SDR_WHITE));
+    ipt = vec3(0.4000f * lms.x + 0.4000f * lms.y + 0.2000f * lms.z,
+               4.4550f * lms.x - 4.8510f * lms.y + 0.3960f * lms.z,
+               0.8056f * lms.x + 0.3572f * lms.y - 1.1628f * lms.z);
+
+    float k = ipt.x;
+    ipt.x = bt2408_lut(k);
+    k = min(k / max(ipt.x, 1e-9f), bt2408_hull(ipt.x) / max(bt2408_hull(k), 1e-9f));
+    ipt.y *= k;
+    ipt.z *= k;
+
+    lms = vec3(ipt.x + 0.0975689f * ipt.y + 0.205226f * ipt.z,
+               ipt.x - 0.1138760f * ipt.y + 0.133217f * ipt.z,
+               ipt.x + 0.0326151f * ipt.y - 0.676887f * ipt.z);
+    lms = vec3(bt2408_pq_eotf(lms.x),
+               bt2408_pq_eotf(lms.y),
+               bt2408_pq_eotf(lms.z)) / BT2408_SDR_WHITE;
+    vec3 out_col = bt2408_mul_lms_to_rgb(lms);
+
+    out_col = pow(clamp(out_col, 0.0f, 1.0f) * s.black_scale, vec3(1.0f / 2.4f)) - vec3(s.black_offset);
+    return pow(clamp(out_col, 0.0f, 1.0f), vec3(2.4f));
+}
+
+vec3 get_chroma_sample(vec3 a, vec3 b, vec3 c, vec3 d) {
+    return (a + b + c + d) * 0.25f;
+}
+
+void main()
+{
+    ivec2 size_uv = imageSize(output_img[1]);
+    int xi = int(gl_GlobalInvocationID.x);
+    int yi = int(gl_GlobalInvocationID.y);
+
+    if (xi >= size_uv.x || yi >= size_uv.y)
+        return;
+
+    int x = 2 * xi;
+    int y = 2 * yi;
+    ivec2 size_y = imageSize(output_img[0]);
+
+    float y0 = texelFetch(input_img[0], ivec2(x,     y),     0).r;
+    float y1 = texelFetch(input_img[0], ivec2(min(x + 1, size_y.x - 1), y),     0).r;
+    float y2 = texelFetch(input_img[0], ivec2(x,     min(y + 1, size_y.y - 1)), 0).r;
+    float y3 = texelFetch(input_img[0], ivec2(min(x + 1, size_y.x - 1), min(y + 1, size_y.y - 1)), 0).r;
+    vec2 uv = texelFetch(input_img[1], ivec2(xi, yi), 0).rg;
+
+    vec3 c0 = bt2408_hable_pixel(bt2408_yuv2lrgb(vec3(y0, uv.x, uv.y)));
+    vec3 c1 = bt2408_hable_pixel(bt2408_yuv2lrgb(vec3(y1, uv.x, uv.y)));
+    vec3 c2 = bt2408_hable_pixel(bt2408_yuv2lrgb(vec3(y2, uv.x, uv.y)));
+    vec3 c3 = bt2408_hable_pixel(bt2408_yuv2lrgb(vec3(y3, uv.x, uv.y)));
+
+    vec3 e0 = bt2408_lrgb2yuv(c0);
+    vec3 e1 = bt2408_lrgb2yuv(c1);
+    vec3 e2 = bt2408_lrgb2yuv(c2);
+    vec3 e3 = bt2408_lrgb2yuv(c3);
+    vec3 chroma = get_chroma_sample(e0, e1, e2, e3);
+
+    imageStore(output_img[0], ivec2(x, y), vec4(e0.x, 0.0, 0.0, 1.0));
+    if (x + 1 < size_y.x)
+        imageStore(output_img[0], ivec2(x + 1, y), vec4(e1.x, 0.0, 0.0, 1.0));
+    if (y + 1 < size_y.y)
+        imageStore(output_img[0], ivec2(x, y + 1), vec4(e2.x, 0.0, 0.0, 1.0));
+    if (x + 1 < size_y.x && y + 1 < size_y.y)
+        imageStore(output_img[0], ivec2(x + 1, y + 1), vec4(e3.x, 0.0, 0.0, 1.0));
+    imageStore(output_img[1], ivec2(xi, yi), vec4(chroma.y, chroma.z, 0.0, 1.0));
+}
