+static int setup_bt2408(AVFilterContext *avctx, const AVFrame *input, double peak)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    cl_int cle;
+    int err;
+
+    if (peak == ctx->bt2408_peak && input->color_primaries == ctx->bt2408_prim)
+        return 0;
+    err = ff_bt2408_hable_init(&ctx->bt2408, input->color_primaries, peak * REFERENCE_WHITE);
+    if (err < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Unsupported primaries '%s' or peak %f\n",
+               av_color_primaries_name(input->color_primaries), peak);
+        return err;
+    }
+    cle = clEnqueueWriteBuffer(ctx->command_queue, ctx->bt2408_mem, CL_TRUE, 0,
+                               sizeof(ctx->bt2408), &ctx->bt2408, 0, NULL, NULL);
+    if (cle != CL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to write bt2408 buffer: %d.\n", cle);
+        return AVERROR(EIO);
+    }
+    ctx->bt2408_peak = peak;
+    ctx->bt2408_prim = input->color_primaries;
+    return 0;
+}
