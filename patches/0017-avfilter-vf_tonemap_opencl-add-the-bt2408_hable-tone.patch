index 0000000000000000000000000000000000000000..26b93afa99990a91653c835446a84b6895427537
--- /dev/null
+++ b/libavfilter/opencl/bt2408_hable.cl
@@ -0,0 +1,195 @@
+/*
+ * HDR to SDR tone mapping with the Hable curve on the intensity of IPT
+ *
+ * The per-pixel part of libavfilter/bt2408_hable.c, which follows libplacebo
+ * v7.360.1 (src/shaders/colorspace.c: pl_shader_color_map_ex), Copyright (C)
+ * Niklas Haas and the libplacebo contributors, licensed under the GNU Lesser
+ * General Public License version 2.1 or later.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#define BT2408_LUT_SIZE 256
+#define BT2408_SDR_WHITE 203.0f
+
+extern float  eotf_st2084(float);
+extern float  inverse_oetf_hlg(float);
+extern float  inverse_eotf_bt1886(float);
+extern float3 ootf(float3 c, float peak);
+extern float3 get_chroma_sample(float3, float3, float3, float3);
+
+// Code values of the P010 input and the NV12 or P010 output, exact for the
+// bit depth rather than the 8-bit scaling in colorspace_common.cl.
+#define BT2408_IN_CODE (65535.0f / 64.0f)
+#ifdef BT2408_OUT_P010
+#define BT2408_OUT_CODE (65535.0f / 64.0f)
+#define BT2408_OUT_SHIFT 4.0f
+#define BT2408_OUT_MAX 1023.0f
+#else
+#define BT2408_OUT_CODE 255.0f
+#define BT2408_OUT_SHIFT 1.0f
+#define BT2408_OUT_MAX 255.0f
+#endif
+
+float3 bt2408_yuv2lrgb(float3 yuv) {
+    float3 c = yuv * BT2408_IN_CODE, rgb;
+#ifdef FULL_RANGE_IN
+    c = (float3)(c.x, c.y - 512.0f, c.z - 512.0f) / 1023.0f;
+#else
+    c = (float3)((c.x - 64.0f) / 876.0f, (c.y - 512.0f) / 896.0f, (c.z - 512.0f) / 896.0f);
+#endif
+    rgb = (float3)(rgb_matrix[0] * c.x + rgb_matrix[1] * c.y + rgb_matrix[2] * c.z,
+                   rgb_matrix[3] * c.x + rgb_matrix[4] * c.y + rgb_matrix[5] * c.z,
+                   rgb_matrix[6] * c.x + rgb_matrix[7] * c.y + rgb_matrix[8] * c.z);
+    return (float3)(linearize(rgb.x), linearize(rgb.y), linearize(rgb.z));
+}
+
+float3 bt2408_lrgb2yuv(float3 c) {
+    float3 yuv;
+
+    c = (float3)(delinearize(c.x), delinearize(c.y), delinearize(c.z));
+    yuv = (float3)(yuv_matrix[0] * c.x + yuv_matrix[1] * c.y + yuv_matrix[2] * c.z,
+                   yuv_matrix[3] * c.x + yuv_matrix[4] * c.y + yuv_matrix[5] * c.z,
+                   yuv_matrix[6] * c.x + yuv_matrix[7] * c.y + yuv_matrix[8] * c.z);
+#ifdef FULL_RANGE_OUT
+    yuv = (float3)(yuv.x * BT2408_OUT_MAX,
+                   yuv.y * BT2408_OUT_MAX + (BT2408_OUT_MAX + 1.0f) / 2.0f,
+                   yuv.z * BT2408_OUT_MAX + (BT2408_OUT_MAX + 1.0f) / 2.0f);
+#else
+    yuv = (float3)(yuv.x * 219.0f + 16.0f, yuv.y * 224.0f + 128.0f, yuv.z * 224.0f + 128.0f) * BT2408_OUT_SHIFT;
+#endif
+    return yuv / BT2408_OUT_CODE;
+}
+
+/* Same layout as FFBT2408Hable in libavfilter/bt2408_hable.h. */
+struct bt2408_hable {
+    float rgb_to_lms[3][3];
+    float lms_to_rgb[3][3];
+    float lut_min;
+    float lut_max;
+    float lut[BT2408_LUT_SIZE];
+    float black_scale;
+    float black_offset;
+};
+
+constant const float BT2408_M1 = 2610.0f / 4096.0f / 4.0f;
+constant const float BT2408_M2 = 2523.0f / 4096.0f * 128.0f;
+constant const float BT2408_C1 = 3424.0f / 4096.0f;
+constant const float BT2408_C2 = 2413.0f / 4096.0f * 32.0f;
+constant const float BT2408_C3 = 2392.0f / 4096.0f * 32.0f;
+
+float bt2408_pq_oetf(float nits) {
+    float y = powr(max(nits, 0.0f) / 10000.0f, BT2408_M1);
+    return powr((BT2408_C1 + BT2408_C2 * y) / (1.0f + BT2408_C3 * y), BT2408_M2);
+}
+
+float bt2408_pq_eotf(float x) {
+    float p = powr(max(x, 0.0f), 1.0f / BT2408_M2);
+    return powr(max(p - BT2408_C1, 0.0f) / (BT2408_C2 - BT2408_C3 * p),
+                1.0f / BT2408_M1) * 10000.0f;
+}
+
+float3 bt2408_mul3(constant const float m[3][3], float3 v) {
+    return (float3)(m[0][0] * v.x + m[0][1] * v.y + m[0][2] * v.z,
+                    m[1][0] * v.x + m[1][1] * v.y + m[1][2] * v.z,
+                    m[2][0] * v.x + m[2][1] * v.y + m[2][2] * v.z);
+}
+
+float bt2408_lut(constant const struct bt2408_hable *s, float i) {
+    float pos = (i - s->lut_min) / (s->lut_max - s->lut_min) * (BT2408_LUT_SIZE - 1);
+    int idx;
+
+    pos = clamp(pos, 0.0f, (float)(BT2408_LUT_SIZE - 1));
+    idx = min((int)pos, BT2408_LUT_SIZE - 2);
+    return s->lut[idx] + (pos - idx) * (s->lut[idx + 1] - s->lut[idx]);
+}
+
+float bt2408_hull(float x) {
+    return ((x - 6.0f) * x + 9.0f) * x;
+}
+
+// linear RGB, 1.0 = 100 cd/m^2, to linear BT.709 RGB for a pure power 2.4 display
+float3 bt2408_hable_pixel(constant const struct bt2408_hable *s, float3 rgb) {
+    float3 lms = bt2408_mul3(s->rgb_to_lms, rgb);
+    float3 ipt, out;
+    float k;
+
+    lms = (float3)(bt2408_pq_oetf(lms.x * BT2408_SDR_WHITE),
+                   bt2408_pq_oetf(lms.y * BT2408_SDR_WHITE),
+                   bt2408_pq_oetf(lms.z * BT2408_SDR_WHITE));
+    ipt = (float3)(0.4000f * lms.x + 0.4000f * lms.y + 0.2000f * lms.z,
+                   4.4550f * lms.x - 4.8510f * lms.y + 0.3960f * lms.z,
+                   0.8056f * lms.x + 0.3572f * lms.y - 1.1628f * lms.z);
+
+    k = ipt.x;
+    ipt.x = bt2408_lut(s, k);
+    k = min(k / max(ipt.x, 1e-9f), bt2408_hull(ipt.x) / max(bt2408_hull(k), 1e-9f));
+    ipt.y *= k;
+    ipt.z *= k;
+
+    lms = (float3)(ipt.x + 0.0975689f * ipt.y + 0.205226f * ipt.z,
+                   ipt.x - 0.1138760f * ipt.y + 0.133217f * ipt.z,
+                   ipt.x + 0.0326151f * ipt.y - 0.676887f * ipt.z);
+    lms = (float3)(bt2408_pq_eotf(lms.x), bt2408_pq_eotf(lms.y),
+                   bt2408_pq_eotf(lms.z)) / BT2408_SDR_WHITE;
+    out = bt2408_mul3(s->lms_to_rgb, lms);
+
+    // Encode for BT.1886 with a raised black, then decode as pure power 2.4.
+    out = powr(clamp(out, 0.0f, 1.0f) * s->black_scale, 1.0f / 2.4f) - s->black_offset;
+    return powr(clamp(out, 0.0f, 1.0f), 2.4f);
+}
+
+__kernel void tonemap_bt2408(__write_only image2d_t dst1,
+                             __read_only  image2d_t src1,
+                             __write_only image2d_t dst2,
+                             __read_only  image2d_t src2,
+                             constant const struct bt2408_hable *s,
+                             float peak)
+{
+    const sampler_t sampler = (CLK_NORMALIZED_COORDS_FALSE |
+                               CLK_ADDRESS_CLAMP_TO_EDGE   |
+                               CLK_FILTER_NEAREST);
+    int xi = get_global_id(0);
+    int yi = get_global_id(1);
+    // each work item processes a 2x2 quad
+    int x = 2 * xi;
+    int y = 2 * yi;
+
+    float y0 = read_imagef(src1, sampler, (int2)(x,     y)).x;
+    float y1 = read_imagef(src1, sampler, (int2)(x + 1, y)).x;
+    float y2 = read_imagef(src1, sampler, (int2)(x,     y + 1)).x;
+    float y3 = read_imagef(src1, sampler, (int2)(x + 1, y + 1)).x;
+    float2 uv = read_imagef(src2, sampler, (int2)(xi,     yi)).xy;
+
+    float3 c0 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y0, uv.x, uv.y)), peak));
+    float3 c1 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y1, uv.x, uv.y)), peak));
+    float3 c2 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y2, uv.x, uv.y)), peak));
+    float3 c3 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y3, uv.x, uv.y)), peak));
+
+    // Subsample the encoded values, as a software scaler does.
+    float3 e0 = bt2408_lrgb2yuv(c0), e1 = bt2408_lrgb2yuv(c1);
+    float3 e2 = bt2408_lrgb2yuv(c2), e3 = bt2408_lrgb2yuv(c3);
+    float3 chroma = get_chroma_sample(e0, e1, e2, e3);
+
+    if (xi < get_image_width(dst2) && yi < get_image_height(dst2)) {
+        write_imagef(dst1, (int2)(x,     y),     (float4)(e0.x, 0.0f, 0.0f, 1.0f));
+        write_imagef(dst1, (int2)(x + 1, y),     (float4)(e1.x, 0.0f, 0.0f, 1.0f));
+        write_imagef(dst1, (int2)(x,     y + 1), (float4)(e2.x, 0.0f, 0.0f, 1.0f));
+        write_imagef(dst1, (int2)(x + 1, y + 1), (float4)(e3.x, 0.0f, 0.0f, 1.0f));
+        write_imagef(dst2, (int2)(xi, yi), (float4)(chroma.y, chroma.z, 0.0f, 1.0f));
+    }
+}
