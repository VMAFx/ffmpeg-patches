+static int detect_peak(AVFilterContext *ctx, const AVFrame *in, double *peak_out)
+{
+    TonemapContext *s = ctx->priv;
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(in->format);
+    const AVLumaCoefficients *coeffs = detect_coeffs(in);
+    DetectThreadData dtd;
+    FFTonemapPeakStats frame_stats = {0};
+    int nb_threads;
+
+    dtd.in = in;
+    dtd.desc = desc;
+    dtd.nb_tiles_x = (in->width + 15) / 16;
+    dtd.nb_tiles_y = (in->height + 15) / 16;
+    dtd.coeff_r = av_q2d(coeffs->cr);
+    dtd.coeff_g = av_q2d(coeffs->cg);
+    dtd.coeff_b = av_q2d(coeffs->cb);
