+#include <float.h>
+#include <math.h>
+#include <stdlib.h>
+
+#include "libavutil/common.h"
+#include "libavutil/csp.h"
+#include "libavutil/dict.h"
+#include "colorspace.h"
+#include "tonemap_peak.h"
+
+float ff_tonemap_peak_measure(const uint32_t *hist, uint32_t frame_max_pq, float percentile)
+{
+    const float frame_max = (float)frame_max_pq / PQ_MAX;
+    uint32_t total_pixels = 0;
+    uint32_t target_pixel;
+    uint32_t sum = 0;
+
+    if (percentile <= 0.0f || percentile >= 100.0f)
+        return frame_max;
+
+    for (int i = 0; i < HIST_BINS; i++)
+        total_pixels += hist[i];
+
+    if (!total_pixels)
+        return frame_max;
+
+    target_pixel = (uint32_t)ceilf(percentile / 100.0f * (float)total_pixels);
+    if (target_pixel >= total_pixels)
+        return frame_max;
+
+    for (int i = 0; i < HIST_BINS; i++) {
+        uint32_t count_low, count_high;
+        float pq_low, pq_high, ratio;
+        uint32_t next = sum + hist[i];
+
+        if (next < target_pixel) {
+            sum = next;
+            continue;
+        }
+
+        count_low  = sum;
+        count_high = next + 1;
+        pq_low  = (float)HIST_PQ(i) / PQ_MAX;
+        pq_high = (float)HIST_PQ(i + 1) / PQ_MAX;
+
+        if (count_high > total_pixels)
+            pq_high = frame_max;
+
+        ratio = (float)(target_pixel - count_low) / (float)(count_high - count_low);
+        return pq_low * (1.0f - ratio) + pq_high * ratio;
+    }
+
+    return frame_max;
+}
+
+double ff_tonemap_peak_update(FFTonemapPeak *s, const FFTonemapPeakStats *stats)
+{
+    float avg_pq, max_pq;
+    const float coeff = 1.0f - expf(-1.0f / 20.0f);
+
+    if (stats->wg_active) {
+        avg_pq = (float)stats->sum_pq / (stats->wg_active * PQ_MAX);
+        max_pq = ff_tonemap_peak_measure(stats->hist, stats->max_pq, 99.995f);
+    } else {
+        avg_pq = max_pq = 1e-6f;
+    }
+
+    if (!s->avg_pq) {
+        s->avg_pq = avg_pq;
+        s->max_pq = max_pq;
+    } else {
+        static const float epsilon = 1.0f / PQ_MAX;
+        if (fabsf(avg_pq - s->avg_pq) < epsilon)
+            avg_pq = s->avg_pq;
+        if (fabsf(max_pq - s->max_pq) < epsilon)
+            max_pq = s->max_pq;
+    }
+
+    s->avg_pq += coeff * (avg_pq - s->avg_pq);
+    s->max_pq += coeff * (max_pq - s->max_pq);
+
+    if (s->threshold > 0.0) {
+        const float thresh_low = 5.0f * s->threshold * 1e-2f;
+        const float thresh_high = 15.0f * s->threshold * 1e-2f;
+        const float bias = stats->wg_count ? (float)stats->wg_active / (float)stats->wg_count : 0.0f;
+        const float delta = bias * fabsf(avg_pq - s->avg_pq);
+        const float mix_coeff = ff_tonemap_peak_smoothstep(thresh_low, thresh_high, delta);
+        s->avg_pq = s->avg_pq * (1.0f - mix_coeff) + avg_pq * mix_coeff;
+        s->max_pq = s->max_pq * (1.0f - mix_coeff) + max_pq * mix_coeff;
+    }
+
+    return FFMAX(1.0, (double)(ff_tonemap_peak_eotf(s->max_pq) * 10000.0f / REFERENCE_WHITE));
+}
