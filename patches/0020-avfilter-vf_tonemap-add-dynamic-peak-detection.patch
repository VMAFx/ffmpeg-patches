 static int add_light_levels(AVFrame *f, unsigned max_cll, unsigned mastering_max)
 {
     if (max_cll) {
@@ -246,6 +262,246 @@ static int check_filter(void)
     return fails;
 }
 
+/*
+ * 14-bit PQ quantization and histogram percentile introduce a measured worst
+ * abs float difference of 5.25e-6 on static peak detection and 6.48e-5 on
+ * scene reset. DETECT_TOL provides margin while cleanly rejecting the
+ * un-reset history in case 6 (diff ~0.03) and 4x peak in case 4 (diff ~0.44).
+ */
+#define DETECT_TOL 2e-4f
+
+static AVFrame *make_flat_frame(int w, int h, float r, float g, float b, const char *l1_max_pq)
+{
+    AVFrame *f = av_frame_alloc();
+
+    if (!f)
+        return NULL;
+    f->format = AV_PIX_FMT_GBRPF32;
+    f->width  = w;
+    f->height = h;
+    f->color_primaries = AVCOL_PRI_BT2020;
+    f->color_trc       = AVCOL_TRC_LINEAR;
+    f->colorspace      = AVCOL_SPC_RGB;
+    if (av_frame_get_buffer(f, 0) < 0) {
+        av_frame_free(&f);
+        return NULL;
+    }
+    if (l1_max_pq && av_dict_set(&f->metadata, "lavfi.dovi.l1_max_pq", l1_max_pq, 0) < 0) {
+        av_frame_free(&f);
+        return NULL;
+    }
+    for (int y = 0; y < h; y++) {
+        float *g_row = (float *)(f->data[0] + y * f->linesize[0]);
+        float *b_row = (float *)(f->data[1] + y * f->linesize[1]);
+        float *r_row = (float *)(f->data[2] + y * f->linesize[2]);
+        for (int x = 0; x < w; x++) {
+            g_row[x] = g;
+            b_row[x] = b;
+            r_row[x] = r;
+        }
+    }
+    return f;
+}
+
+static void free_frames(AVFrame **frames, int nb_frames)
+{
+    if (!frames)
+        return;
+    for (int i = 0; i < nb_frames; i++)
+        av_frame_free(&frames[i]);
+}
+
+static int make_flat_clip(AVFrame **frames, int nb_frames, int w, int h,
+                          float r, float g, float b, const char *l1_max_pq)
+{
+    for (int i = 0; i < nb_frames; i++) {
+        frames[i] = make_flat_frame(w, h, r, g, b, l1_max_pq);
+        if (!frames[i]) {
+            free_frames(frames, i);
+            return AVERROR(ENOMEM);
+        }
+    }
+    return 0;
+}
+
+static int compare_frames(const AVFrame *a, const AVFrame *b, float tol, float *max_diff_out)
+{
+    float max_diff = 0.0f;
+    int matches = 1;
+
+    if (!a || !b || a->width != b->width || a->height != b->height)
+        return -1;
+    for (int p = 0; p < 3; p++) {
+        for (int y = 0; y < a->height; y++) {
+            const float *ra = (const float *)(a->data[p] + y * a->linesize[p]);
+            const float *rb = (const float *)(b->data[p] + y * b->linesize[p]);
+            for (int x = 0; x < a->width; x++) {
+                float diff = fabsf(ra[x] - rb[x]);
+                if (diff > max_diff)
+                    max_diff = diff;
+                if (diff > tol)
+                    matches = 0;
+            }
+        }
+    }
+    if (max_diff_out)
+        *max_diff_out = max_diff;
+    return matches;
+}
+
+static int check_l1_cases(void)
+{
+    AVFrame *frame_l1 = make_flat_frame(32, 32, 3.0f, 2.0f, 1.5f, "2081");
+    AVFrame *frame_planted = make_flat_frame(32, 32, 3.0f, 2.0f, 1.5f, "3079");
+    AVFrame *out_l1 = av_frame_alloc();
+    AVFrame *out_planted = av_frame_alloc();
+    AVFrame *out_ref = av_frame_alloc();
+    av_csp_trc_function pq_eotf = av_csp_trc_func_inv_from_id(AVCOL_TRC_SMPTE2084);
+    double p = pq_eotf(2081 / 4095.0) / 100.0;
+    char opt[64];
+    int ret, fails = 0, ok1, ok2;
+
+    snprintf(opt, sizeof(opt), "peak=%.6f", p);
+    if (!frame_l1 || !frame_planted || !out_l1 || !out_planted || !out_ref) {
+        av_frame_free(&frame_l1);
+        av_frame_free(&frame_planted);
+        av_frame_free(&out_l1);
+        av_frame_free(&out_planted);
+        av_frame_free(&out_ref);
+        return 1;
+    }
+
+    ret = run_filter_opts(&frame_l1, 1, "peak_detect=1", out_l1);
+    if (ret >= 0)
+        ret = run_filter_opts(&frame_l1, 1, opt, out_ref);
+    ok1 = (ret >= 0) && compare_frames(out_l1, out_ref, TOL, NULL) == 1;
+    printf("peak from Dolby Vision L1: %s\n", ok1 ? "ok" : "WRONG");
+    fails += !ok1;
+
+    if (ret >= 0)
+        ret = run_filter_opts(&frame_planted, 1, "peak_detect=1", out_planted);
+    ok2 = (ret >= 0) && compare_frames(out_planted, out_ref, TOL, NULL) == 0;
+    printf("planted wrong L1 peak: %s\n", ok2 ? "detected" : "MISSED");
+    fails += !ok2;
+
+    av_frame_free(&frame_l1);
+    av_frame_free(&frame_planted);
+    av_frame_free(&out_l1);
+    av_frame_free(&out_planted);
+    av_frame_free(&out_ref);
+    return fails;
+}
+
+static int check_detected_cases(void)
+{
+    const float r = 5.0f, g = 4.0f, b = 1.0f;
+    const double y = 0.2627 * r + 0.6780 * g + 0.0593 * b;
+    AVFrame *clip[20] = {0};
+    AVFrame *ref_frame = make_flat_frame(32, 32, r, g, b, NULL);
+    AVFrame *out_det = av_frame_alloc();
+    AVFrame *out_ref = av_frame_alloc();
+    AVFrame *out_ref_4x = av_frame_alloc();
+    char opt_ref[64], opt_4x[64];
+    int ret, fails = 0, ok3, ok4;
+
+    snprintf(opt_ref, sizeof(opt_ref), "peak=%.6f", y);
+    snprintf(opt_4x, sizeof(opt_4x), "peak=%.6f", 4.0 * y);
+    ret = make_flat_clip(clip, 20, 32, 32, r, g, b, NULL);
+    if (ret < 0 || !ref_frame || !out_det || !out_ref || !out_ref_4x) {
+        free_frames(clip, 20);
+        av_frame_free(&ref_frame);
+        av_frame_free(&out_det);
+        av_frame_free(&out_ref);
+        av_frame_free(&out_ref_4x);
+        return 1;
+    }
+
+    ret = run_filter_opts(clip, 20, "peak_detect=1", out_det);
+    if (ret >= 0)
+        ret = run_filter_opts(&ref_frame, 1, opt_ref, out_ref);
+    ok3 = (ret >= 0) && compare_frames(out_det, out_ref, DETECT_TOL, NULL) == 1;
+    printf("detected peak: %s\n", ok3 ? "ok" : "WRONG");
+    fails += !ok3;
+
+    if (ret >= 0)
+        ret = run_filter_opts(&ref_frame, 1, opt_4x, out_ref_4x);
+    ok4 = (ret >= 0) && compare_frames(out_det, out_ref_4x, DETECT_TOL, NULL) == 0;
+    printf("planted wrong detected peak: %s\n", ok4 ? "detected" : "MISSED");
+    fails += !ok4;
+
+    free_frames(clip, 20);
+    av_frame_free(&ref_frame);
+    av_frame_free(&out_det);
+    av_frame_free(&out_ref);
+    av_frame_free(&out_ref_4x);
+    return fails;
+}
+
+static int check_scene_cases(void)
+{
+    const float r_a = 5.0f, g_a = 4.0f, b_a = 1.0f;
+    const float r_b = 8.0f, g_b = 7.0f, b_b = 3.0f;
+    const double y_b = 0.2627 * r_b + 0.6780 * g_b + 0.0593 * b_b;
+    AVFrame *clip_scene[20] = {0};
+    AVFrame *clip_noscene[20] = {0};
+    AVFrame *ref_b = make_flat_frame(32, 32, r_b, g_b, b_b, NULL);
+    AVFrame *out_scene = av_frame_alloc();
+    AVFrame *out_noscene = av_frame_alloc();
+    AVFrame *out_ref_b = av_frame_alloc();
+    char opt_b[64];
+    int ret, fails = 0, ok5, ok6;
+
+    snprintf(opt_b, sizeof(opt_b), "peak=%.6f", y_b);
+    ret = make_flat_clip(clip_scene, 10, 32, 32, r_a, g_a, b_a, NULL);
+    if (ret >= 0)
+        ret = make_flat_clip(clip_scene + 10, 10, 32, 32, r_b, g_b, b_b, NULL);
+    if (ret >= 0)
+        ret = make_flat_clip(clip_noscene, 10, 32, 32, r_a, g_a, b_a, NULL);
+    if (ret >= 0)
+        ret = make_flat_clip(clip_noscene + 10, 10, 32, 32, r_b, g_b, b_b, NULL);
+
+    if (ret < 0 || !ref_b || !out_scene || !out_noscene || !out_ref_b) {
+        free_frames(clip_scene, 20);
+        free_frames(clip_noscene, 20);
+        av_frame_free(&ref_b);
+        av_frame_free(&out_scene);
+        av_frame_free(&out_noscene);
+        av_frame_free(&out_ref_b);
+        return 1;
+    }
+
+    ret = run_filter_opts(clip_scene, 20, "peak_detect=1:threshold=0.2", out_scene);
+    if (ret >= 0)
+        ret = run_filter_opts(&ref_b, 1, opt_b, out_ref_b);
+    ok5 = (ret >= 0) && compare_frames(out_scene, out_ref_b, DETECT_TOL, NULL) == 1;
+    printf("scene change resets the peak: %s\n", ok5 ? "ok" : "WRONG");
+    fails += !ok5;
+
+    if (ret >= 0)
+        ret = run_filter_opts(clip_noscene, 20, "peak_detect=1:threshold=0", out_noscene);
+    ok6 = (ret >= 0) && compare_frames(out_noscene, out_ref_b, DETECT_TOL, NULL) == 0;
+    printf("no scene detection keeps history: %s\n", ok6 ? "detected" : "MISSED");
+    fails += !ok6;
+
+    free_frames(clip_scene, 20);
+    free_frames(clip_noscene, 20);
+    av_frame_free(&ref_b);
+    av_frame_free(&out_scene);
+    av_frame_free(&out_noscene);
+    av_frame_free(&out_ref_b);
+    return fails;
+}
+
+static int check_peak(void)
+{
+    int fails = 0;
+
+    fails += check_l1_cases();
+    fails += check_detected_cases();
+    fails += check_scene_cases();
+    return fails;
+}
+
 int main(int argc, char **argv)
 {
     FFBT2408Hable s;
@@ -255,6 +511,10 @@ int main(int argc, char **argv)
         av_log_set_level(AV_LOG_QUIET);
         return check_filter() != 0;
     }
+    if (argc > 1 && !strcmp(argv[1], "peak")) {
+        av_log_set_level(AV_LOG_QUIET);
+        return check_peak() != 0;
+    }
 
     if (ff_bt2408_hable_init(&s, AVCOL_PRI_BT2020, PEAK) < 0) {
         printf("init failed\n");
