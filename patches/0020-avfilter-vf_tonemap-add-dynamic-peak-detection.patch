+typedef struct DetectThreadData {
+    const AVFrame *in;
+    const AVPixFmtDescriptor *desc;
+    int nb_tiles_x;
+    int nb_tiles_y;
+    float coeff_r;
+    float coeff_g;
+    float coeff_b;
+} DetectThreadData;
+
+static inline float pq_oetf(float x)
+{
+    float xm = powf(x, PQ_M1);
+    float num = PQ_C1 + PQ_C2 * xm;
+    float den = 1.0f + PQ_C3 * xm;
+
+    return powf(num / den, PQ_M2);
+}
+
+static inline uint32_t compute_pixel_pq(float r, float g, float b,
+                                        float cr, float cg, float cb)
+{
+    float luma = cr * r + cg * g + cb * b;
+    float nits = luma * REFERENCE_WHITE;
+    float x = av_clipf(nits / 10000.0f, 0.0f, 1.0f);
+    float y = pq_oetf(x);
+
+    y *= ff_tonemap_peak_smoothstep(0.0f, 0.01f, y);
+    y = av_clipf(y, 0.0f, 1.0f);
+    return (uint32_t)(PQ_MAX * y);
+}
+
+static void process_tile(const AVFrame *in, const AVPixFmtDescriptor *desc,
+                         const DetectThreadData *td, FFTonemapPeakStats *job,
+                         int x0, int x1, int y0, int y1)
+{
+    const int r_plane = desc->comp[0].plane;
+    const int g_plane = desc->comp[1].plane;
+    const int b_plane = desc->comp[2].plane;
+    uint32_t tile_sum = 0, tile_max = 0, black = 0;
+    uint32_t tile_hist[HIST_BINS] = {0};
+    uint32_t wg_size = (x1 - x0) * (y1 - y0);
+    uint32_t num;
+
+    for (int y = y0; y < y1; y++) {
+        const float *r_row = (const float *)(in->data[r_plane] + y * in->linesize[r_plane]);
+        const float *g_row = (const float *)(in->data[g_plane] + y * in->linesize[g_plane]);
+        const float *b_row = (const float *)(in->data[b_plane] + y * in->linesize[b_plane]);
+
+        for (int x = x0; x < x1; x++) {
+            uint32_t y_pq = compute_pixel_pq(r_row[x], g_row[x], b_row[x],
+                                             td->coeff_r, td->coeff_g, td->coeff_b);
+            int bin = ((int)y_pq >> (PQ_BITS - HIST_BITS)) - HIST_BIAS;
+
+            tile_sum += y_pq;
+            tile_max = FFMAX(tile_max, y_pq);
+            bin = av_clip(bin, 0, HIST_BINS - 1);
+            tile_hist[bin]++;
+            if (!y_pq)
+                black++;
+        }
+    }
+
+    tile_hist[0] -= black;
+    num = wg_size - black;
+    job->wg_count += 1;
+    job->wg_active += (num > 0);
+    if (num > 0) {
+        job->sum_pq += tile_sum / num;
+        job->max_pq = FFMAX(job->max_pq, tile_max);
+    }
+    for (int i = 0; i < HIST_BINS; i++)
+        job->hist[i] += tile_hist[i];
+}
+
+static int detect_slice(AVFilterContext *ctx, void *arg, int jobnr, int nb_jobs)
+{
+    TonemapContext *s = ctx->priv;
+    DetectThreadData *td = arg;
+    FFTonemapPeakStats *job = &s->jobs[jobnr];
+    const int ty_start = ff_slice_pos(td->nb_tiles_y, jobnr, nb_jobs);
+    const int ty_end   = ff_slice_pos(td->nb_tiles_y, jobnr + 1, nb_jobs);
+
+    for (int ty = ty_start; ty < ty_end; ty++) {
+        const int y0 = ty * 16;
+        const int y1 = FFMIN(y0 + 16, td->in->height);
+
+        for (int tx = 0; tx < td->nb_tiles_x; tx++) {
+            const int x0 = tx * 16;
+            const int x1 = FFMIN(x0 + 16, td->in->width);
+
+            process_tile(td->in, td->desc, td, job, x0, x1, y0, y1);
+        }
+    }
+
+    return 0;
+}
