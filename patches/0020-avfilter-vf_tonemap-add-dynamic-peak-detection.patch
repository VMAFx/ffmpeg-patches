+static const AVLumaCoefficients *detect_coeffs(const AVFrame *in)
+{
+    const AVLumaCoefficients *coeffs = av_csp_luma_coeffs_from_avcsp(in->colorspace);
+
+    if (!coeffs || in->colorspace == AVCOL_SPC_RGB) {
+        switch (in->color_primaries) {
+        case AVCOL_PRI_BT2020:
+            coeffs = av_csp_luma_coeffs_from_avcsp(AVCOL_SPC_BT2020_NCL);
+            break;
+        case AVCOL_PRI_SMPTE170M:
+        case AVCOL_PRI_BT470BG:
+            coeffs = av_csp_luma_coeffs_from_avcsp(AVCOL_SPC_SMPTE170M);
+            break;
+        default:
+            coeffs = av_csp_luma_coeffs_from_avcsp(AVCOL_SPC_BT709);
