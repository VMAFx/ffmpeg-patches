+int ff_tonemap_peak_read_l1(const AVFrame *in, double *peak_out)
+{
+    const AVDictionaryEntry *e;
+    char *end = NULL;
+    long max_pq = -1;
+
+    e = av_dict_get(in->metadata, "lavfi.dovi.l1_max_pq", NULL, 0);
+    if (e && e->value && *e->value)
+        max_pq = strtol(e->value, &end, 10);
+
+    if (e && e->value && end && !*end && end != e->value && max_pq >= 0 && max_pq <= 4095) {
+        av_csp_trc_function pq_eotf = av_csp_trc_func_inv_from_id(AVCOL_TRC_SMPTE2084);
+        *peak_out = pq_eotf(max_pq / 4095.0) / REFERENCE_WHITE;
+        return 1;
+    }
+
+    return 0;
+}
