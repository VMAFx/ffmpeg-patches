+        frame_stats.wg_count += s->jobs[j].wg_count;
+        frame_stats.wg_active += s->jobs[j].wg_active;
+        frame_stats.max_pq = FFMAX(frame_stats.max_pq, s->jobs[j].max_pq);
+        for (int i = 0; i < HIST_BINS; i++)
