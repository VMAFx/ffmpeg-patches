+#include <math.h>
+
+#include "libavutil/common.h"
+#include "libavutil/frame.h"
+#include "colorspace.h"
+
+#define PQ_BITS     14
+#define PQ_MAX      ((1 << PQ_BITS) - 1)
+#define HIST_BITS   7
+#define HIST_BIAS   (1 << (HIST_BITS - 1))
+#define HIST_BINS   ((1 << HIST_BITS) - HIST_BIAS)
+#define HIST_PQ(bin) (((bin) + HIST_BIAS) << (PQ_BITS - HIST_BITS))
+
+#define PQ_M1 (2610.0f / 16384.0f)
+#define PQ_M2 (2523.0f * 128.0f / 4096.0f)
+#define PQ_C1 (3424.0f / 4096.0f)
+#define PQ_C2 (2413.0f * 32.0f / 4096.0f)
+#define PQ_C3 (2392.0f * 32.0f / 4096.0f)
+
+typedef struct FFTonemapPeak {
+    float avg_pq;
+    float max_pq;
+    double threshold;
+} FFTonemapPeak;
+
+typedef struct FFTonemapPeakStats {
+    uint64_t sum_pq;
+    uint32_t wg_count;
+    uint32_t wg_active;
+    uint32_t max_pq;
+    uint32_t hist[HIST_BINS];
+} FFTonemapPeakStats;
+
+static inline float ff_tonemap_peak_eotf(float y)
+{
+    float ym, num, den;
+
+    if (y <= 0.0f)
+        return 0.0f;
+    ym = powf(y, 1.0f / PQ_M2);
+    num = fmaxf(ym - PQ_C1, 0.0f);
+    den = fmaxf(PQ_C2 - PQ_C3 * ym, 1e-6f);
+
+    return powf(num / den, 1.0f / PQ_M1);
+}
+
+static inline float ff_tonemap_peak_smoothstep(float edge0, float edge1, float x)
+{
+    float t = av_clipf((x - edge0) / (edge1 - edge0), 0.0f, 1.0f);
+
+    return t * t * (3.0f - 2.0f * t);
+}
+
+float ff_tonemap_peak_measure(const uint32_t *hist, uint32_t frame_max_pq, float percentile);
+
+double ff_tonemap_peak_update(FFTonemapPeak *s, const FFTonemapPeakStats *stats);
+
+int ff_tonemap_peak_read_l1(const AVFrame *in, double *peak_out);
+
+#endif /* AVFILTER_TONEMAP_PEAK_H */
