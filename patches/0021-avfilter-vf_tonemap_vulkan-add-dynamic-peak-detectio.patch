new file mode 100644
index 0000000000000000000000000000000000000000..eff58cbb3328528dfb4559d878ec12a7000c87ea
--- /dev/null
+++ b/libavfilter/vulkan/tonemap_peak.comp.glsl
@@ -0,0 +1,149 @@
+/*
+ * Peak detection compute shader for tonemap_vulkan
+ *
+ * The dynamic peak detection follows libplacebo v7.360.1
+ * (src/shaders/colorspace.c: pl_shader_detect_peak, measure_peak,
+ * update_peak_buf), Copyright (C) Niklas Haas and the libplacebo
+ * contributors, licensed under the GNU Lesser General Public License
+ * version 2.1 or later.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#pragma shader_stage(compute)
+
+#extension GL_EXT_shader_image_load_formatted : require
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_EXT_nonuniform_qualifier : require
+
+layout (local_size_x_id = 253, local_size_y_id = 254, local_size_z_id = 255) in;
+
+layout (set = 0, binding = 0) uniform sampler2D input_img[];
+
+layout (std430, set = 1, binding = 0) buffer StatsBuffer {
+    uint stats_sum_lo;
+    uint stats_sum_hi;
+    uint stats_wg_count;
+    uint stats_wg_active;
+    uint stats_max_pq;
+    uint stats_hist[64];
+};
+
+#define BT2408_IN_CODE (65535.0f / 64.0f)
+
+const float ST2084_M1 = 0.1593017578125f;
+const float ST2084_M2 = 78.84375f;
+const float ST2084_C1 = 0.8359375f;
+const float ST2084_C2 = 18.8515625f;
+const float ST2084_C3 = 18.6875f;
+const float ST2084_MAX_LUMINANCE = 10000.0f;
+const float REFERENCE_WHITE = 100.0f;
+
+const float rgb_matrix[9] = float[9](
+    1.00000000f,  0.00000000f,  1.47460000f,
+    1.00000000f, -0.16455313f, -0.57135313f,
+    1.00000000f,  1.88140000f,  0.00000000f
+);
+
+float eotf_st2084(float x) {
+    float p = pow(max(x, 0.0f), 1.0f / ST2084_M2);
+    float a = max(p - ST2084_C1, 0.0f);
+    float b = max(ST2084_C2 - ST2084_C3 * p, 1e-6f);
+    float c = pow(a / b, 1.0f / ST2084_M1);
+    return x > 0.0f ? c * ST2084_MAX_LUMINANCE / REFERENCE_WHITE : 0.0f;
+}
+
+vec3 bt2408_yuv2lrgb(vec3 yuv) {
+    vec3 c = yuv * BT2408_IN_CODE;
+    c = vec3((c.x - 64.0f) / 876.0f, (c.y - 512.0f) / 896.0f, (c.z - 512.0f) / 896.0f);
+    vec3 rgb = vec3(
+        rgb_matrix[0] * c.x + rgb_matrix[1] * c.y + rgb_matrix[2] * c.z,
+        rgb_matrix[3] * c.x + rgb_matrix[4] * c.y + rgb_matrix[5] * c.z,
+        rgb_matrix[6] * c.x + rgb_matrix[7] * c.y + rgb_matrix[8] * c.z
+    );
+    return vec3(eotf_st2084(rgb.x), eotf_st2084(rgb.y), eotf_st2084(rgb.z));
+}
+
+shared uint tile_sum;
+shared uint tile_max;
+shared uint tile_black;
+shared uint tile_valid;
+shared uint tile_hist[64];
+
+void main()
+{
+    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 size_y = textureSize(input_img[0], 0);
+
+    if (gl_LocalInvocationIndex == 0u) {
+        tile_sum = 0u;
+        tile_max = 0u;
+        tile_black = 0u;
+        tile_valid = 0u;
+    }
+    if (gl_LocalInvocationIndex < 64u)
+        tile_hist[gl_LocalInvocationIndex] = 0u;
+
+    barrier();
+
+    if (pos.x < size_y.x && pos.y < size_y.y) {
+        atomicAdd(tile_valid, 1u);
+
+        float y_in = texelFetch(input_img[0], pos, 0).r;
+        vec2 uv_in = texelFetch(input_img[1], pos / 2, 0).rg;
+        vec3 lrgb = bt2408_yuv2lrgb(vec3(y_in, uv_in.x, uv_in.y));
+
+        float luma = 0.2627f * lrgb.x + 0.6780f * lrgb.y + 0.0593f * lrgb.z;
+        float nits = luma * 100.0f;
+        float x = clamp(nits / 10000.0f, 0.0f, 1.0f);
+        float xm = pow(max(x, 0.0f), ST2084_M1);
+        float y_pq_f = pow((ST2084_C1 + ST2084_C2 * xm) / (1.0f + ST2084_C3 * xm), ST2084_M2);
+        float t = clamp(y_pq_f / 0.01f, 0.0f, 1.0f);
+        y_pq_f *= t * t * (3.0f - 2.0f * t);
+        y_pq_f = clamp(y_pq_f, 0.0f, 1.0f);
+        uint y_pq = uint(16383.0f * y_pq_f);
+
+        atomicAdd(tile_sum, y_pq);
+        atomicMax(tile_max, y_pq);
+        if (y_pq == 0u)
+            atomicAdd(tile_black, 1u);
+        int bin = clamp((int(y_pq) >> 7) - 64, 0, 63);
+        atomicAdd(tile_hist[bin], 1u);
+    }
+
+    barrier();
+
+    if (gl_LocalInvocationIndex == 0u) {
+        if (tile_valid > 0u) {
+            tile_hist[0] -= tile_black;
+            uint num = tile_valid - tile_black;
+            atomicAdd(stats_wg_count, 1u);
+            if (num > 0u) {
+                atomicAdd(stats_wg_active, 1u);
+                uint tile_sum_avg = tile_sum / num;
+                uint prev = atomicAdd(stats_sum_lo, tile_sum_avg);
+                if (prev + tile_sum_avg < prev)
+                    atomicAdd(stats_sum_hi, 1u);
+                atomicMax(stats_max_pq, tile_max);
+            }
+            for (int i = 0; i < 64; i++) {
+                if (tile_hist[i] > 0u)
+                    atomicAdd(stats_hist[i], tile_hist[i]);
+            }
+        }
+    }
+}
