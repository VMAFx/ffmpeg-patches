+static av_cold int init_peak_pipeline(AVFilterContext *ctx)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    FFVulkanContext *vkctx = &s->vkctx;
+    const FFVulkanDescriptorSetBinding desc_img[] = {
+        {
+            .type     = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+            .stages   = VK_SHADER_STAGE_COMPUTE_BIT,
+            .elems    = 2,
+            .samplers = DUP_SAMPLER(s->sampler),
+        },
+    };
+    const FFVulkanDescriptorSetBinding desc_buf[] = {
+        {
+            .type   = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+            .stages = VK_SHADER_STAGE_COMPUTE_BIT,
+        },
+    };
+    int err;
+
+    ff_vk_shader_load(&s->shd_peak, VK_SHADER_STAGE_COMPUTE_BIT, NULL,
+                      (uint32_t []) { 16, 16, 1 }, 0);
+
+    ff_vk_shader_add_descriptor_set(vkctx, &s->shd_peak, desc_img, 1, 0);
+    ff_vk_shader_add_descriptor_set(vkctx, &s->shd_peak, desc_buf, 1, 1);
+
+    err = ff_vk_shader_link(vkctx, &s->shd_peak,
+                            ff_tonemap_peak_comp_spv_data,
+                            ff_tonemap_peak_comp_spv_len, "main");
+    if (err < 0)
+        return err;
+
+    return ff_vk_shader_register_exec(vkctx, &s->e, &s->shd_peak);
+}
+
 static av_cold int init_pipeline(AVFilterContext *ctx)
 {
     TonemapVulkanContext *s = ctx->priv;
@@ -180,7 +227,31 @@ static av_cold int init_pipeline(AVFilterContext *ctx)
     if (err < 0)
         return err;
 
-    return ff_vk_shader_register_exec(vkctx, &s->e, &s->shd);
+    err = ff_vk_shader_register_exec(vkctx, &s->e, &s->shd);
+    if (err < 0)
+        return err;
+
+    return s->peak_detect ? init_peak_pipeline(ctx) : 0;
+}
+
+static av_cold int init_peak_buf(AVFilterContext *ctx)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    FFVulkanContext *vkctx = &s->vkctx;
+    int err;
+
+    err = ff_vk_create_buf(vkctx, &s->peak_buf, sizeof(FFTonemapPeakStats), NULL, NULL,
+                           VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                           VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                           VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                           VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (err < 0)
+        return err;
+
+    return ff_vk_shader_update_desc_buffer(vkctx, &s->e.contexts[0], &s->shd_peak,
+                                           1, 0, 0,
+                                           &s->peak_buf, 0, s->peak_buf.size,
+                                           VK_FORMAT_UNDEFINED);
 }
 
 static av_cold int init_filter(AVFilterContext *ctx)
@@ -218,6 +289,14 @@ static av_cold int init_filter(AVFilterContext *ctx)
         return err;
     }
 
+    if (s->peak_detect) {
+        err = init_peak_buf(ctx);
+        if (err < 0) {
+            tonemap_vulkan_uninit(ctx);
+            return err;
+        }
+    }
+
     s->shd.lg_size[0] <<= 1;
     s->shd.lg_size[1] <<= 1;
 
@@ -239,13 +318,207 @@ static void tonemap_vulkan_set_props(AVFrame *out)
     av_frame_remove_side_data(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
 }
 
+static void barrier_zero_peak_buf(FFVulkanContext *vkctx, FFVkExecContext *exec,
+                                  FFVkBuffer *buf)
+{
+    FFVulkanFunctions *vk = &vkctx->vkfn;
+
+    vk->CmdPipelineBarrier2(exec->buf, &(VkDependencyInfo) {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .pBufferMemoryBarriers = &(VkBufferMemoryBarrier2) {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2,
+            .srcStageMask = VK_PIPELINE_STAGE_2_NONE,
+            .dstStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT,
+            .dstAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .buffer = buf->buf,
+            .size = buf->size,
+            .offset = 0,
+        },
+        .bufferMemoryBarrierCount = 1,
+    });
+    vk->CmdFillBuffer(exec->buf, buf->buf, 0, buf->size, 0);
+}
+
+static void barrier_host_read_peak_buf(FFVulkanContext *vkctx, FFVkExecContext *exec,
+                                       FFVkBuffer *buf)
+{
+    FFVulkanFunctions *vk = &vkctx->vkfn;
+
+    vk->CmdPipelineBarrier2(exec->buf, &(VkDependencyInfo) {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .pBufferMemoryBarriers = &(VkBufferMemoryBarrier2) {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2,
+            .srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+            .dstStageMask = VK_PIPELINE_STAGE_2_HOST_BIT,
+            .srcAccessMask = VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
+                             VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_2_HOST_READ_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .buffer = buf->buf,
+            .size = buf->size,
+            .offset = 0,
+        },
+        .bufferMemoryBarrierCount = 1,
+    });
+}
+
+static void barrier_peak_input(FFVulkanContext *vkctx, FFVkExecContext *exec,
+                               AVFrame *in, FFVkBuffer *buf)
+{
+    FFVulkanFunctions *vk = &vkctx->vkfn;
+    VkImageMemoryBarrier2 img_bar[4];
+    int nb_img_bar = 0;
+
+    ff_vk_frame_barrier(vkctx, exec, in, img_bar, &nb_img_bar,
+                        VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                        VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+                        VK_ACCESS_SHADER_READ_BIT,
+                        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                        VK_QUEUE_FAMILY_IGNORED);
+
+    vk->CmdPipelineBarrier2(exec->buf, &(VkDependencyInfo) {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .pImageMemoryBarriers = img_bar,
+        .imageMemoryBarrierCount = nb_img_bar,
+        .pBufferMemoryBarriers = &(VkBufferMemoryBarrier2) {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2,
+            .srcStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT,
+            .dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+            .srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
+                             VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .buffer = buf->buf,
+            .size = buf->size,
+            .offset = 0,
+        },
+        .bufferMemoryBarrierCount = 1,
+    });
+}
+
+static int dispatch_peak_detection(AVFilterContext *ctx, AVFrame *in)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    FFVulkanContext *vkctx = &s->vkctx;
+    FFVulkanFunctions *vk = &vkctx->vkfn;
+    FFVkExecContext *exec = ff_vk_exec_get(vkctx, &s->e);
+    VkImageView in_views[AV_NUM_DATA_POINTERS];
+    int err;
+
+    ff_vk_exec_start(vkctx, exec);
+
+    err = ff_vk_exec_add_dep_frame(vkctx, exec, in,
+                                   VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+                                   VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT);
+    if (err < 0) {
+        ff_vk_exec_discard_deps(vkctx, exec);
+        return err;
+    }
+
+    err = ff_vk_create_imageviews(vkctx, exec, in_views, in, FF_VK_REP_FLOAT);
+    if (err < 0) {
+        ff_vk_exec_discard_deps(vkctx, exec);
+        return err;
+    }
+
+    ff_vk_shader_update_img_array(vkctx, exec, &s->shd_peak, in, in_views, 0, 0,
+                                  VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                                  s->sampler);
+
+    barrier_zero_peak_buf(vkctx, exec, &s->peak_buf);
+    barrier_peak_input(vkctx, exec, in, &s->peak_buf);
+
+    ff_vk_exec_bind_shader(vkctx, exec, &s->shd_peak);
+
+    vk->CmdDispatch(exec->buf,
+                    FFALIGN(in->width, 16) / 16,
+                    FFALIGN(in->height, 16) / 16,
+                    1);
+
+    barrier_host_read_peak_buf(vkctx, exec, &s->peak_buf);
+
+    err = ff_vk_exec_submit(vkctx, exec);
+    if (err < 0) {
+        ff_vk_exec_discard_deps(vkctx, exec);
+        return err;
+    }
+
+    ff_vk_exec_wait(vkctx, exec);
+    return 0;
+}
+
+static int read_peak_stats(AVFilterContext *ctx, FFTonemapPeakStats *stats)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    FFVulkanContext *vkctx = &s->vkctx;
+    uint8_t *mapped;
+    int err;
+
+    err = ff_vk_map_buffer(vkctx, &s->peak_buf, &mapped, 1);
+    if (err < 0)
+        return err;
+    memcpy(stats, mapped, sizeof(*stats));
+    err = ff_vk_unmap_buffer(vkctx, &s->peak_buf, 0);
+    if (err < 0)
+        return err;
+
+    return 0;
+}
+
+static int detect_signal_peak(AVFilterContext *ctx, AVFrame *in, double *peak_out)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    FFTonemapPeakStats stats;
+    int err;
+
+    err = dispatch_peak_detection(ctx, in);
+    if (err < 0)
+        return err;
+
+    err = read_peak_stats(ctx, &stats);
+    if (err < 0)
+        return err;
+
+    s->peak_state.threshold = s->threshold;
+    *peak_out = ff_tonemap_peak_update(&s->peak_state, &stats);
+    return 0;
+}
+
+static int tonemap_vulkan_get_peak(AVFilterContext *ctx, AVFrame *in, double *peak_out)
+{
+    TonemapVulkanContext *s = ctx->priv;
+    double peak = s->peak;
+    int err;
+
+    if (s->peak_detect) {
+        if (ff_tonemap_peak_read_l1(in, &peak)) {
+            av_log(ctx, AV_LOG_VERBOSE, "Dolby Vision L1 signal peak: %f\n", peak);
+        } else {
+            err = detect_signal_peak(ctx, in, &peak);
+            if (err < 0)
+                return err;
+            av_log(ctx, AV_LOG_VERBOSE, "Detected signal peak: %f\n", peak);
+        }
+    } else if (!peak) {
+        peak = ff_determine_signal_peak(in);
+        av_log(ctx, AV_LOG_DEBUG, "Computed signal peak: %f\n", peak);
+    }
+
+    *peak_out = peak;
+    return 0;
+}
+
 static int tonemap_vulkan_filter_frame(AVFilterLink *link, AVFrame *in)
 {
     AVFilterContext *ctx = link->dst;
     TonemapVulkanContext *s = ctx->priv;
     AVFilterLink *outlink = ctx->outputs[0];
-    double peak = s->peak ? s->peak : ff_determine_signal_peak(in);
     AVFrame *out;
+    double peak;
     int err;
 
     out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
@@ -270,7 +543,9 @@ static int tonemap_vulkan_filter_frame(AVFilterLink *link, AVFrame *in)
         }
     }
 
-    err = setup_bt2408(ctx, in, peak);
+    err = tonemap_vulkan_get_peak(ctx, in, &peak);
+    if (err >= 0)
+        err = setup_bt2408(ctx, in, peak);
     if (err < 0) {
         av_frame_free(&in);
         av_frame_free(&out);
@@ -339,6 +614,8 @@ static const AVOption tonemap_vulkan_options[] = {
     { "tonemap", "tone map algorithm selection", OFFSET(tonemap), AV_OPT_TYPE_INT, { .i64 = TONEMAP_BT2408_HABLE }, 0, TONEMAP_NB - 1, FLAGS, .unit = "tonemap" },
     {     "bt2408_hable", "ITU-R BT.2408 tone mapping with Hable curve on IPT", 0, AV_OPT_TYPE_CONST, { .i64 = TONEMAP_BT2408_HABLE }, 0, 0, FLAGS, .unit = "tonemap" },
     { "peak", "signal peak override (units of 100 cd/m^2)", OFFSET(peak), AV_OPT_TYPE_DOUBLE, { .dbl = 0.0 }, 0.0, DBL_MAX, FLAGS },
+    { "peak_detect", "measure signal peak from frames", OFFSET(peak_detect), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, FLAGS },
+    { "threshold", "scene detection threshold", OFFSET(threshold), AV_OPT_TYPE_DOUBLE, { .dbl = 0.2 }, 0.0, DBL_MAX, FLAGS },
     { "format", "output pixel format", OFFSET(format), AV_OPT_TYPE_PIXEL_FMT, { .i64 = AV_PIX_FMT_NV12 }, AV_PIX_FMT_NONE, INT_MAX, FLAGS, .unit = "fmt" },
     { NULL }
 };
