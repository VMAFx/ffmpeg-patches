+static void set_p81_header(AVDOVIRpuDataHeader *hdr)
+{
+    hdr->vdr_rpu_profile = 1;
+    hdr->bl_video_full_range_flag = 0;
+    hdr->el_spatial_resampling_filter_flag = 0;
+    hdr->disable_residual_flag = 1;
+}
+
+static void set_p81_mapping(AVDOVIDataMapping *mapping, int coef_log2_denom)
+{
+    mapping->nlq_method_idc = AV_DOVI_NLQ_NONE;
+    mapping->num_x_partitions = 1;
+    mapping->num_y_partitions = 1;
+    memset(mapping->nlq, 0, sizeof(mapping->nlq));
+    memset(mapping->nlq_pivots, 0, sizeof(mapping->nlq_pivots));
+
+    for (int c = 0; c < 3; c++) {
+        AVDOVIReshapingCurve *curve = &mapping->curves[c];
+        memset(curve, 0, sizeof(*curve));
+        curve->num_pivots = 2;
+        curve->pivots[0] = 0;
+        curve->pivots[1] = 1023;
+        curve->mapping_idc[0] = AV_DOVI_MAPPING_POLYNOMIAL;
+        curve->poly_order[0] = 1;
+        curve->poly_coef[0][0] = 0;
+        curve->poly_coef[0][1] = 1LL << coef_log2_denom;
+        curve->poly_coef[0][2] = 0;
+    }
+}
+
+static void set_p81_color(AVDOVIColorMetadata *color)
+{
+    static const int16_t ycc_to_rgb_matrix[9] = {
+        9574,     0, 13802,
+        9574, -1540, -5348,
+        9574, 17610,     0
+    };
+    static const int32_t ycc_to_rgb_offset[3] = {
+        16777216, 134217728, 134217728
+    };
+    static const int16_t rgb_to_lms_matrix[9] = {
+        7222,  8771,   390,
+        2654, 12430,  1300,
+           0,   422, 15962
+    };
+
+    for (int i = 0; i < 9; i++) {
+        color->ycc_to_rgb_matrix[i] = av_make_q(ycc_to_rgb_matrix[i], 8192);
+        color->rgb_to_lms_matrix[i] = av_make_q(rgb_to_lms_matrix[i], 16384);
+    }
+    for (int i = 0; i < 3; i++)
+        color->ycc_to_rgb_offset[i] = av_make_q(ycc_to_rgb_offset[i], 1 << 28);
+
+    color->signal_color_space = 0;
+}
+
+static void drop_l5_ext_blocks(AVDOVIMetadata *md)
+{
+    int w = 0;
+    for (int i = 0; i < md->num_ext_blocks; i++) {
+        AVDOVIDmData *ext = av_dovi_get_ext(md, i);
+        if (ext->level == 5)
+            continue;
+        if (w != i)
+            memmove(av_dovi_get_ext(md, w), ext, md->ext_block_size);
+        w++;
+    }
+    md->num_ext_blocks = w;
+}
+
+int ff_dovi_reshape_to_p81(AVDOVIMetadata *md)
+{
+    AVDOVIRpuDataHeader *hdr;
+    AVDOVIDataMapping *mapping;
+    AVDOVIColorMetadata *color;
+
+    if (!md)
+        return AVERROR(EINVAL);
+
+    hdr = av_dovi_get_header(md);
+    mapping = av_dovi_get_mapping(md);
+    color = av_dovi_get_color(md);
+
+    set_p81_header(hdr);
+    set_p81_mapping(mapping, hdr->coef_log2_denom);
+    set_p81_color(color);
+    drop_l5_ext_blocks(md);
+
+    return 0;
+}
diff --git a/libavfilter/dovi_reshape.h b/libavfilter/dovi_reshape.h
index f5e2543129f94225f5f9059006368aad1ce0d6a7..fe69158a74d07e4e286b6a5ab43dcc210525978d 100644
--- a/libavfilter/dovi_reshape.h
+++ b/libavfilter/dovi_reshape.h
@@ -78,4 +78,12 @@ float ff_dovi_reshape_comp(const FFDoviCurve *curve, const float sig[3], int c);
  */
 void ff_dovi_reshape_pixel(const FFDoviReshape *s, const float ycc[3], float rgb[3]);
 
+/**
+ * Convert Dolby Vision metadata in-place to profile 8.1.
+ *
+ * @param md metadata to convert
+ * @return 0 on success, negative AVERROR on failure
+ */
+int ff_dovi_reshape_to_p81(AVDOVIMetadata *md);
+
 #endif /* AVFILTER_DOVI_RESHAPE_H */
diff --git a/libavfilter/vf_dovi_reshape.c b/libavfilter/vf_dovi_reshape.c
index ce81cb39bbe891bee0a61fd3a80a0346b8f48ac1..c218366ed253fa8d601eac7fca33a00a5e20c6da 100644
--- a/libavfilter/vf_dovi_reshape.c
+++ b/libavfilter/vf_dovi_reshape.c
@@ -30,6 +30,7 @@
 #include "libavutil/frame.h"
 #include "libavutil/mastering_display_metadata.h"
 #include "libavutil/mem.h"
+#include "libavutil/opt.h"
 #include "libavutil/pixdesc.h"
 
 #include "avfilter.h"
@@ -44,8 +45,14 @@ typedef struct ChromaTaps {
     float *w;
 } ChromaTaps;
 
+enum DoviReshapeRPU {
+    RPU_STRIP = 0,
+    RPU_P81   = 1,
+};
+
 typedef struct DoviReshapeContext {
     const AVClass *class;
+    int rpu;
     const AVPixFmtDescriptor *desc;
     float norm;
     int loc;                 ///< chroma location the taps were built for, or -1
@@ -237,7 +244,7 @@ static int set_light_level(AVFrame *out, av_csp_trc_function pq_eotf)
 }
 
 /* The reshaped signal is described by the RPU, not by the base layer. */
-static int set_output_props(AVFrame *out, const FFDoviReshape *rs)
+static int set_output_props(AVFrame *out, const FFDoviReshape *rs, int rpu)
 {
     const av_csp_trc_function pq_eotf = av_csp_trc_func_inv_from_id(AVCOL_TRC_SMPTE2084);
     const AVColorPrimariesDesc *bt2020 = av_csp_primaries_desc_from_id(AVCOL_PRI_BT2020);
@@ -246,7 +253,21 @@ static int set_output_props(AVFrame *out, const FFDoviReshape *rs)
 
     if (ret < 0)
         return ret;
-    av_frame_remove_side_data(out, AV_FRAME_DATA_DOVI_METADATA);
+
+    if (rpu == RPU_P81) {
+        AVFrameSideData *sd = av_frame_get_side_data(out, AV_FRAME_DATA_DOVI_METADATA);
+        if (!sd)
+            return AVERROR(EINVAL);
+        ret = av_buffer_make_writable(&sd->buf);
+        if (ret < 0)
+            return ret;
+        sd->data = sd->buf->data;
+        ret = ff_dovi_reshape_to_p81((AVDOVIMetadata *)sd->data);
+        if (ret < 0)
+            return ret;
+    } else {
+        av_frame_remove_side_data(out, AV_FRAME_DATA_DOVI_METADATA);
+    }
     av_frame_remove_side_data(out, AV_FRAME_DATA_DOVI_RPU_BUFFER);
     av_frame_remove_side_data(out, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA);
 
@@ -298,6 +319,7 @@ static int check_input(AVFilterContext *ctx, const AVFrame *in, FFDoviReshape *r
 static int filter_frame(AVFilterLink *inlink, AVFrame *in)
 {
     AVFilterContext *ctx  = inlink->dst;
+    DoviReshapeContext *s = ctx->priv;
     AVFilterLink *outlink = ctx->outputs[0];
     FFDoviReshape rs;
     ThreadData td;
@@ -306,7 +328,7 @@ static int filter_frame(AVFilterLink *inlink, AVFrame *in)
 
     ret = check_input(ctx, in, &rs);
     if (ret >= 0)
-        ret = update_taps(ctx->priv, in);
+        ret = update_taps(s, in);
     if (ret < 0) {
         av_frame_free(&in);
         return ret;
@@ -319,7 +341,7 @@ static int filter_frame(AVFilterLink *inlink, AVFrame *in)
     }
     ret = av_frame_copy_props(out, in);
     if (ret >= 0)
-        ret = set_output_props(out, &rs);
+        ret = set_output_props(out, &rs, s->rpu);
     if (ret < 0) {
         av_frame_free(&in);
         av_frame_free(&out);
@@ -341,13 +363,18 @@ static av_cold void uninit(AVFilterContext *ctx)
     free_taps(&s->ty);
 }
 
