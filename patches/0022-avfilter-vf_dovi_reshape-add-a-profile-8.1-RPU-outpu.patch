-    .class_name = "dovi_reshape",
-    .item_name  = av_default_item_name,
-    .version    = LIBAVUTIL_VERSION_INT,
-    .category   = AV_CLASS_CATEGORY_FILTER,
+#define OFFSET(x) offsetof(DoviReshapeContext, x)
+#define FLAGS AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_FILTERING_PARAM
+
+static const AVOption dovi_reshape_options[] = {
+    { "rpu", "Dolby Vision RPU processing mode", OFFSET(rpu), AV_OPT_TYPE_INT, { .i64 = RPU_STRIP }, 0, 1, FLAGS, .unit = "rpu" },
+        { "strip", "remove Dolby Vision RPU metadata", 0, AV_OPT_TYPE_CONST, { .i64 = RPU_STRIP }, 0, 0, FLAGS, .unit = "rpu" },
+        { "p81",   "convert Dolby Vision RPU to profile 8.1", 0, AV_OPT_TYPE_CONST, { .i64 = RPU_P81 },   0, 0, FLAGS, .unit = "rpu" },
+    { NULL }
 };
 
+AVFILTER_DEFINE_CLASS(dovi_reshape);
+
 static const AVFilterPad dovi_reshape_inputs[] = {
     {
         .name         = "default",
