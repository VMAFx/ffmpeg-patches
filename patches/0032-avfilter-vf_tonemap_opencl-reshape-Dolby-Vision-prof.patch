 } TonemapOpenCLContext;
 
 static const char *const linearize_funcs[] = {
@@ -118,11 +123,92 @@ static int get_rgb2rgb_matrix(enum AVColorPrimaries in, enum AVColorPrimaries ou
     return 0;
 }
 
-#define OPENCL_SOURCE_NB 4
+#define OPENCL_SOURCE_NB 5
 // Average light level for SDR signals. This is equal to a signal level of 0.5
 // under a typical presentation gamma of about 2.0.
 static const float sdr_avg = 0.25f;
 
+static int print_transfer_and_luma(AVFilterContext *avctx, AVBPrint *header)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    double rgb2yuv[3][3], yuv2rgb[3][3];
+    const AVLumaCoefficients *luma_src = av_csp_luma_coeffs_from_avcsp(ctx->colorspace_in);
+    const AVLumaCoefficients *luma_dst = av_csp_luma_coeffs_from_avcsp(ctx->colorspace_out);
+
+    if (!luma_src || !luma_dst)
+        return AVERROR(EINVAL);
+
+    ff_fill_rgb2yuv_table(luma_dst, rgb2yuv);
+    ff_opencl_print_const_matrix_3x3(header, "yuv_matrix", rgb2yuv);
+
+    ff_fill_rgb2yuv_table(luma_src, rgb2yuv);
+    ff_matrix_invert_3x3(rgb2yuv, yuv2rgb);
+    ff_opencl_print_const_matrix_3x3(header, "rgb_matrix", yuv2rgb);
+
+    av_bprintf(header, "constant float3 luma_src = {%.4ff, %.4ff, %.4ff};\n",
+               av_q2d(luma_src->cr), av_q2d(luma_src->cg), av_q2d(luma_src->cb));
+    av_bprintf(header, "constant float3 luma_dst = {%.4ff, %.4ff, %.4ff};\n",
+               av_q2d(luma_dst->cr), av_q2d(luma_dst->cg), av_q2d(luma_dst->cb));
+
+    av_bprintf(header, "#define linearize %s\n", linearize_funcs[ctx->trc_in]);
+    av_bprintf(header, "#define delinearize %s\n", delinearize_funcs[ctx->trc_out]);
+
+    if (ctx->trc_in == AVCOL_TRC_ARIB_STD_B67)
+        av_bprintf(header, "#define ootf_impl ootf_hlg\n");
+    if (ctx->trc_out == AVCOL_TRC_ARIB_STD_B67)
+        av_bprintf(header, "#define inverse_ootf_impl inverse_ootf_hlg\n");
+
+    return 0;
+}
+
+static int build_opencl_header(AVFilterContext *avctx, AVBPrint *header)
+{
+    TonemapOpenCLContext *ctx = avctx->priv;
+    int rgb2rgb_passthrough = 1, err;
+    double rgb2rgb[3][3];
+
+    av_bprintf(header, "__constant const float tone_param = %.4ff;\n", ctx->param);
+    av_bprintf(header, "__constant const float desat_param = %.4ff;\n", ctx->desat_param);
+    av_bprintf(header, "__constant const float target_peak = %.4ff;\n", ctx->target_peak);
+    av_bprintf(header, "__constant const float sdr_avg = %.4ff;\n", sdr_avg);
+    av_bprintf(header, "__constant const float scene_threshold = %.4ff;\n", ctx->scene_threshold);
+    av_bprintf(header, "#define TONE_FUNC %s\n", tonemap_func[ctx->tonemap]);
+    av_bprintf(header, "#define DETECTION_FRAMES %d\n", DETECTION_FRAMES);
+
+    if (ctx->primaries_out != ctx->primaries_in) {
+        err = get_rgb2rgb_matrix(ctx->primaries_in, ctx->primaries_out, rgb2rgb);
+        if (err < 0)
+            return err;
+        rgb2rgb_passthrough = 0;
+    }
+    if (ctx->range_in == AVCOL_RANGE_JPEG)
+        av_bprintf(header, "#define FULL_RANGE_IN\n");
+    if (ctx->range_out == AVCOL_RANGE_JPEG)
+        av_bprintf(header, "#define FULL_RANGE_OUT\n");
+    if (ctx->ocf.output_format == AV_PIX_FMT_P010)
+        av_bprintf(header, "#define BT2408_OUT_P010\n");
+
+    av_bprintf(header, "#define chroma_loc %d\n", (int)ctx->chroma_loc);
+
+    if (ctx->dovi_mode) {
+        int xpos = 0, ypos = 0;
+        enum AVChromaLocation loc = ctx->chroma_loc;
+        if (loc == AVCHROMA_LOC_UNSPECIFIED)
+            loc = AVCHROMA_LOC_LEFT;
+        av_chroma_location_enum_to_pos(&xpos, &ypos, loc);
+        av_bprintf(header, "#define DOVI_RESHAPE 1\n");
+        av_bprintf(header, "#define CHROMA_OFFSET_X %.4ff\n", xpos / 256.0f);
+        av_bprintf(header, "#define CHROMA_OFFSET_Y %.4ff\n", ypos / 256.0f);
+    }
+
+    if (rgb2rgb_passthrough)
+        av_bprintf(header, "#define RGB2RGB_PASSTHROUGH\n");
+    else
+        ff_opencl_print_const_matrix_3x3(header, "rgb2rgb", rgb2rgb);
+
+    return print_transfer_and_luma(avctx, header);
+}
+
 static int create_opencl_objects(AVFilterContext *avctx)
 {
     unsigned util_init[2 * DETECTION_FRAMES + 7] = { 0 };
@@ -162,20 +248,24 @@ static int create_opencl_objects(AVFilterContext *avctx)
         return AVERROR(EIO);
