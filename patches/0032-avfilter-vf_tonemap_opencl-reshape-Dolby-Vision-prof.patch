diff --git a/libavfilter/opencl/bt2408_hable.cl b/libavfilter/opencl/bt2408_hable.cl
index 26b93afa99990a91653c835446a84b6895427537..ced0a49ddf572639355fc94fe7b1bef349f3112b 100644
--- a/libavfilter/opencl/bt2408_hable.cl
+++ b/libavfilter/opencl/bt2408_hable.cl
@@ -153,12 +153,53 @@ float3 bt2408_hable_pixel(constant const struct bt2408_hable *s, float3 rgb) {
     return powr(clamp(out, 0.0f, 1.0f), 2.4f);
 }
 
+#ifdef DOVI_RESHAPE
+// Bilinear chroma interpolation matching vf_dovi_reshape.c (update_taps/chroma).
+// For 4:2:0 subsampled input, the continuous chroma position for sample (x, y) is:
+//   pos_x = (x - CHROMA_OFFSET_X) / 2.0
+//   pos_y = (y - CHROMA_OFFSET_Y) / 2.0
+// clamped to [0, cw - 1] and [0, ch - 1]. The two nearest chroma samples per axis
+// (i0, i1) and (j0, j1) are blended with weights wx = pos_x - i0, wy = pos_y - j0.
+static float2 get_interpolated_chroma(__read_only image2d_t src2, sampler_t sampler,
+                                      int x, int y, int cw, int ch)
+{
+    float pos_x = clamp(((float)x - CHROMA_OFFSET_X) * 0.5f, 0.0f, (float)(cw - 1));
+    float pos_y = clamp(((float)y - CHROMA_OFFSET_Y) * 0.5f, 0.0f, (float)(ch - 1));
+    int i0 = min((int)pos_x, cw - 1);
+    int i1 = min(i0 + 1, cw - 1);
+    int j0 = min((int)pos_y, ch - 1);
+    int j1 = min(j0 + 1, ch - 1);
+    float wx = pos_x - (float)i0;
+    float wy = pos_y - (float)j0;
+
+    float2 r00 = read_imagef(src2, sampler, (int2)(i0, j0)).xy;
+    float2 r10 = read_imagef(src2, sampler, (int2)(i1, j0)).xy;
+    float2 r01 = read_imagef(src2, sampler, (int2)(i0, j1)).xy;
+    float2 r11 = read_imagef(src2, sampler, (int2)(i1, j1)).xy;
+
+    float2 top = r00 * (1.0f - wx) + r10 * wx;
+    float2 bot = r01 * (1.0f - wx) + r11 * wx;
+    return top + (bot - top) * wy;
+}
+
+static float3 dovi_ycc2lrgb(constant const struct dovi_reshape *rs, float3 ycc)
+{
+    float3 norm = (ycc * BT2408_IN_CODE) / 1023.0f;
+    float3 rgb = dovi_reshape_pixel(rs, norm);
+    return (float3)(linearize(rgb.x), linearize(rgb.y), linearize(rgb.z));
+}
+#endif
+
 __kernel void tonemap_bt2408(__write_only image2d_t dst1,
                              __read_only  image2d_t src1,
                              __write_only image2d_t dst2,
                              __read_only  image2d_t src2,
                              constant const struct bt2408_hable *s,
-                             float peak)
+                             float peak
+#ifdef DOVI_RESHAPE
+                           , constant const struct dovi_reshape *rs
+#endif
+)
 {
     const sampler_t sampler = (CLK_NORMALIZED_COORDS_FALSE |
                                CLK_ADDRESS_CLAMP_TO_EDGE   |
@@ -173,12 +214,27 @@ __kernel void tonemap_bt2408(__write_only image2d_t dst1,
     float y1 = read_imagef(src1, sampler, (int2)(x + 1, y)).x;
     float y2 = read_imagef(src1, sampler, (int2)(x,     y + 1)).x;
     float y3 = read_imagef(src1, sampler, (int2)(x + 1, y + 1)).x;
+
+#ifdef DOVI_RESHAPE
+    int cw = get_image_width(src2);
+    int ch = get_image_height(src2);
+    float2 uv0 = get_interpolated_chroma(src2, sampler, x,     y,     cw, ch);
+    float2 uv1 = get_interpolated_chroma(src2, sampler, x + 1, y,     cw, ch);
+    float2 uv2 = get_interpolated_chroma(src2, sampler, x,     y + 1, cw, ch);
+    float2 uv3 = get_interpolated_chroma(src2, sampler, x + 1, y + 1, cw, ch);
+
+    float3 c0 = bt2408_hable_pixel(s, ootf(dovi_ycc2lrgb(rs, (float3)(y0, uv0.x, uv0.y)), peak));
+    float3 c1 = bt2408_hable_pixel(s, ootf(dovi_ycc2lrgb(rs, (float3)(y1, uv1.x, uv1.y)), peak));
+    float3 c2 = bt2408_hable_pixel(s, ootf(dovi_ycc2lrgb(rs, (float3)(y2, uv2.x, uv2.y)), peak));
+    float3 c3 = bt2408_hable_pixel(s, ootf(dovi_ycc2lrgb(rs, (float3)(y3, uv3.x, uv3.y)), peak));
+#else
     float2 uv = read_imagef(src2, sampler, (int2)(xi,     yi)).xy;
 
     float3 c0 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y0, uv.x, uv.y)), peak));
     float3 c1 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y1, uv.x, uv.y)), peak));
     float3 c2 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y2, uv.x, uv.y)), peak));
     float3 c3 = bt2408_hable_pixel(s, ootf(bt2408_yuv2lrgb((float3)(y3, uv.x, uv.y)), peak));
+#endif
 
     // Subsample the encoded values, as a software scaler does.
     float3 e0 = bt2408_lrgb2yuv(c0), e1 = bt2408_lrgb2yuv(c1);
diff --git a/libavfilter/opencl/dovi_reshape.cl b/libavfilter/opencl/dovi_reshape.cl
new file mode 100644
index 0000000000000000000000000000000000000000..015bb69e3745b3e81bbfd4b63070ae09f8d6172d
--- /dev/null
+++ b/libavfilter/opencl/dovi_reshape.cl
@@ -0,0 +1,139 @@
+/*
+ * Dolby Vision profile 5 reshaping and IPT-PQ-C2 decoding
+ *
+ * The per-pixel reshaping and decoding follow libplacebo v7.360.1
+ * (src/shaders/colorspace.c: pl_shader_dovi_reshape, pl_shader_decode_color),
+ * Copyright (C) Niklas Haas and the libplacebo contributors, licensed under
+ * the GNU Lesser General Public License version 2.1 or later.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#define DOVI_MAX_PIECES 8
+
+struct dovi_curve {
+    int   num_pivots;
+    float pivots[DOVI_MAX_PIECES + 1];
+    int   method[DOVI_MAX_PIECES];
+    float poly[DOVI_MAX_PIECES][3];
+    int   mmr_order[DOVI_MAX_PIECES];
+    float mmr_constant[DOVI_MAX_PIECES];
+    float mmr[DOVI_MAX_PIECES][3][7];
+};
+
+struct dovi_reshape {
+    struct dovi_curve curve[3];
+    float ycc_to_rgb[3][3];
+    float ycc_offset[3];
+    float lms_to_rgb[3][3];
+    float min_pq;
+    float max_pq;
+};
+
+constant const float DOVI_M1 = 2610.0f / 4096.0f / 4.0f;
+constant const float DOVI_M2 = 2523.0f / 4096.0f * 128.0f;
+constant const float DOVI_C1 = 3424.0f / 4096.0f;
+constant const float DOVI_C2 = 2413.0f / 4096.0f * 32.0f;
+constant const float DOVI_C3 = 2392.0f / 4096.0f * 32.0f;
+
+static float dovi_pq_eotf(float x)
+{
+    float p = powr(max(x, 0.0f), 1.0f / DOVI_M2);
+    return powr(max(p - DOVI_C1, 0.0f) / (DOVI_C2 - DOVI_C3 * p),
+                1.0f / DOVI_M1) * 10000.0f;
+}
+
+static float dovi_pq_oetf(float nits)
+{
+    float y = powr(max(nits, 0.0f) / 10000.0f, DOVI_M1);
+    return powr((DOVI_C1 + DOVI_C2 * y) / (1.0f + DOVI_C3 * y), DOVI_M2);
+}
+
+static float dovi_reshape_mmr(constant const struct dovi_curve *curve, int i, float3 sig)
+{
+    const float x[7] = {
+        sig.x, sig.y, sig.z,
+        sig.x * sig.y, sig.x * sig.z, sig.y * sig.z,
+        sig.x * sig.y * sig.z,
+    };
+    float pow_x[7];
+    float s = curve->mmr_constant[i];
+
+    for (int k = 0; k < 7; k++)
+        pow_x[k] = x[k];
+
+    int order = clamp(curve->mmr_order[i], 1, 3);
+    for (int j = 0; j < order; j++) {
+        for (int k = 0; k < 7; k++)
+            s += curve->mmr[i][j][k] * pow_x[k];
+        for (int k = 0; k < 7; k++)
+            pow_x[k] *= x[k];
+    }
+    return s;
+}
+
+static float dovi_reshape_comp(constant const struct dovi_curve *curve, float3 sig, int c)
+{
+    float s = (c == 0) ? sig.x : ((c == 1) ? sig.y : sig.z);
+    int i = 0;
+
+    if (!curve->num_pivots)
+        return s;
+
+    int num_pivots = clamp(curve->num_pivots, 2, DOVI_MAX_PIECES + 1);
+    int max_i = num_pivots - 2;
+    for (int piece = 0; piece < DOVI_MAX_PIECES - 1; piece++) {
+        if (i < max_i && s >= curve->pivots[i + 1])
+            i++;
+        else
+            break;
+    }
+
+    if (curve->method[i] == 0) { /* AV_DOVI_MAPPING_POLYNOMIAL */
+        constant const float *k = curve->poly[i];
+        s = (k[2] * s + k[1]) * s + k[0];
+    } else {
+        s = dovi_reshape_mmr(curve, i, sig);
+    }
+    return clamp(s, curve->pivots[0], curve->pivots[num_pivots - 1]);
+}
+
+static float3 dovi_mul3(constant const float m[3][3], float3 in)
+{
+    return (float3)(m[0][0] * in.x + m[0][1] * in.y + m[0][2] * in.z,
+                    m[1][0] * in.x + m[1][1] * in.y + m[1][2] * in.z,
+                    m[2][0] * in.x + m[2][1] * in.y + m[2][2] * in.z);
+}
+
+float3 dovi_reshape_pixel(constant const struct dovi_reshape *s, float3 ycc)
+{
+    float3 sig = clamp(ycc, 0.0f, 1.0f);
+    float3 ipt, lms, rgb;
+
+    ipt.x = dovi_reshape_comp(&s->curve[0], sig, 0) - s->ycc_offset[0];
+    ipt.y = dovi_reshape_comp(&s->curve[1], sig, 1) - s->ycc_offset[1];
+    ipt.z = dovi_reshape_comp(&s->curve[2], sig, 2) - s->ycc_offset[2];
+
+    lms = dovi_mul3(s->ycc_to_rgb, ipt);
+    lms = (float3)(dovi_pq_eotf(max(lms.x, 0.0f)),
+                   dovi_pq_eotf(max(lms.y, 0.0f)),
+                   dovi_pq_eotf(max(lms.z, 0.0f)));
+    rgb = dovi_mul3(s->lms_to_rgb, lms);
+    return (float3)(dovi_pq_oetf(rgb.x),
+                    dovi_pq_oetf(rgb.y),
+                    dovi_pq_oetf(rgb.z));
+}
