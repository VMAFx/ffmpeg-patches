 libavfilter/opencl/dovi_reshape.cl | 139 ++++++++++
 libavfilter/opencl_source.h        |   1 +
 libavfilter/vf_tonemap_opencl.c    | 423 +++++++++++++++++++----------
 6 files changed, 481 insertions(+), 151 deletions(-)
 create mode 100644 libavfilter/opencl/dovi_reshape.cl

