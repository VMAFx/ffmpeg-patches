From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lusoris <lusoris@proton.me>
Date: Sat, 17 Oct 2026 16:34:10 +0200
Subject: [PATCH] avcodec/qsvdec: discard the right frames on MP4 edit lists

On MP4 input whose edit list starts after a keyframe, h264_qsv and
hevc_qsv return pre-roll frames that the software decoders discard and
discard frames that should be shown instead.

Two defects meet here:

- A frame takes its properties, AV_FRAME_FLAG_DISCARD included, from
  avctx->internal->last_pkt_props when its surface is allocated, which
  is the packet in flight at that time, not the packet the frame was
  decoded from. With reordering and async_depth the flag lands on other
  frames.
- The runtime returns negative TimeStamps rounded to a multiple of
  2048, as if they had passed through a double near 2^64. Pre-roll
  timestamps then repeat, guess_correct_pts() falls back to pkt_dts,
  which comes from a later packet, and the timestamps of the output
  shift.

Shift every TimeStamp by 2^52 so the runtime only sees positive values
below 2^53, and remember the TimeStamps of submitted packets flagged
AV_PKT_FLAG_DISCARD. The discard flag of an output frame is set when
the TimeStamp of its surface is one of them and cleared otherwise.
Other properties taken at allocation, such as side data and duration,
still come from the packet in flight.

Reproducer:

  ffmpeg -f lavfi -i testsrc2=s=128x96:r=60:d=3 -c:v libx264 -crf 45 \
    -bf 3 -g 120 -keyint_min 120 -sc_threshold 0 -pix_fmt yuv420p src.mp4
  ffmpeg -ss 1.5 -i src.mp4 -c copy editlist.mp4
  ffmpeg -init_hw_device qsv=hw -c:v h264_qsv -i editlist.mp4 \
    -pix_fmt nv12 -f framecrc -

Without this patch the last command writes 88 frames, the first two of
them from the pre-roll; with it, the same 90 frames as -c:v h264.

Reported-by: Lawrence Curtis <11704+lawrencecurtis@users.noreply.github.com>
Signed-off-by: lusoris <lusoris@proton.me>
---
 libavcodec/qsvdec.c | 110 +++++++++++++++++++++++++++++++++++++-------
 1 file changed, 94 insertions(+), 16 deletions(-)

diff --git a/libavcodec/qsvdec.c b/libavcodec/qsvdec.c
index 5aacde978577e323231adcf3d6e663f46e25da39..c3cfa87611a3200057266447a1511382817c0de7 100644
--- a/libavcodec/qsvdec.c
+++ b/libavcodec/qsvdec.c
@@ -61,13 +61,29 @@
 
 static const AVRational mfx_tb = { 1, 90000 };
 
-#define PTS_TO_MFX_PTS(pts, pts_tb) ((pts) == AV_NOPTS_VALUE ? \
-    MFX_TIMESTAMP_UNKNOWN : pts_tb.num ? \
-    av_rescale_q(pts, pts_tb, mfx_tb) : pts)
+/* The runtime does not return every TimeStamp exactly: negative values come
+ * back rounded to a multiple of 2048, as if they had passed through a double.
+ * Shifting them into [0, 2^53) keeps them exact. */
+#define MFX_PTS_OFFSET (INT64_C(1) << 52)
 
-#define MFX_PTS_TO_PTS(mfx_pts, pts_tb) ((mfx_pts) == MFX_TIMESTAMP_UNKNOWN ? \
-    AV_NOPTS_VALUE : pts_tb.num ? \
-    av_rescale_q(mfx_pts, mfx_tb, pts_tb) : mfx_pts)
+static mfxU64 pts_to_mfx_pts(int64_t pts, AVRational pts_tb)
+{
+    if (pts == AV_NOPTS_VALUE)
+        return MFX_TIMESTAMP_UNKNOWN;
+    if (pts_tb.num)
+        pts = av_rescale_q(pts, pts_tb, mfx_tb);
+    return pts + MFX_PTS_OFFSET;
+}
+
+static int64_t mfx_pts_to_pts(mfxU64 mfx_pts, AVRational pts_tb)
+{
+    int64_t pts;
+
+    if (mfx_pts == MFX_TIMESTAMP_UNKNOWN)
+        return AV_NOPTS_VALUE;
+    pts = (int64_t)mfx_pts - MFX_PTS_OFFSET;
+    return pts_tb.num ? av_rescale_q(pts, mfx_tb, pts_tb) : pts;
+}
 
 #define MFX_IMPL_VIA_MASK(impl) (0x0f00 & (impl))
 
@@ -113,6 +129,15 @@ typedef struct QSVContext {
 
     mfxExtBuffer **ext_buffers;
     int         nb_ext_buffers;
+
+    /**
+     * TimeStamps of submitted packets flagged AV_PKT_FLAG_DISCARD, oldest
+     * first. A frame gets its properties from the packet in flight when its
+     * surface was allocated, not from its own packet, so the discard flag is
+     * set again from the TimeStamp of the output surface.
+     */
+    mfxU64 discard_ts[64];
+    int nb_discard_ts;
 } QSVContext;
 
 static const AVCodecHWConfigInternal *const qsv_hw_configs[] = {
@@ -435,7 +460,7 @@ static int qsv_decode_header(AVCodecContext *avctx, QSVContext *q,
         bs.Data       = avpkt->data;
         bs.DataLength = avpkt->size;
         bs.MaxLength  = bs.DataLength;
-        bs.TimeStamp  = PTS_TO_MFX_PTS(avpkt->pts, avctx->pkt_timebase);
+        bs.TimeStamp  = pts_to_mfx_pts(avpkt->pts, avctx->pkt_timebase);
         if (avctx->field_order == AV_FIELD_PROGRESSIVE)
             bs.DataFlag   |= MFX_BITSTREAM_COMPLETE_FRAME;
     } else
@@ -785,6 +810,65 @@ static int qsv_export_hdr_side_data_av1(AVCodecContext *avctx, mfxExtMasteringDi
 
 #endif
 
+static void add_discard_ts(QSVContext *q, mfxU64 ts)
+{
+    const int max = FF_ARRAY_ELEMS(q->discard_ts);
+
+    if (ts == MFX_TIMESTAMP_UNKNOWN)
+        return;
+    for (int i = 0; i < q->nb_discard_ts; i++)
+        if (q->discard_ts[i] == ts)
+            return;
+    /* a packet that never produced a frame leaves its entry behind; the
+     * oldest entry goes first */
+    if (q->nb_discard_ts == max) {
+        memmove(q->discard_ts, q->discard_ts + 1,
+                (max - 1) * sizeof(*q->discard_ts));
+        q->nb_discard_ts--;
+    }
+    q->discard_ts[q->nb_discard_ts++] = ts;
+}
+
+static int take_discard_ts(QSVContext *q, mfxU64 ts)
+{
+    if (ts == MFX_TIMESTAMP_UNKNOWN)
+        return 0;
+    for (int i = 0; i < q->nb_discard_ts; i++) {
+        if (q->discard_ts[i] == ts) {
+            memmove(q->discard_ts + i, q->discard_ts + i + 1,
+                    (q->nb_discard_ts - i - 1) * sizeof(*q->discard_ts));
+            q->nb_discard_ts--;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void init_bitstream(QSVContext *q, AVCodecContext *avctx,
+                           mfxBitstream *bs, const AVPacket *avpkt)
+{
+    if (avpkt->size) {
+        bs->Data       = avpkt->data;
+        bs->DataLength = avpkt->size;
+        bs->MaxLength  = bs->DataLength;
+        bs->TimeStamp  = pts_to_mfx_pts(avpkt->pts, avctx->pkt_timebase);
+        if (avpkt->flags & AV_PKT_FLAG_DISCARD)
+            add_discard_ts(q, bs->TimeStamp);
+        if (avctx->field_order == AV_FIELD_PROGRESSIVE)
+            bs->DataFlag   |= MFX_BITSTREAM_COMPLETE_FRAME;
+    }
+}
+
+static void update_frame_pts(QSVContext *q, AVCodecContext *avctx,
+                             AVFrame *frame, mfxU64 ts)
+{
+    frame->pts = mfx_pts_to_pts(ts, avctx->pkt_timebase);
+    if (take_discard_ts(q, ts))
+        frame->flags |= AV_FRAME_FLAG_DISCARD;
+    else
+        frame->flags &= ~AV_FRAME_FLAG_DISCARD;
+}
+
 static int qsv_decode(AVCodecContext *avctx, QSVContext *q,
                       AVFrame *frame, int *got_frame,
                       const AVPacket *avpkt)
@@ -795,14 +879,7 @@ static int qsv_decode(AVCodecContext *avctx, QSVContext *q,
     mfxBitstream bs = { { { 0 } } };
     int ret;
 
-    if (avpkt->size) {
-        bs.Data       = avpkt->data;
-        bs.DataLength = avpkt->size;
-        bs.MaxLength  = bs.DataLength;
-        bs.TimeStamp  = PTS_TO_MFX_PTS(avpkt->pts, avctx->pkt_timebase);
-        if (avctx->field_order == AV_FIELD_PROGRESSIVE)
-            bs.DataFlag   |= MFX_BITSTREAM_COMPLETE_FRAME;
-    }
+    init_bitstream(q, avctx, &bs, avpkt);
 
     sync = av_mallocz(sizeof(*sync));
     if (!sync) {
@@ -896,7 +973,7 @@ static int qsv_decode(AVCodecContext *avctx, QSVContext *q,
 
         outsurf = &aframe.frame->surface;
 
-        frame->pts = MFX_PTS_TO_PTS(outsurf->Data.TimeStamp, avctx->pkt_timebase);
+        update_frame_pts(q, avctx, frame, outsurf->Data.TimeStamp);
 #if QSV_VERSION_ATLEAST(1, 34)
         if ((avctx->export_side_data & AV_CODEC_EXPORT_DATA_FILM_GRAIN) &&
             QSV_RUNTIME_VERSION_ATLEAST(q->ver, 1, 34) &&
@@ -1212,6 +1289,7 @@ static void qsv_decode_flush(AVCodecContext *avctx)
 
     s->qsv.orig_pix_fmt = AV_PIX_FMT_NONE;
     s->qsv.initialized = 0;
+    s->qsv.nb_discard_ts = 0;
 }
 
 #define OFFSET(x) offsetof(QSVDecContext, x)
