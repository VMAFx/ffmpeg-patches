From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lusoris <lusoris@proton.me>
Date: Fri, 20 Nov 2026 22:33:35 +0100
Subject: [PATCH] avfilter/tests/hqdn3d_vulkan: cover samples above the bit
 depth

Feed a 2x2 YUV420P12 frame whose luma rows hold 1000 and 5120 (5120
sets a bit above the 12-bit depth) through the CPU filter and the
Vulkan filter and compare the outputs. Both mask each sample to its
depth first, so the case checks that the shaders drop the high bits
the same way the CPU filter does since "avfilter/vf_hqdn3d: mask high
bit depth samples to their depth".

The edge frame allocation and the edge run are shared with the
existing negative-value case.

Signed-off-by: lusoris <lusoris@proton.me>
---
 libavfilter/tests/hqdn3d_vulkan.c   | 121 ++++++++++++++++++----------
 tests/ref/fate/filter-hqdn3d-vulkan |   1 +
 2 files changed, 81 insertions(+), 41 deletions(-)

diff --git a/libavfilter/tests/hqdn3d_vulkan.c b/libavfilter/tests/hqdn3d_vulkan.c
index 9ac064436c816bef93ac1625049a06367de49bb0..2d8e791f55775bd8fc7a3bc4fbc5b08e933d53be 100644
--- a/libavfilter/tests/hqdn3d_vulkan.c
+++ b/libavfilter/tests/hqdn3d_vulkan.c
@@ -972,8 +972,8 @@ end:
     return err;
 }
 
-/* Fill a 2x2 yuv420p12 frame: frame 0 all zero, frame 1 luma top row at 4095. */
-static int create_neg_frame(int n, AVFrame **out_frame)
+/* Allocate a zero-filled 2x2 yuv420p12 frame with timestamp n. */
+static int alloc_edge_frame(int n, AVFrame **out_frame)
 {
     AVFrame *f = av_frame_alloc();
     int err;
@@ -997,6 +997,19 @@ static int create_neg_frame(int n, AVFrame **out_frame)
     memset(f->data[1], 0, FFABS(f->linesize[1]));
     memset(f->data[2], 0, FFABS(f->linesize[2]));
 
+    *out_frame = f;
+    return 0;
+}
+
+/* Fill a 2x2 yuv420p12 frame: frame 0 all zero, frame 1 luma top row at 4095. */
+static int create_neg_frame(int n, AVFrame **out_frame)
+{
+    AVFrame *f;
+    int err = alloc_edge_frame(n, &f);
+
+    if (err < 0)
+        return err;
+
     if (n == 1) {
         ((uint16_t *)f->data[0])[0] = 4095;
         ((uint16_t *)f->data[0])[1] = 4095;
@@ -1006,10 +1019,50 @@ static int create_neg_frame(int n, AVFrame **out_frame)
     return 0;
 }
 
-/* Frame 1 drives the temporal result at luma (0,1) to -1, which hqdn3d stores
- * as 65535. Print the CPU luma and whether the GPU output matches the CPU, and
- * count a mismatch in *diffs. */
-static int run_neg_step(AVBufferRef *vk_device_ref, int *diffs)
+/* Fill both luma rows with 1000 and 5120; 5120 sets bits above the 12-bit depth. */
+static int create_upper_frame(int n, AVFrame **out_frame)
+{
+    AVFrame *f;
+    int err = alloc_edge_frame(n, &f);
+
+    if (err < 0)
+        return err;
+
+    ((uint16_t *)f->data[0])[0] = 1000;
+    ((uint16_t *)f->data[0])[1] = 5120;
+    ((uint16_t *)(f->data[0] + f->linesize[0]))[0] = 1000;
+    ((uint16_t *)(f->data[0] + f->linesize[0]))[1] = 5120;
+
+    *out_frame = f;
+    return 0;
+}
+
+/* Print CPU luma for one edge frame and count a GPU mismatch in *diffs. */
+static void print_edge_frame(const AVFrame *cpu_out, const AVFrame *gpu_out,
+                             const char *label, int n, int *diffs)
+{
+    const uint16_t *y0 = (const uint16_t *)cpu_out->data[0];
+    const uint16_t *y1 = (const uint16_t *)(cpu_out->data[0] + cpu_out->linesize[0]);
+
+    printf("%s %d %d %d %s luma %d %d %d %d\n", label, n, gpu_out->width, gpu_out->height,
+           same_word(compare_planes(cpu_out, gpu_out), diffs),
+           y0[0], y0[1], y1[0], y1[1]);
+    fflush(stdout);
+}
+
+/* Release edge-step graphs and frames context, preserving the result code. */
+static int finish_edge_step(AVBufferRef *frames_ref, AVFilterGraph *cpu_graph,
+                            AVFilterGraph *gpu_graph, int err)
+{
+    av_buffer_unref(&frames_ref);
+    avfilter_graph_free(&cpu_graph);
+    avfilter_graph_free(&gpu_graph);
+    return err;
+}
+
+/* Compare at most two edge frames through fresh CPU and Vulkan graphs. */
+static int run_edge_step(AVBufferRef *vk_device_ref, const char *label, int nb_frames,
+                         int (*fill)(int n, AVFrame **out_frame), int *diffs)
 {
     AVBufferRef *frames_ref = NULL;
     AVFilterGraph *cpu_graph = NULL, *gpu_graph = NULL;
@@ -1021,54 +1074,40 @@ static int run_neg_step(AVBufferRef *vk_device_ref, int *diffs)
     err = create_gpu_frames_ctx(vk_device_ref, 2, 2, AV_PIX_FMT_YUV420P12,
                                 AV_HWDEVICE_TYPE_VULKAN, &frames_ref);
     if (err < 0)
-        goto end;
+        return finish_edge_step(frames_ref, cpu_graph, gpu_graph, err);
 
     err = init_cpu_graph(&cpu_graph, &cpu_src, &cpu_sink, 2, 2, AV_PIX_FMT_YUV420P12);
     if (err < 0)
-        goto end;
+        return finish_edge_step(frames_ref, cpu_graph, gpu_graph, err);
 
     err = init_gpu_graph(&gpu_graph, &gpu_src, &gpu_sink, vk_device_ref, frames_ref,
                          AV_HWDEVICE_TYPE_VULKAN);
     if (err < 0)
-        goto end;
-
-    for (int n = 0; n < 2; n++) {
-        const uint16_t *y0;
-        const uint16_t *y1;
-
-        err = create_neg_frame(n, &sw_f);
-        if (err < 0)
-            goto end;
-
-        err = run_cpu_step(cpu_src, cpu_sink, sw_f, &cpu_out);
-        if (err < 0)
-            goto end;
-
-        err = run_gpu_step(gpu_src, gpu_sink, frames_ref, sw_f, &gpu_out);
+        return finish_edge_step(frames_ref, cpu_graph, gpu_graph, err);
+
+    for (int n = 0; n < 2 && n < nb_frames && err >= 0; n++) {
+        err = fill(n, &sw_f);
+        if (err >= 0)
+            err = run_cpu_step(cpu_src, cpu_sink, sw_f, &cpu_out);
+        if (err >= 0)
+            err = run_gpu_step(gpu_src, gpu_sink, frames_ref, sw_f, &gpu_out);
+        if (err >= 0)
+            print_edge_frame(cpu_out, gpu_out, label, n, diffs);
         av_frame_free(&sw_f);
-        if (err < 0)
-            goto end;
-
-        y0 = (const uint16_t *)cpu_out->data[0];
-        y1 = (const uint16_t *)(cpu_out->data[0] + cpu_out->linesize[0]);
-        printf("neg %d %d %d %s luma %d %d %d %d\n", n, gpu_out->width, gpu_out->height,
-               same_word(compare_planes(cpu_out, gpu_out), diffs),
-               y0[0], y0[1], y1[0], y1[1]);
-        fflush(stdout);
-
         av_frame_free(&cpu_out);
         av_frame_free(&gpu_out);
     }
 
-    err = 0;
+    return finish_edge_step(frames_ref, cpu_graph, gpu_graph, err);
+}
 
-end:
-    av_frame_free(&sw_f);
-    av_frame_free(&cpu_out);
-    av_frame_free(&gpu_out);
-    av_buffer_unref(&frames_ref);
-    avfilter_graph_free(&cpu_graph);
-    avfilter_graph_free(&gpu_graph);
+/* Compare negative-result and upper-bit cases against the CPU output. */
+static int run_neg_step(AVBufferRef *vk_device_ref, int *diffs)
+{
+    int err = run_edge_step(vk_device_ref, "neg", 2, create_neg_frame, diffs);
+
+    if (err >= 0)
+        err = run_edge_step(vk_device_ref, "upper", 1, create_upper_frame, diffs);
     return err;
 }
 
diff --git a/tests/ref/fate/filter-hqdn3d-vulkan b/tests/ref/fate/filter-hqdn3d-vulkan
index acd77334243c23508942e547d3633259126ffe35..fbd5e71c796b405108931ca2fdaab51b1c68787a 100644
--- a/tests/ref/fate/filter-hqdn3d-vulkan
+++ b/tests/ref/fate/filter-hqdn3d-vulkan
@@ -19,3 +19,4 @@ p012 1 min 65520 max 65520 low 0
 p012 2 min 65520 max 65520 low 0
 neg 0 2 2 same luma 0 0 0 0
 neg 1 2 2 same luma 4095 4095 65535 0
+upper 0 2 2 same luma 1000 1022 1000 1021
