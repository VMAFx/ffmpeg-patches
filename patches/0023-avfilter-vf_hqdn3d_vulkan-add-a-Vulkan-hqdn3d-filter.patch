diff --git a/libavfilter/vf_hqdn3d_vulkan.c b/libavfilter/vf_hqdn3d_vulkan.c
new file mode 100644
index 0000000000000000000000000000000000000000..c5ce889c93aad697025fa70ae97c75705b47723f
--- /dev/null
+++ b/libavfilter/vf_hqdn3d_vulkan.c
@@ -0,0 +1,759 @@
+/*
+ * Copyright (c) 2003 Daniel Moreno <comac AT comac DOT darktech DOT org>
+ * Copyright (c) 2010 Baptiste Coudurier
+ * Copyright (c) 2012 Loren Merritt
+ * Copyright (c) 2026 Lusoris
