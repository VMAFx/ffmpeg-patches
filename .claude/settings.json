{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "praetorctl hook claude pre-tool",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh \"$CLAUDE_PROJECT_DIR/.config/lefthook/python.sh\" -I \"$CLAUDE_PROJECT_DIR/scripts/raw_configure_guard.py\" --client claude || exit 2",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
